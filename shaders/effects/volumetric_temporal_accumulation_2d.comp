#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, binding = 0) uniform image2D outAccumulated;

uniform sampler2D uDepthTexture;
uniform sampler2D uVelocityTexture;
uniform sampler2D uPrevAccumulated;
uniform sampler3D uVolumetric3D;

uniform float uTemporalAlpha;

#include "../types/temporal_data.glsl"

const int NUM_CASCADES = 4;
const float CASCADE_DISTANCES[4] = { 20.0, 60.0, 200.0, 1000.0 };

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAccumulated);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    // 1. Reconstruct view-space depth
    float depth = texture(uDepthTexture, uv).r;
    float z_ndc = depth * 2.0 - 1.0;
    vec4 clipPos = vec4(uv * 2.0 - 1.0, z_ndc, 1.0);
    vec4 viewPos = invProjection * clipPos;
    viewPos /= (abs(viewPos.w) > 0.0001) ? viewPos.w : 1.0;

    float linearZ = max(0.1, -viewPos.z);
    if (depth >= 1.0) linearZ = 1000.0;

    // Find cascade
    int cascade = -1;
    float z_near = 0.1;
    float z_far = 0.0;

    for (int i = 0; i < NUM_CASCADES; ++i) {
        if (linearZ <= CASCADE_DISTANCES[i]) {
            cascade = i;
            z_far = CASCADE_DISTANCES[i];
            if (i > 0) z_near = CASCADE_DISTANCES[i-1];
            break;
        }
    }

    vec4 current_vol = vec4(0.0, 0.0, 0.0, 1.0);
    float w = 1.0;
    if (cascade != -1) {
        float slice = clamp(log(linearZ / z_near) / log(z_far / z_near), 0.0, 1.0);
        w = (float(cascade) + slice) / float(NUM_CASCADES);
        current_vol = texture(uVolumetric3D, vec3(uv, w));
    } else {
        current_vol = texture(uVolumetric3D, vec3(uv, 1.0));
    }

    if (any(isnan(current_vol))) current_vol = vec4(0.0, 0.0, 0.0, 1.0);

    // If temporal accumulation is disabled or alpha is 0, just write current
    if (uTemporalAlpha <= 0.0) {
        imageStore(outAccumulated, pixel, current_vol);
        return;
    }

    // 2. Reprojection using motion vectors + prevViewProjection fallback
    vec2 velocity = texture(uVelocityTexture, uv).rg;
    vec2 prevUV = uv - velocity;

    // Fallback reprojection using viewProjection matrices if motion vector is negligible or uninitialized
    if (length(velocity) < 0.00001) {
        vec4 prevClipPosFallback = prevViewProjection * (invView * viewPos);
        if (abs(prevClipPosFallback.w) > 0.0001) {
            vec3 prevNDCFallback = prevClipPosFallback.xyz / prevClipPosFallback.w;
            prevUV = prevNDCFallback.xy * 0.5 + 0.5;
        }
    }

    // Screen edge validity / smooth border attenuation
    // Screen margin of 0.02 (2%) ensures seamless transition near viewport edges
    vec2 edgeDist = min(prevUV, 1.0 - prevUV);
    float edgeFactor = smoothstep(0.0, 0.02, edgeDist.x) * smoothstep(0.0, 0.02, edgeDist.y);

    if (edgeFactor <= 0.0) {
        imageStore(outAccumulated, pixel, current_vol);
        return;
    }

    vec4 history_vol = texture(uPrevAccumulated, prevUV);
    if (any(isnan(history_vol))) history_vol = current_vol;

    // 3. Physical relative depth validation to reduce ghosting across depth edges
    float prevDepth = texture(uDepthTexture, prevUV).r;
    float prev_z_ndc = prevDepth * 2.0 - 1.0;
    vec4 prevClipPos = vec4(prevUV * 2.0 - 1.0, prev_z_ndc, 1.0);
    vec4 prevViewPos = invProjection * prevClipPos;
    prevViewPos /= (abs(prevViewPos.w) > 0.0001) ? prevViewPos.w : 1.0;
    float prevLinearZ = max(0.1, -prevViewPos.z);
    if (prevDepth >= 1.0) prevLinearZ = 1000.0;

    // Relative depth check clamped to maximum range to prevent off-camera volumetric clipping
    float clampedZ = min(linearZ, 200.0);
    float clampedPrevZ = min(prevLinearZ, 200.0);
    float depthDiff = abs(clampedZ - clampedPrevZ);
    float maxAllowedDiff = 0.12 * clampedZ + 0.8; // Tightened depth tolerance for crisp foreground edges
    if (depthDiff > maxAllowedDiff) {
        imageStore(outAccumulated, pixel, current_vol);
        return;
    }

    // 4. Depth-Aware Neighborhood Clamping & Variance Bounding
    // Uses pixel-based screen UV offsets and depth-bilateral weighting
    vec4 m1 = vec4(0.0);
    vec4 m2 = vec4(0.0);
    float totalWeight = 0.0;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 sampleUV = uv + vec2(x, y) / vec2(size);
            float sampleDepth = texture(uDepthTexture, sampleUV).r;
            float sample_z_ndc = sampleDepth * 2.0 - 1.0;
            vec4 sampleClipPos = vec4(sampleUV * 2.0 - 1.0, sample_z_ndc, 1.0);
            vec4 sampleViewPos = invProjection * sampleClipPos;
            sampleViewPos /= (abs(sampleViewPos.w) > 0.0001) ? sampleViewPos.w : 1.0;
            float sampleLinearZ = max(0.1, -sampleViewPos.z);
            if (sampleDepth >= 1.0) sampleLinearZ = 1000.0;

            // Bilateral weight based on depth similarity to central pixel
            float depthWeight = exp(-abs(linearZ - sampleLinearZ) / (0.1 * linearZ + 0.5));
            vec4 val = texture(uVolumetric3D, vec3(sampleUV, w));

            m1 += val * depthWeight;
            m2 += val * val * depthWeight;
            totalWeight += depthWeight;
        }
    }

    totalWeight = max(0.0001, totalWeight);
    vec4 mean = m1 / totalWeight;
    vec4 stddev = sqrt(max(vec4(0.0), (m2 / totalWeight) - (mean * mean)));

    float spatialLum = dot(mean.rgb, vec3(0.2126, 0.7152, 0.0722));
    float spatialStd = dot(stddev.rgb, vec3(0.2126, 0.7152, 0.0722));
    float stability = 1.0 - clamp(spatialStd / (spatialLum + 0.001), 0.0, 1.0);

    float gamma = mix(1.2, 2.5, stability);
    vec4 minColor = mean - gamma * stddev;
    vec4 maxColor = mean + gamma * stddev;
    history_vol = clamp(history_vol, minColor, maxColor);

    // 5. Adaptive Accumulation with Edge & Depth Factor
    float activeAlpha = uTemporalAlpha * edgeFactor;
    float currentLum = dot(current_vol.rgb, vec3(0.2126, 0.7152, 0.0722));
    float historyLum = dot(history_vol.rgb, vec3(0.2126, 0.7152, 0.0722));
    if (stability > 0.8 && abs(currentLum - historyLum) > 0.1) {
        activeAlpha *= 0.5; // Adapt faster to stable lighting changes
    }

    vec4 result = mix(current_vol, history_vol, activeAlpha);
    result.rgb = clamp(result.rgb, vec3(0.0), vec3(1000.0));
    result.a = clamp(result.a, 0.0, 1.0); // Transmittance must always be in [0, 1] range

    imageStore(outAccumulated, pixel, result);
}
