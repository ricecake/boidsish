#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform image2D uErrorMap;
uniform sampler2D uBoundingMap;

uniform int uPass; // 0 = Spatial Pass, 1 = Priority Pass
uniform float uPriorityErrorWeight;
uniform float uPriorityGradWeight;
uniform float uPriorityAgeWeight;
uniform float uPriorityNeighborErrorWeight;
uniform float uPriorityNeighborGradWeight;
uniform float uPriorityThreshold;

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(std430, binding = 59) buffer TileQueueSSBO {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(std430, binding = 60) buffer IndirectDispatchSSBO {
	uint uDispatchCountX;
	uint uDispatchCountY;
	uint uDispatchCountZ;
};

#include "helpers/math.glsl"

const int bayer8x8[64] = int[64](
	 0, 32,  8, 40,  2, 34, 10, 42,
	48, 16, 56, 24, 50, 18, 58, 26,
	12, 44,  4, 36, 14, 46,  6, 38,
	60, 28, 52, 20, 62, 30, 54, 22,
	 3, 35, 11, 43,  1, 33,  9, 41,
	51, 19, 59, 27, 49, 17, 57, 25,
	15, 47,  7, 39, 13, 45,  5, 37,
	63, 31, 55, 23, 61, 29, 53, 21
);


void main() {
	uint totalTiles = uHeader.totalTiles;
// /*
	// Flatten the 2D workgroup ID into a linear index
	uint totalWorkgroups = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
	uint linearGroupIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;

	// Shuffle the linear index using a coprime to guarantee a 1:1 mapping without holes
	const uint prime[] = uint[](2713u, 2719u, 2729u, 2731u, 2741u, 2749u, 2753u, 7919u); // Large prime
