	if (tileCoord.x >= uHeader.tileCols || tileCoord.y >= uHeader.tileRows || uHeader.totalTiles == 0u) {
		return;
	}
// */
/*
	// 1. Calculate full dispatch dimensions
	uint dispatchCols = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
	uint dispatchRows = gl_NumWorkGroups.y * gl_WorkGroupSize.y;
	uint totalDispatchThreads = dispatchCols * dispatchRows;

	// 2. Flatten the current thread into a linear index
	uint linearThreadIndex = gl_GlobalInvocationID.y * dispatchCols + gl_GlobalInvocationID.x;

	// 3. Shuffle using a small prime to prevent 32-bit overflow
	// (109 safely handles up to ~39 million threads without truncating)
	// uint prime = 109u;
		const uint prime[] = uint[](2713u, 2719u, 2729u, 2731u, 2741u, 2749u, 2753u, 7919u); // Large prime

	uint scrambledLinearThread = (linearThreadIndex * prime[uHeader.frameIndex % prime.length()]) % totalDispatchThreads;

	// 4. Map the scrambled 1D index back to 2D
