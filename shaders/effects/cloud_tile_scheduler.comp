#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform image2D uErrorMap;
uniform sampler2D uBoundingMap;

uniform int uPass; // 0 = Spatial Pass, 1 = Priority Pass
uniform float uPriorityErrorWeight;
uniform float uPriorityGradWeight;
uniform float uPriorityAgeWeight;
uniform float uPriorityNeighborErrorWeight;
uniform float uPriorityNeighborGradWeight;
uniform float uPriorityThreshold;

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint spatialUpdateFrames;
	uint frameIndex;
	float minRefreshRate;
	float maxRefreshRate;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
	uint padding;
};

layout(std430, binding = 59) buffer TileQueueSSBO {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

layout(std430, binding = 60) buffer IndirectDispatchSSBO {
	uint uDispatchCountX;
	uint uDispatchCountY;
	uint uDispatchCountZ;
};

#include "helpers/math.glsl"

void main() {
	uint totalTiles = uHeader.totalTiles;

	// Flatten the 2D workgroup ID into a linear index
	uint totalWorkgroups = gl_NumWorkGroups.x * gl_NumWorkGroups.y;
	uint linearGroupIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;

	// Shuffle the linear index using a coprime to guarantee a 1:1 mapping without holes
	const uint prime[] = uint[](2713u, 2719u, 2729u, 2731u, 2741u, 2749u, 2753u, 7919u); // Large prime
	uint scrambledLinearGroup = (linearGroupIndex * prime[uHeader.frameIndex % prime.length()]) % totalWorkgroups;

	// Map the scrambled 1D index back to a 2D group coordinate
	uvec2 tileGroupCoords = uvec2(
		scrambledLinearGroup % gl_NumWorkGroups.x,
		scrambledLinearGroup / gl_NumWorkGroups.x
	);

	// Calculate final tile coordinate and apply the bounds check AFTER the shuffle
	ivec2 tileCoord = ivec2(tileGroupCoords) * ivec2(gl_WorkGroupSize.xy) + ivec2(gl_LocalInvocationID.xy);

	if (tileCoord.x >= uHeader.tileCols || tileCoord.y >= uHeader.tileRows || uHeader.totalTiles == 0u) {
		return;
	}

	int tileCols = int(uHeader.tileCols);
	int tileRows = int(uHeader.tileRows);

	bool tileHasCloudDensity = true;
	// // 0. Bounding map density check: exclude tiles without cloud density
	// ivec2 basePixel = tileCoord * 8;
	// bool tileHasCloudDensity = false;
	// const ivec2 offsets[4] = ivec2[4](ivec2(2, 2), ivec2(6, 2), ivec2(2, 6), ivec2(6, 6));
	// for (int k = 0; k < 4; ++k) {
	// 	vec4 bData = texelFetch(uBoundingMap, basePixel + offsets[k], 0);
	// 	if (bData.r >= 0.0 && bData.b > 0.001) {
	// 		tileHasCloudDensity = true;
	// 		break;
	// 	}
	// }

	// 1. Evaluate spatial distribution using Owen scramble Morton code
	uint spatialFrames = max(1u, uHeader.spatialUpdateFrames);
	uint scrambled = mortonOwenScramble(uvec2(tileCoord), 0u);
	bool scheduledBySpatial = tileHasCloudDensity && ((scrambled % spatialFrames) == (uHeader.frameIndex % spatialFrames));

	if (uPass == 0) {
		// Stage 1: Spatial Pass
		if (scheduledBySpatial) {
			uint slot = atomicAdd(uHeader.count, 1u);
			if (slot < uHeader.maxTiles) {
				uTileQueue[slot] = uvec2(tileCoord);
				atomicAdd(uDispatchCountX, 1u);
			}
		}
	} else {
		// Stage 2: Priority Pass
		vec4 errorData = imageLoad(uErrorMap, tileCoord);
		float errorVal = errorData.r;
		float densityGrad = errorData.g;
		float currentStepMult = (errorData.b > 0.01) ? errorData.b : 1.0;
		uint lastUpdatedFrame = uint(round(errorData.a));

		uint age = (uHeader.frameIndex > lastUpdatedFrame) ? (uHeader.frameIndex - lastUpdatedFrame) : 0u;

		// Quick check of 4 orthogonal neighboring tiles for priority scoring
		float maxNeighborError = 0.0;
		float maxNeighborGrad = 0.0;
		const ivec2 neighbors[4] = ivec2[4](
			ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1)
		);
		for (int i = 0; i < 4; ++i) {
			ivec2 nCoord = clamp(tileCoord + neighbors[i], ivec2(0), ivec2(tileCols - 1, tileRows - 1));
			vec4 nData = imageLoad(uErrorMap, nCoord);
			maxNeighborError = max(maxNeighborError, nData.r);
			maxNeighborGrad = max(maxNeighborGrad, nData.g);
		}

		float selfScore = errorVal * uPriorityErrorWeight + densityGrad * uPriorityGradWeight + float(age) * uPriorityAgeWeight;
		float neighborScore = maxNeighborError * uPriorityNeighborErrorWeight + maxNeighborGrad * uPriorityNeighborGradWeight;
		float priorityScore = selfScore + neighborScore;

		bool needsPriorityUpdate = !scheduledBySpatial && tileHasCloudDensity && ((priorityScore > uPriorityThreshold) || (lastUpdatedFrame == 0u));

		if (needsPriorityUpdate) {
			uint slot = atomicAdd(uHeader.count, 1u);
			if (slot < uHeader.maxTiles) {
				uTileQueue[slot] = uvec2(tileCoord);
				atomicAdd(uDispatchCountX, 1u);
			}
		}

		bool scheduled = scheduledBySpatial || needsPriorityUpdate;

		// Adaptive step size adjustment and error map decay
		float targetStepMult = 1.0;
		if (priorityScore > 0.35) {
			targetStepMult = 0.6;
		} else if (priorityScore < 0.08) {
			targetStepMult = 1.5;
		}
		float updatedStepMult = clamp(mix(currentStepMult, targetStepMult, 0.25), 0.5, 2.0);
		errorData.b = updatedStepMult;

		if (!scheduled) {
			// Decay error for unrendered tiles
			errorData.r *= 0.99;
			errorData.g *= 0.99;
		}

		imageStore(uErrorMap, tileCoord, errorData);
	}
}
