#version 460 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(binding = 0, rgba16f) uniform image3D outVolume;

#define CLOUD_BAKE_SHADER
#include "../helpers/clouds.glsl"
#include "lygia/generative/psrdnoise.glsl"

float remap_bake(float value, float low1, float high1, float low2, float high2) {
	return low2 + (value - low1) * (high2 - low2) / max(0.0001, (high1 - low1));
}


float localFbm(vec3 p, float period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < 3; i++) {
		WorleyData3D worleyDetails = worley3d_tiling_id(p * freq, period * freq);
		val += amp * worleyDetails.f1_dist;
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}


float computeSimplexWorley(vec3 p) {
	// Base Simplex noise (normalized to [0, 1])
	float simplex = psrdnoise(p * 4, vec3(10.0, 1.0, 10.0));
	simplex = clamp(simplex * 0.5 + 0.5, 0.0, 1.0);

	float worleyFbm = localFbm(p, 10);

	// Simplex noise carved/remapped by Worley FBM
	float simplexWorley = remap_bake(simplex, worleyFbm, 1.0, 0.0, 1.0);
	return clamp(simplexWorley, 0.0, 1.0);
}

void main() {
	ivec3 voxel = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 size = imageSize(outVolume); // 128, 128, 128
	if (voxel.x >= size.x || voxel.y >= size.y || voxel.z >= size.z) return;

	vec3 p = vec3(voxel);// / vec3(size); // [0, 1]

	// 1. R Channel: Tiling 3D noise (Simplex noise carved by Worley FBM in HZD fashion)
	float noiseVal = computeSimplexWorley(p);

	// Calculate targetRadius and worldPos:
	float ws = worldScale;
	vec3 uvw = vec3(voxel) / vec3(size);

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = ws;

	// Establish horizontal coordinate mapped to [0, 150000 * worldScale]
	vec3 horizPos = vec3(uvw.x * 150000.0 * ws, 0.0, uvw.z * 150000.0 * ws);

	CloudWeather weather = computeCloudWeather(horizPos, props);
	CloudLayer layer = computeCloudLayer(weather, props);

	float localFloor, actualThickness;
	float h = getCloudRelativeHeight(horizPos, weather, layer, localFloor, actualThickness);

	float R_earth = 6360.0 * 1000.0 * ws;
	vec3 earthCenter = vec3(viewPos.x, -R_earth, viewPos.z);
	float targetRadius = R_earth + localFloor + uvw.y * actualThickness;

	vec3 centerToPlane = vec3(horizPos.x - viewPos.x, 0.0, horizPos.z - viewPos.z);
	vec3 rayDirUp = normalize(vec3(centerToPlane.x, R_earth, centerToPlane.z));
	vec3 worldPos = earthCenter + rayDirUp * targetRadius;

	// Evaluate final evaluated density using calculateCloudDensityExpV10 at worldPos
	CloudSpotDetails res = calculateCloudDensityExpV10(worldPos, weather, layer, props, time, 1000.0, noiseVal);
	float finalDensity = res.density;
	if (finalDensity > 0.0) {
		finalDensity *= mix(0.4, 1.6, noiseVal);
	}
	finalDensity = clamp(finalDensity, 0.0, 1.0);

	// Initialize AO (G) and Shadow (B) channels to 1.0 (unoccluded/transparent)
	// They will be computed dynamically in the shadow bake shader.
	imageStore(outVolume, voxel, vec4(noiseVal, 1.0, 1.0, finalDensity));
}
