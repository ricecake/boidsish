#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outFilteredColor;

uniform sampler2D uCloudColor;   // Accumulated RGBA
uniform sampler2D uCloudDepth;   // Accumulated Depth Props
uniform sampler2D uCloudMoments; // Accumulated Moments (Luma, Luma2, historyLength)

#include "lygia/color/luma.glsl"

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outFilteredColor);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 texelSize = 1.0 / vec2(size);

	vec4 centerColor = texture(uCloudColor, uv);
	vec4 centerProps = texture(uCloudDepth, uv);
	vec4 centerMoments = texture(uCloudMoments, uv);

	float centerDepth = centerProps.r;
	bool centerIsSky = centerDepth > 40000.0;
	float centerHistory = centerMoments.z;

	// Calculate temporal variance
	float variance = max(0.0, centerMoments.y - centerMoments.x * centerMoments.x);

	// SVGF-style: Use temporal variance to drive luma-based edge stopping
	// We also use history length to increase the filter radius/strength for new pixels
	float stdDev = sqrt(variance);
	float phiLuma = 10.0 * stdDev + 0.01; // Scale phi based on noise levels

	// Adjust phiLuma based on history: fewer samples means we trust the variance less, so blur more.
	phiLuma *= mix(2.0, 1.0, smoothstep(1.0, 10.0, centerHistory));

	vec3 totalScattering = vec3(0.0);
	float totalTransmittance = 0.0;
	float totalWeight = 0.0;

	// Adaptive filter radius based on history
	int radius = (centerHistory < 4.0) ? 3 : 2;

	for (int y = -radius; y <= radius; y++) {
		for (int x = -radius; x <= radius; x++) {
			vec2 offset = vec2(x, y) * texelSize;
			vec4 sampleColor = texture(uCloudColor, uv + offset);
			vec4 sampleProps = texture(uCloudDepth, uv + offset);

			float sampleDepth = sampleProps.r;
			bool sampleIsSky = sampleDepth > 40000.0;

			// 1. Spatial Weight
			float spatialWeight = exp(-float(x*x + y*y) / (radius * radius * 0.5));

			// 2. Luma/Variance Weighting
			float sampleLuma = luma(sampleColor.rgb);
			float centerLuma = luma(centerColor.rgb);
			float lumaWeight = exp(-abs(centerLuma - sampleLuma) / phiLuma);

			// 3. Depth Weighting
			float depthWeight = 1.0;
			if (centerIsSky != sampleIsSky) {
				depthWeight = 0.0;
			} else if (!centerIsSky) {
				float depthDiff = abs(centerDepth - sampleDepth);
				float phiDepth = 1000.0; // Fixed depth tolerance
				depthWeight = exp(-depthDiff / phiDepth);
			}

			float weight = spatialWeight * lumaWeight * depthWeight;

			totalScattering += sampleColor.rgb * weight;
			totalTransmittance += sampleColor.a * weight;
			totalWeight += weight;
		}
	}

	vec4 finalColor;
	float invTotalWeight = 1.0 / max(totalWeight, 0.0001);
	finalColor.rgb = totalScattering * invTotalWeight;
	finalColor.a   = totalTransmittance * invTotalWeight;

	imageStore(outFilteredColor, pixel, finalColor);
}