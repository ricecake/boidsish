#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform image2D outFilteredColor;

uniform sampler2D uCloudColor;   // Accumulated RGBA or previous pass result
uniform sampler2D uCloudDepth;   // Accumulated Depth Props
uniform sampler2D uCloudMoments; // Accumulated Moments (Luma, Luma2, historyLength)
uniform int       uStepSize;     // 1, 2, 4, 8, 16...

#include "lygia/color/luma.glsl"

// À-Trous B3-Spline Kernel (5x5)
const float kernel[5] = float[](1.0/16.0, 1.0/4.0, 3.0/8.0, 1.0/4.0, 1.0/16.0);

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outFilteredColor);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 texelSize = 1.0 / vec2(size);

	vec4 centerColor = texture(uCloudColor, uv);
	vec4 centerProps = texture(uCloudDepth, uv);
	vec4 centerMoments = texture(uCloudMoments, uv);

	float centerDepth = centerProps.r;
	bool  centerIsSky = centerDepth > 40000.0;
	float centerHistory = centerMoments.z;

	// Calculate temporal variance (only used to guide the first pass or if we're filtering variance)
	// For subsequent À-Trous passes, we typically filter the color and use the variance to guide.
	// In some implementations, variance is also filtered.
	float variance = max(0.0, centerMoments.y - centerMoments.x * centerMoments.x);

	// If this isn't the first pass, we might have stored variance in the alpha or another channel.
	// But let's stick to the core SVGF guide:
	float stdDev = sqrt(variance);
	float phiLuma = 10.0 * stdDev + 0.01;
	phiLuma *= mix(2.0, 1.0, smoothstep(1.0, 10.0, centerHistory));

	vec4  sumColor = vec4(0.0);
	float sumWeight = 0.0;

	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			vec2 offset = vec2(x, y) * float(uStepSize) * texelSize;
			vec4 sampleColor = texture(uCloudColor, uv + offset);
			vec4 sampleProps = texture(uCloudDepth, uv + offset);

			float sampleDepth = sampleProps.r;
			bool  sampleIsSky = sampleDepth > 40000.0;

			// Edge stopping functions
			// 1. Luma
			float lumaWeight = exp(-abs(luma(centerColor.rgb) - luma(sampleColor.rgb)) / phiLuma);

			// 2. Depth
			float depthWeight = 1.0;
			if (centerIsSky != sampleIsSky) {
				depthWeight = 0.0;
			} else if (!centerIsSky) {
				// Philips SVGF uses a more sophisticated depth weight:
				// exp(-abs(centerDepth - sampleDepth) / (phiDepth * abs(gradient_dot_offset) + epsilon))
				// For now, a simpler version:
				depthWeight = exp(-abs(centerDepth - sampleDepth) / 1000.0);
			}

			float weight = kernel[x + 2] * kernel[y + 2] * lumaWeight * depthWeight;

			sumColor += sampleColor * weight;
			sumWeight += weight;
		}
	}

	vec4 filteredResult = sumColor / max(sumWeight, 0.0001);
	imageStore(outFilteredColor, pixel, filteredResult);
}
