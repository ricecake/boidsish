#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outFilteredColor;

uniform sampler2D uCloudColor;  // low_res_texture_
uniform sampler2D uCloudDepth;  // low_res_depth_texture_

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outFilteredColor);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 texelSize = 1.0 / vec2(size);

    vec4 centerColor = texture(uCloudColor, uv);
    float centerDepth = texture(uCloudDepth, uv).r;

    vec3 totalScattering = vec3(0.0);
    float totalTransmittance = 0.0;
    float totalOpacityWeight = 0.0;
    float totalWeight = 0.0;

    // Determine if center pixel is at a cloud boundary (low opacity or near sky)
    float centerOpacity = clamp(1.0 - centerColor.a, 0.0, 1.0);

    // 3x3 Depth-aware bilateral filter with relaxed edge handling
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 offset = vec2(x, y) * texelSize;
            vec4 sampleColor = texture(uCloudColor, uv + offset);
            float sampleDepth = texture(uCloudDepth, uv + offset).r;

            // Spatial weight (Gaussian-ish)
            float spatialWeight = exp(-(float(x*x + y*y)) / 1.0);

            // Depth weight: penalize large depth differences to avoid bleeding
            // But relax for sky-distance samples (they're just "no hit" not a different surface)
            float depthDiff = abs(centerDepth - sampleDepth);
            bool bothNearby = centerDepth < 40000.0 && sampleDepth < 40000.0;
            float depthSigma = bothNearby ? 500.0 : 50000.0;
            float depthWeight = exp(-depthDiff / depthSigma);

            // Transmittance similarity: relax at low-opacity boundaries to allow
            // averaging across the cloud edge, which smooths the binary step noise
            float transDiff = abs(centerColor.a - sampleColor.a);
            float transSigma = mix(0.3, 0.1, centerOpacity);
            float transWeight = exp(-transDiff / transSigma);

            float weight = spatialWeight * depthWeight * transWeight;

            totalScattering += sampleColor.rgb * weight;

            float sampleOpacity = clamp(1.0 - sampleColor.a, 0.0, 1.0);
            totalOpacityWeight += weight * sampleOpacity;

            totalTransmittance += sampleColor.a * weight;
            totalWeight += weight;
        }
    }

    vec4 finalColor;
    float avgTransmittance = totalTransmittance / max(totalWeight, 0.0001);
    float avgOpacity = 1.0 - avgTransmittance;

    // Recover average radiance: sum(scattering) / sum(opacity)
    // Then multiply by average opacity to get final filtered scattering
    vec3 avgRadiance = totalScattering / max(totalOpacityWeight, 0.0001);
    finalColor.rgb = avgRadiance * avgOpacity;
    finalColor.a   = avgTransmittance;

    imageStore(outFilteredColor, pixel, finalColor);
}
