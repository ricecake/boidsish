#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outFilteredColor;

uniform sampler2D uCloudColor;  // low_res_texture_
uniform sampler2D uCloudDepth;  // low_res_depth_texture_

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outFilteredColor);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 texelSize = 1.0 / vec2(size);

	vec4 centerColor = texture(uCloudColor, uv);
	vec4 centerProps = texture(uCloudDepth, uv);

	float centerDepth = centerProps.r;
	float centerMaxDensity = centerProps.a;
	bool centerIsSky = centerDepth > 40000.0;

	// 0.0 = Formless haze/fringe, 1.0 = Solid cloud core
	float psdRigidity = smoothstep(0.0, 0.4, centerMaxDensity);

	// Dynamic Depth Tolerance
	// Haze needs massive depth forgiveness. Cores need moderate edge preservation.
	float depthSigma = mix(15000.0, 1000.0, psdRigidity);

	// Center Opacity for Bilateral Weighting
	float centerOpacity = clamp(1.0 - centerColor.a, 0.0, 1.0);

	vec3 totalScattering = vec3(0.0);
	float totalTransmittance = 0.0;
	float totalWeight = 0.0;

	// 5x5 Opacity-Guided Bilateral Filter
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			vec2 offset = vec2(x, y) * texelSize;
			vec4 sampleColor = texture(uCloudColor, uv + offset);
			vec4 sampleProps = texture(uCloudDepth, uv + offset);

			float sampleDepth = sampleProps.r;
			bool sampleIsSky = sampleDepth > 40000.0;

			// Spatial Gaussian
			float spatialWeight = exp(-float(x*x + y*y) / 8.0);

			// 1. Transmittance/Opacity Weighting (With Isolation Floor)
			float sampleOpacity = clamp(1.0 - sampleColor.a, 0.0, 1.0);
			float opacityDiff = abs(centerOpacity - sampleOpacity);

			// Haze/Fringe: opacitySigma -> 0.0 (opacityWeight becomes 1.0, forcing pure blur)
			// Solid Core: opacitySigma -> 5.0 (Strictly preserves physical cloud edges)
			float opacitySigma = mix(0.0, 5.0, psdRigidity);
			// Force a 5% minimum blend to prevent noise from mathematically isolating itself
			float opacityWeight = max(0.05, exp(-opacityDiff * opacitySigma));

			// 2. Firefly Suppression (Karis Average)
			float luma = dot(sampleColor.rgb, vec3(0.2126, 0.7152, 0.0722));
			float fireflyWeight = 1.0 / (1.0 + luma);

			// 3. Depth / Boundary Weighting
			float depthWeight = 1.0;

			if (centerIsSky != sampleIsSky) {
				depthWeight = 1.0 - psdRigidity;
			} else if (!centerIsSky) {
				float depthDiff = abs(centerDepth - sampleDepth);
				depthWeight = exp(-depthDiff * depthDiff / (depthSigma * depthSigma));
			}

			// Multiply the firefly weight into the final factor
			float weight = spatialWeight * opacityWeight * depthWeight * fireflyWeight;

			totalScattering += sampleColor.rgb * weight;
			totalTransmittance += sampleColor.a * weight;
			totalWeight += weight;
		}
	}

	vec4 finalColor;
	float invTotalWeight = 1.0 / max(totalWeight, 0.0001);
	finalColor.rgb = totalScattering * invTotalWeight;
	finalColor.a   = totalTransmittance * invTotalWeight;

	imageStore(outFilteredColor, pixel, finalColor);
}