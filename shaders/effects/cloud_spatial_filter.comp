#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outFilteredColor;

uniform sampler2D uCloudColor;  // low_res_texture_
uniform sampler2D uCloudDepth;  // low_res_depth_texture_

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outFilteredColor);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 texelSize = 1.0 / vec2(size);

    float centerDepth = texture(uCloudDepth, uv).r;
    float centerOpacity = clamp(1.0 - texture(uCloudColor, uv).a, 0.0, 1.0);
    float depthSigma = mix(5000.0, 1000.0, smoothstep(0.0, 0.25, centerOpacity));

    vec3 totalScattering = vec3(0.0);
    float totalTransmittance = 0.0;
    float totalWeight = 0.0;

    // 3x3 Cross-Bilateral filter driven ONLY by depth
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 offset = vec2(x, y) * texelSize;
            vec4 sampleColor = texture(uCloudColor, uv + offset);
            float sampleDepth = texture(uCloudDepth, uv + offset).r;

            // Spatial Gaussian weight (Sigma ~ 1.0)
            float spatialWeight = exp(-(float(x*x + y*y)) / 2.0);

            // Depth Weighting
            float depthWeight = 1.0;
            bool centerIsSky = centerDepth > 40000.0;
            bool sampleIsSky = sampleDepth > 40000.0;

            // In cloud_spatial_filter.comp

            if (centerIsSky != sampleIsSky) {
                // Soft Edge Bridging: If one sample hit the cloud and one hit the sky,
                // we WANT them to blur together to smooth the noisy silhouette.
                depthWeight = 0.8;
            } else if (!centerIsSky) {
                // Internal Structure: Stop blurring if we cross massive depth discontinuities
                // (e.g. a foreground cloud overlapping a background cloud).
                float depthDiff = abs(centerDepth - sampleDepth);
                depthWeight = exp(-depthDiff / depthSigma);
            }

            float weight = spatialWeight * depthWeight;

            totalScattering += sampleColor.rgb * weight;
            totalTransmittance += sampleColor.a * weight;
            totalWeight += weight;
        }
    }

    vec4 finalColor;
    // Safely average the pre-multiplied energy and transmittance directly
    float invTotalWeight = 1.0 / max(totalWeight, 0.0001);
    finalColor.rgb = totalScattering * invTotalWeight;
    finalColor.a   = totalTransmittance * invTotalWeight;

    imageStore(outFilteredColor, pixel, finalColor);
}