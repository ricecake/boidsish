#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outFilteredColor;

uniform sampler2D uCloudColor;  // low_res_texture_
uniform sampler2D uCloudDepth;  // low_res_depth_texture_

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outFilteredColor);
    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec2 texelSize = 1.0 / vec2(size);

    vec4 centerProps = texture(uCloudDepth, uv);
    float centerDepth = centerProps.r;
    bool centerIsSky = centerDepth > 40000.0;

	float currentCloudDist = centerProps.r;
	float currentCloudLastHit = centerProps.g;
	float currentCloudStep = centerProps.b;
	float currentCloudMaxDensity = centerProps.a;

	float currentThickness = max(currentCloudLastHit - currentCloudDist, 1.0);
	float currentMissProbability = smoothstep(0.1, 1.0, currentCloudStep / currentThickness);
	float structuralRigidity = smoothstep(0.0, 0.4, currentCloudMaxDensity);
	float antiNyquist = (1.0 - currentMissProbability);
	bool currentIsSky = currentCloudDist > 40000.0;

    float centerMaxDensity = centerProps.a; // Read the PSD

    // 0.0 = Pure formless haze (needs massive blur)
    // 1.0 = Solid cloud core (needs strict edge preservation)
    // float structuralRigidity = smoothstep(0.01, 0.5, centerMaxDensity);

    // Dynamic Depth Tolerance:
    // Haze ignores depth boundaries (10000m tolerance). Solid clouds enforce them (500m tolerance).
    float depthSigma = mix(10000.0, 500.0, structuralRigidity);

    vec3 totalScattering = vec3(0.0);
    float totalTransmittance = 0.0;
    float totalWeight = 0.0;

    // 5x5 depth-guided filter — wide spatial sigma to utilize the full kernel
    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            vec2 offset = vec2(x, y) * texelSize;
            vec4 sampleColor = texture(uCloudColor, uv + offset);
            vec4 sampleProps = texture(uCloudDepth, uv + offset);
            float sampleDepth = sampleProps.r;

            float sampleCloudDist = sampleProps.r;
            float sampleCloudLastHit = sampleProps.g;
            float sampleCloudStep = sampleProps.b;
            float sampleCloudMaxDensity = sampleProps.a;

            float sampleThickness = max(sampleCloudLastHit - sampleCloudDist, 1.0);
            float sampleMissProbability = smoothstep(0.1, 1.0, sampleCloudStep / sampleThickness);
            float sampStructuralRigidity = smoothstep(0.0, 0.4, sampleCloudMaxDensity);
            float sampAntiNyquist = (1.0 - sampleMissProbability);
            bool sampleIsSky = sampleCloudDist > 40000.0;


            // Spatial Gaussian with sigma=2.0 so the 5x5 kernel is actually utilized
            float spatialWeight = exp(-float(x*x + y*y) / 16.0);

            // Depth weighting: preserve structure across depth discontinuities
            // float depthDiff = abs(centerDepth - sampleDepth);
            // float depthWeight = exp(-depthDiff * depthDiff / (depthSigma * depthSigma)) * sampStructuralRigidity;

            float depthWeight = 1.0;
            // bool sampleIsSky = sampleDepth > 40000.0;
            // if (centerIsSky) {
            //     if (sampleIsSky) {
            //         depthWeight = 0.0;
            //     }
            //     else {
            //         depthWeight = 2.0;
            //     }
            // } else {
            //     if (sampleIsSky) {
            //         depthWeight = 0.0;
            //     }
            //     else {
            //         float depthDiff = abs(centerDepth - sampleDepth);
            //         depthWeight = exp(-depthDiff * depthDiff / (depthSigma * depthSigma));
            //     }
            // }

            if (centerIsSky != sampleIsSky) {
                // Hard Structure Boundary: Prevent the black sky from mathematically diluting
                // the cloud fringe energy, which causes darkening and erosion.
                depthWeight = 0.0;
            } else if (!centerIsSky) {
                // Internal Cloud Softness: depthSigma expands to 10000m in haze,
                // forcing depthWeight -> 1.0 and fully blurring the noise.
                float depthDiff = abs(centerDepth - sampleDepth);
                depthWeight = exp(-depthDiff * depthDiff / (depthSigma * depthSigma));
            }


            // depthWeight = mix(1.0, depthWeight, currentMissProbability);

            float weight = spatialWeight * depthWeight * antiNyquist;

            totalScattering += sampleColor.rgb * weight;
            totalTransmittance += sampleColor.a * weight;
            totalWeight += weight;
        }
    }

    vec4 finalColor;
    // Safely average the pre-multiplied energy and transmittance directly
    float invTotalWeight = 1.0 / max(totalWeight, 0.0001);
    finalColor.rgb = totalScattering * invTotalWeight;
    finalColor.a   = totalTransmittance * invTotalWeight;

    imageStore(outFilteredColor, pixel, finalColor);
}