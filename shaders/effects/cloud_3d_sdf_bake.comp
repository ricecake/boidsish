#version 460 core

layout(local_size_x = 8, local_size_y = 4, local_size_z = 8) in;

layout(binding = 0, rgba16f) uniform image3D outSdfTexture;

#include "../helpers/clouds.glsl"

void main() {
	ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 size = imageSize(outSdfTexture); // 128x32x128
	if (pixel.x >= size.x || pixel.y >= size.y || pixel.z >= size.z) return;

	vec3 texCoords = (vec3(pixel) + 0.5) / vec3(size);

	// Setup cloud properties from the global Lighting block
	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	// X and Z coordinates represent 1 full period of uv space: p_advected / (1000.0 * props.worldScale)
	float mapRange = 6000.0 * props.worldScale;
	float worldX = texCoords.x * mapRange;
	float worldZ = texCoords.z * mapRange;

	// Y coordinate represents the altitude range of the cloud layer
	float y_min = props.altitude * props.worldScale;
	float y_max = (props.altitude + props.thickness * 12.0) * props.worldScale;
	float worldY = y_min + texCoords.y * (y_max - y_min);

	vec3 p = vec3(worldX, worldY, worldZ);
	vec3 voxelSize = vec3(
		mapRange / float(size.x),
		(y_max - y_min) / float(size.y),
		mapRange / float(size.z)
	);

	// The distance from the center of the voxel to its furthest corner
	float voxelCircumradius = length(voxelSize) * 0.5;

	// Bake unadvected SDF at time = 0.0
	float d3d = evalSdf(p, 0.0, props);
	d3d -= voxelCircumradius;

	// 1. Prebake coarse density
	float h_norm = clamp((worldY - y_min) / max(y_max - y_min, 1.0), 0.0, 1.0);
	float heightGradient = getDensityHeightGradient(h_norm, 0.5);
	float density = clamp(-d3d * heightGradient, 0.0, 1.0) * props.densityBase;

	// 2. Prebake Ambient Occlusion (AO) by raymarching vertically upwards
	float ao = 0.0;
	float stepSizeAO = (y_max - worldY) / 8.0;
	if (stepSizeAO > 0.01) {
		for (int step = 1; step <= 8; step++) {
			vec3 sp = p + vec3(0.0, float(step) * stepSizeAO, 0.0);
			float sd = evalSdf(sp, 0.0, props);
			if (sd < 0.0) {
				float h_s = clamp((sp.y - y_min) / max(y_max - y_min, 1.0), 0.0, 1.0);
				float grad_s = getDensityHeightGradient(h_s, 0.5);
				float dens_s = clamp(-sd * grad_s, 0.0, 1.0) * props.densityBase;
				ao += dens_s * stepSizeAO;
			}
		}
	}
	ao = exp(-ao * 0.05);

	// 3. Prebake Directional Shadow factor by raymarching towards the primary directional light source
	vec3 L = vec3(0.0, 1.0, 0.0);
	for (int j = 0; j < num_lights; j++) {
		if (lights[j].type == 1) { // DIRECTIONAL_LIGHT
			L = normalize(-lights[j].direction);
			break;
		}
	}

	float shadowOD = 0.0;
	float shadowStepSize = 150.0 * props.worldScale;
	int shadow_steps = 6;
	for (int step = 1; step <= shadow_steps; step++) {
		vec3 sp = p + L * float(step) * shadowStepSize;
		if (sp.y > y_max) break;
		float sd = evalSdf(sp, 0.0, props);
		if (sd < 0.0) {
			float h_s = clamp((sp.y - y_min) / max(y_max - y_min, 1.0), 0.0, 1.0);
			float grad_s = getDensityHeightGradient(h_s, 0.5);
			float dens_s = clamp(-sd * grad_s, 0.0, 1.0) * props.densityBase;
			shadowOD += dens_s * shadowStepSize;
		}
	}
	float shadowFactor = exp(-shadowOD * 0.08);

	imageStore(outSdfTexture, pixel, vec4(d3d, ao, shadowFactor, density));
}
