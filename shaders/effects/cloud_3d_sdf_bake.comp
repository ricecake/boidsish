#version 460 core

layout(local_size_x = 8, local_size_y = 4, local_size_z = 8) in;

layout(binding = 0, r32f) uniform image3D outSdfTexture;

#include "../helpers/clouds.glsl"

void main() {
	ivec3 pixel = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 size = imageSize(outSdfTexture); // 128x32x128
	if (pixel.x >= size.x || pixel.y >= size.y || pixel.z >= size.z) return;

	vec3 texCoords = (vec3(pixel) + 0.5) / vec3(size);

	// Setup cloud properties from the global Lighting block
	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	// X and Z coordinates represent 1 full period of uv space: p_advected / (5000.0 * props.worldScale)
	// So worldX and worldZ range from 0 to 5000.0 * props.worldScale
	float mapRange = 5000.0 * props.worldScale;
	float worldX = texCoords.x * mapRange;
	float worldZ = texCoords.z * mapRange;

	// Y coordinate represents the altitude range of the cloud layer
	// y_min = props.altitude * props.worldScale
	// y_max = (props.altitude + props.thickness * 12.0) * props.worldScale
	float y_min = props.altitude * props.worldScale;
	float y_max = (props.altitude + props.thickness * 12.0) * props.worldScale;
	float worldY = y_min + texCoords.y * (y_max - y_min);

	vec3 p = vec3(worldX, worldY, worldZ);

	// We bake the static SDF (time = 0.0) without advection
	vec3 p_static = p - getCloudWindOffset(time);
	CloudWeather weather = computeCloudWeather(p_static, props);
	CloudLayer layer = computeCloudLayer(weather, props);

	float d3d = calculateLoftedCloudSDF(p_static, weather, layer, props.worldScale);

	imageStore(outSdfTexture, pixel, vec4(d3d, 0.0, 0.0, 0.0));
}
