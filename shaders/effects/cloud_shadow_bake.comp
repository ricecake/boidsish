#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, r16f) uniform image2D outShadowMap;
layout(binding = 1, rgba16f) uniform image3D outVolume;

#define ATMOSPHERE_HEIGHT_DEFINED
uniform float u_atmosphereHeight;

uniform mat4 u_lightSpaceMatrix;
uniform mat4 u_invLightSpaceMatrix;
uniform vec3 u_primaryLightDir;
uniform int u_frameIndex;

#include "../atmosphere/common.glsl"
#include "../helpers/clouds.glsl"
#include "../helpers/fast_noise.glsl"
#include "../helpers/lighting.glsl"
#include "../types/temporal_data.glsl"
#include "helpers/math.glsl"

layout(binding = [[CLOUD_WEATHER_MIN_MAX_BINDING]]) uniform sampler2D u_cloudWeatherMinMaxTexture;

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outShadowMap);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	// Staggered quarter-resolution schedule (2x2 Bayer grid)
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 current_offset = bayer_offsets[u_frameIndex % 4];

	// Staggered 3D volume update
	if (pixel.x < 128 && pixel.y < 128) {
		if ((pixel.x % 2) == current_offset.x && (pixel.y % 2) == current_offset.y) {
			ivec3 size3d = imageSize(outVolume);
			for (int y = 0; y < 128; ++y) {
				ivec3 voxel = ivec3(pixel.x, y, pixel.y);

				// 1. Read existing voxel (noise in R, evaluated density in A)
				vec4 voxelData = imageLoad(outVolume, voxel);
				float noiseVal = voxelData.r;
				float finalDensity = voxelData.a;

				// 2. Compute Ambient Occlusion based on evaluated density in A channel
				float densitySum = 0.0;
				const int AO_SAMPLES = 8;
				vec3 ao_offsets[AO_SAMPLES] = vec3[](
					vec3(0.0, 0.02, 0.0),
					vec3(0.0, 0.05, 0.0),
					vec3(0.0, 0.10, 0.0),
					vec3(0.02, 0.04, 0.02),
					vec3(-0.02, 0.04, -0.02),
					vec3(0.03, 0.08, -0.03),
					vec3(-0.03, 0.08, 0.03),
					vec3(0.0, 0.15, 0.0)
				);

				vec3 uvw = vec3(voxel) / vec3(size3d);
				for (int i = 0; i < AO_SAMPLES; i++) {
					vec3 sample_uvw = fract(uvw + ao_offsets[i]);
					ivec3 sample_voxel = ivec3(sample_uvw * vec3(size3d));
					float sampleDensity = imageLoad(outVolume, sample_voxel).a;
					densitySum += sampleDensity;
				}
				float aoVal = clamp(1.0 - (densitySum / float(AO_SAMPLES)) * 1.5, 0.0, 1.0);

				// 3. March along current sun position to calculate optical depth
				CloudProperties props;
				props.altitude = cloudAltitude;
				props.thickness = cloudThickness;
				props.densityBase = cloudDensity;
				props.coverage = cloudCoverage;
				props.worldScale = worldScale;

				float R_earth = 6360.0 * 1000.0 * worldScale;
				vec3 earthCenter = vec3(viewPos.x, -R_earth, viewPos.z);

				vec3 horizPos = vec3(uvw.x * 150000.0 * worldScale, 0.0, uvw.z * 150000.0 * worldScale);
				CloudWeather weather = computeCloudWeather(horizPos, props);
				CloudLayer layer = computeCloudLayer(weather, props);

				float localFloor, actualThickness;
				float h = getCloudRelativeHeight(horizPos, weather, layer, localFloor, actualThickness);

				float targetRadius = R_earth + localFloor + uvw.y * actualThickness;
				vec3 centerToPlane = vec3(horizPos.x - viewPos.x, 0.0, horizPos.z - viewPos.z);
				vec3 rayDirUp = normalize(vec3(centerToPlane.x, R_earth, centerToPlane.z));
				vec3 worldPos = earthCenter + rayDirUp * targetRadius;

				// Ray direction is towards the sun
				vec3 L = normalize(u_primaryLightDir);

				// Find intersection with the cloud ceiling
				float R_ceiling = R_earth + (cloudAltitude + 2.0 * cloudThickness + 500.0) * worldScale;
				float t_start_ceil, t_end_ceil;
				intersectSphereLocal(worldPos - earthCenter, L, R_ceiling, t_start_ceil, t_end_ceil);

				// March from t = 0 to t_end_ceil
				float t_end = max(0.0, t_end_ceil);
				float stepSize = t_end / 16.0;
				float accumulatedOpticalDepth = 0.0;

				for (int j = 0; j < 16; ++j) {
					float sampleT = (float(j) + 0.5) * stepSize;
					vec3 samplePos = worldPos + L * sampleT;

					float sampleAlt = length(samplePos - earthCenter) - R_earth;
					CloudWeather sampleWeather = computeCloudWeather(samplePos, props);
					CloudLayer sampleLayer = computeCloudLayer(sampleWeather, props);

					float sFloor, sThickness;
					float sampleH = getCloudRelativeHeight(samplePos, sampleWeather, sampleLayer, sFloor, sThickness);

					if (sampleAlt >= sFloor && sampleAlt <= (sFloor + sThickness)) {
						ivec3 sampleVoxel = ivec3(
							floor(samplePos.x / (150000.0 * worldScale) * float(size3d.x)),
							floor(sampleH * float(size3d.y)),
							floor(samplePos.z / (150000.0 * worldScale) * float(size3d.z))
						);
						sampleVoxel.x = (sampleVoxel.x % size3d.x + size3d.x) % size3d.x;
						sampleVoxel.z = (sampleVoxel.z % size3d.z + size3d.z) % size3d.z;
						sampleVoxel.y = clamp(sampleVoxel.y, 0, size3d.y - 1);
						float d = imageLoad(outVolume, sampleVoxel).a;
						accumulatedOpticalDepth += d * stepSize;
					}
				}

				// Convert optical depth to transmittance
				float shadowTransmittance = exp(-accumulatedOpticalDepth * 2.0 * cloudShadowOpticalDepthMultiplier);

				// Write updated aoVal and shadowTransmittance back to G and B channels of outVolume
				imageStore(outVolume, voxel, vec4(noiseVal, aoVal, shadowTransmittance, finalDensity));
			}
		}
	}

	if ((pixel.x % 2) != current_offset.x || (pixel.y % 2) != current_offset.y) {
		return; // Keep existing pixel values from prior frames
	}

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	// In OpenGL clip space, near plane is at Z = -1.0
	vec4 clipSpace = vec4(uv * 2.0 - 1.0, -1.0, 1.0);
	vec4 worldPosNear = u_invLightSpaceMatrix * clipSpace;
	worldPosNear /= worldPosNear.w;

	vec3 rayStart = worldPosNear.xyz;
	// Ray direction is the light propagation direction (from light towards the ground)
	vec3 rayDir = -normalize(u_primaryLightDir);

	float t_start = 1e10;
	float t_end = -1e10;
	intersectCloudShell(rayStart, rayDir, worldScale, t_start, t_end);

	if (t_start >= t_end) {
		imageStore(outShadowMap, pixel, vec4(0.0));
		return;
	}

	float accumulatedDensity = 0.0;
	float t = t_start;
	int L = 3;
	float baseStepSize = 100.0 * worldScale;

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	// Perform hierarchical DDA raymarching accelerated by min-max weather texture
	for (int i = 0; i < 512; ++i) {
		if (t >= t_end) break;

		vec3 p = rayStart + rayDir * t;
		vec3 advect = getCloudWindOffset(time);
		vec3 p_advected = p + advect;
		vec2 weatherUV = p_advected.xz / (100000.0 * worldScale);

		// Wrap horizontally
		weatherUV = fract(weatherUV);

		vec2 minMax = textureLod(u_cloudWeatherMinMaxTexture, weatherUV, float(L)).rg;
		float maxDensity = clamp(minMax.y + (cloudCoverage * 2.0 - 1.0), 0.0, 1.0);

		if (maxDensity <= 0.001) {
			float mapRange = 100000.0 * worldScale;
			float texelSizeAtLevel0 = mapRange / 2048.0;
			float texelSize = float(1 << L) * texelSizeAtLevel0;

			vec2 dir2D = rayDir.xz;
			float len2D = max(length(dir2D), 1e-6);
			vec2 dir_norm = dir2D / len2D;

			vec2 p_xz = p_advected.xz;
			vec2 cell_idx = floor(p_xz / texelSize);

			vec2 next_bound;
			next_bound.x = (dir_norm.x > 0.0) ? (cell_idx.x + 1.0) * texelSize : cell_idx.x * texelSize;
			next_bound.y = (dir_norm.y > 0.0) ? (cell_idx.y + 1.0) * texelSize : cell_idx.y * texelSize;

			vec2 dist_to_bound;
			dist_to_bound.x = (abs(dir_norm.x) > 1e-6) ? (next_bound.x - p_xz.x) / dir_norm.x : 1e10;
			dist_to_bound.y = (abs(dir_norm.y) > 1e-6) ? (next_bound.y - p_xz.y) / dir_norm.y : 1e10;

			float dt_2D = min(dist_to_bound.x, dist_to_bound.y);
			float dt = (dt_2D / len2D) + 0.001; // pushes it safely over the boundary line

			dt = clamp(dt, baseStepSize, 2000.0 * worldScale);
			t += dt;
			L = clamp(L + 1, 0, 10);
		}
		else {
			if (L > 0) {
				L--;
			} else {
				// At level 0, sample the actual cloud density
				CloudWeather weather = computeCloudWeather(p, props);
				CloudLayer layer = computeCloudLayer(weather, props);

				CloudDensityResult densityRes = calculateCloudDensityMinimal(p, weather, layer, props);
				accumulatedDensity += max(0.0, densityRes.density.r) * baseStepSize;

				t += baseStepSize;
			}
		}
	}

	imageStore(outShadowMap, pixel, vec4(accumulatedDensity, 0.0, 0.0, 0.0));
}
