#version 460 core
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform image3D outVolume;

uniform vec3 u_primaryLightDir;
uniform int u_frameIndex;
uniform float u_worldScale;

#define CLOUD_BAKE_SHADER
#include "../helpers/clouds.glsl"

void main() {
	ivec3 size = imageSize(outVolume); // 128, 128, 128
	int x = int(gl_GlobalInvocationID.x);
	int z = int(gl_GlobalInvocationID.y);
	if (x >= size.x || z >= size.z)
		return;

	// Staggered quarter-resolution schedule (2x2 Bayer grid pattern based on u_frameIndex % 4)
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 current_offset = bayer_offsets[u_frameIndex % 4];
	if ((x % 2) != current_offset.x || (z % 2) != current_offset.y) {
		return; // Skip updating this column this frame
	}

	vec3 L = normalize(u_primaryLightDir);
	// If the sun/moon is below the horizon, we don't have direct sunlight, but let's keep a minimum L.y to prevent division/zero issues
	if (L.y < 0.001) {
		L = vec3(0.0, 1.0, 0.0);
	}

	// For each voxel y from 127 down to 0:
	// We trace a ray from this voxel along L to compute the accumulated density (optical depth)
	// and write the computed shadow term back into the B channel of the voxel.
	for (int y = 127; y >= 0; y--) {
		ivec3 voxel = ivec3(x, y, z);
		vec3 voxel_uvw = vec3(voxel) / vec3(size);

		// Raymarching to compute shadow factor from this voxel towards the sun
		float accumulatedDensity = 0.0;
		float t_step = 1.0 / 32.0; // standard step size for tracing through the volume

		// Trace up to 32 steps (since cloud layer has finite thickness and we trace upwards)
		for (int step = 1; step <= 32; step++) {
			float t = float(step) * t_step;
			vec3 sample_uvw = voxel_uvw + L * t;

			// If the ray escapes the top of the cloud layer (y > 1.0) or bounds, we stop
			if (sample_uvw.y > 1.0 || sample_uvw.x < 0.0 || sample_uvw.x > 1.0 || sample_uvw.z < 0.0 || sample_uvw.z > 1.0) {
				break;
			}

			// Sample density from the A (alpha) channel of our 3D image/texture
			float stepDensity = imageLoad(outVolume, ivec3(sample_uvw * vec3(size))).a;
			accumulatedDensity += stepDensity * t_step;
		}

		// Compute shadow term using Beer's law
		float shadowTerm = exp(-accumulatedDensity * 12.0 * cloudShadowOpticalDepthMultiplier);

		// Retrieve original voxel values (R = noise, G = AO, A = density)
		vec4 original = imageLoad(outVolume, voxel);

		// Overwrite only the B channel (shadowTerm)
		imageStore(outVolume, voxel, vec4(original.r, original.g, shadowTerm, original.a));
	}
}
