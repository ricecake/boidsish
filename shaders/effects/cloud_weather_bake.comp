float smaxCubic(float a, float b, float k) {
	k *= 1.4;
	float h = max(k - abs(a - b), 0.0);
	return max(a, b) + h * h * h / (6.0 * k * k);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outWeatherMap);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	float period00 = 64.0;
	float period0 = 32.0;
	float period1 = 16.0;
	float period2 = 8.0;
	float period3 = 4.0;
	float period4 = 2.0;

	vec2 p = uv;

	float macro = (regionalFbm(p, period2));

	HierarchicalWorleyData2D worleyDetails = hierarchicalWorleyTiled(p * period1, period1);
	float worley = pow(worleyDetails.f1_dist, 1.0);

	// float finalCoverage = macro;//remapClamp(macro, worley, 1.0, 0.0, 1.0);
	float finalCoverage = remapClamp(macro, worley, 1.0, 0.0, 1.0);
	finalCoverage = smaxCubic(finalCoverage, worley, 0.1);

	WorleyData2D density = worley2d_tiling_id(uv * period2, period2);
	WorleyData2D thickness = worley2d_tiling_id(uv * period3, period3);
	WorleyData2D type = worley2d_tiling_id((uv + 0.25*macro) * period4, period4);
	// HierarchicalWorleyData2D type = hierarchicalWorleyTiled((uv + 0.15*macro) * period4, period4);


	float typeTransition = abs(type.f2_dist - type.f1_dist);
	// float typeValue = mix(hash12Tile(type.f1, vec2(0.0)), hash12Tile(type.f2, vec2(0.0)), smoothstep(0, 0.85, typeTransition));
	float typeValue = hash12Tile(type.f1, vec2(0.0));

	finalCoverage = pow(finalCoverage, 1.0 + (1.0-smoothstep(0, 0.05, typeTransition)));

	// Worley 2D seed grid (10x10 Voronoi period for 100 seeds)
	float seedPeriod = 10.0;
	WorleyData2D seedWorley = worley2d_tiling_id(uv * seedPeriod, seedPeriod);

	// Evaluate multi-frequency ridge noise and weight by Worley F1 distance
	// F1 seed point evaluates to 0.0 and cell edges evaluate to 1.0
	float n1 = psrdnoise(uv * seedPeriod * 2.0, vec2(seedPeriod * 2.0));
	float n2 = psrdnoise(uv * seedPeriod * 4.0, vec2(seedPeriod * 4.0));
	float rawRidge = (1.0 - abs(n1)) * 0.7 + (1.0 - abs(n2)) * 0.3;
	float f1Weight = clamp(seedWorley.f1_dist / 0.7071, 0.0, 1.0);
	float ridgeChannel = clamp(rawRidge * f1Weight, 0.0, 1.0);

	imageStore(outWeatherMap, pixel, vec4(finalCoverage, typeValue, ridgeChannel, 1.0));
	imageStore(outMinMaxMap, pixel, vec4(finalCoverage, finalCoverage, 0.0, 0.0));

	// Populate cloud seed locations with Worley F1 seed points and baked coverage
	vec2 f1_uv = mod(seedWorley.f1 / seedPeriod, vec2(1.0));
	ivec2 f1Pixel = ivec2(floor(f1_uv * vec2(size)));

	if (pixel == f1Pixel) {
		int gx = int(floor(mod(seedWorley.f1.x, seedPeriod)));
		int gy = int(floor(mod(seedWorley.f1.y, seedPeriod)));
		int cellIdx = gy * 10 + gx;

		if (cellIdx >= 0 && cellIdx < 100) {
			float mapRange = 100000.0 * uWorldScale;
			float worldX = f1_uv.x * mapRange;
			float worldZ = f1_uv.y * mapRange;
			seeds[cellIdx] = vec4(worldX, worldZ, 0.0, finalCoverage);
		}
	}
}
