#include "../helpers/fast_noise.glsl"
#include "../helpers/cloud_weather_utils.glsl"
#include "lygia/space/uncenter.glsl"
#include "lygia/math/gain.glsl"

uniform float uWorldScale;
uniform float uCloudCoverage;
uniform float time;

float regionalFbm(vec2 p, vec2 period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < 3; i++) {
		val += amp * (0.5 + 0.5 * psrdnoise(p * freq, period * freq));
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}

float localFbm(vec2 p, float period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < 3; i++) {
		WorleyData2D worleyDetails = worley2d_tiling_id(p * freq, period * freq);
		val += amp * worleyDetails.f1_dist;
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}


float posNoise(vec2 p, float scale, float period) {
	return uncenter(psrdnoise(p * period / scale, vec2(period)));
}

float schlickGain(float x, float g) {
	g = clamp(g, 0.001, 0.999);
	float absDiff = abs(2.0 * x - 1.0);
	float denominator = g + absDiff * (1.0 - 2.0 * g);
	return 0.5 + ((x - 0.5) * (1.0 - g)) / denominator;
}

float schlickBias(float x, float g) {
	// Guard inputs to safe analytical ranges
	float xx = clamp(x, 0.0, 1.0);
	float gg = clamp(g, 1e-4, 1.0 - 1e-4);

	// Convert bias parameter to Schlick formulation factor
	// Schlick's fast alternative: f(x) = x / ((1/a - 2) * (1.0 - x) + 1.0)
	float k = (1.0 / gg) - 2.0;
	return xx / (k * (1.0 - xx) + 1.0);
}


void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outWeatherMap);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	float mapRange = 100000.0 * uWorldScale;
	float cellRange = 10000.0 * uWorldScale;

	vec2 p = uv * mapRange;

	float macro = regionalFbm((p *10 / mapRange), vec2(10.0));
	float worley = localFbm(p / cellRange, 5.0);

	float micro = clamp(1.0 - (worley), 0.0, 1.0);

	float coverage = max(macro * micro, 0);
	float finalCoverage = clamp(coverage, 0.0, 1.0);
	finalCoverage = smoothstep(0.05, 1.0, finalCoverage);

	float height = pow(clamp(posNoise(p, mapRange, 10), 0.0, 1.0), 2);
	float thickness = clamp(posNoise(p, mapRange, 5), 0.0, 1.0);
	float density = clamp(posNoise(p, mapRange, 5), 0.0, 1.0);
	// float density = localFbm(p / mapRange, 5.0);

	imageStore(outWeatherMap, pixel, vec4(finalCoverage, height, thickness, density));
	imageStore(outMinMaxMap, pixel, vec4(finalCoverage, finalCoverage, 0.0, 0.0));

