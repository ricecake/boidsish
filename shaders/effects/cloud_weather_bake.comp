#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) uniform image2D outWeatherMap;
layout(binding = 1, rg16f) uniform image2D outMinMaxMap;

layout(std430, binding = [[CLOUD_SEEDS_BINDING]] ) buffer CloudSeeds {
	vec4 seeds[]; // x: worldX, y: worldZ, z: SDF, w: isCloudy
};

#include "../helpers/fast_noise.glsl"
#include "../helpers/cloud_weather_utils.glsl"
#include "lygia/space/uncenter.glsl"
#include "lygia/math/gain.glsl"

uniform float uWorldScale;
uniform float uCloudCoverage;
uniform float uCloudThickness;
uniform float time;

float regionalFbm(vec2 p, vec2 period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < 3; i++) {
		val += amp * (0.5 + 0.5 * psrdnoise(p * freq, period * freq));
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}

float localFbm(vec2 p, float period, out WorleyData2D data) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < 3; i++) {
		WorleyData2D worleyDetails = worley2d_tiling_id(p * freq, period * freq);
		if (i == 0) {
			data = worleyDetails;
		}
		val += amp * (worleyDetails.f1_dist);
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}

float posNoise(vec2 p, float scale, float period) {
	return uncenter(psrdnoise(p * period / scale, vec2(period)));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outWeatherMap);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	float mapRange = 100000.0 * uWorldScale;
	float cellRange = 10000.0 * uWorldScale;

	vec2 p = uv * mapRange;

	vec2 warp = vec2(posNoise(p, mapRange, 5), posNoise(p+vec2(123.45,67.89), mapRange, 5)) * 0.25;

	WorleyData2D cellData;
	// Calculate base Worley cell details using the wind/warp coordinates
	localFbm((p+warp) / cellRange, 2.0, cellData);

	// 1. Hierarchical Worley sizing:
	// Use the cell's center cellData.f1 with period 2.0 to get a stable, tiling size factor.
	// We evaluate a lower-frequency tiling Worley lookup at the cell center.
	vec2 sizeWorley = worley2d_tiling(cellData.f1, 2.0);
	float sizeFactor = sizeWorley.y; // Ranges from 0.0 to 1.0
	float cellSize = mix(0.4, 2.0, sizeFactor);

	// 2. Scale footprint size: larger cells have smaller scaledDist, expanding their coverage
	float scaledDist = cellData.f1_dist / cellSize;

	float coverage = 1.0 - scaledDist;
	float finalCoverage = clamp(coverage, 0.0, 1.0);
	finalCoverage = smoothstep(0.05, 1.0, finalCoverage);

	// Cell-space height/type variation using noise
	float height = pow(clamp(posNoise((cellData.f1 + warp), mapRange, 10), 0.0, 1.0), 2);
	float density = clamp(posNoise(cellData.f1, mapRange, 5), 0.0, finalCoverage);

	// Save to weather map:
	// R: scaledDist, G: cellSize, B: height, A: density
	imageStore(outWeatherMap, pixel, vec4(scaledDist, cellSize, height, density));
	imageStore(outMinMaxMap, pixel, vec4(finalCoverage, finalCoverage, 0.0, 0.0));
}
