#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) uniform image2D outWeatherMap;
layout(binding = 1, rg16f) uniform image2D outMinMaxMap;

layout(std430, binding = [[CLOUD_SEEDS_BINDING]] ) buffer CloudSeeds {
	vec4 seeds[]; // x: worldX, y: worldZ, z: SDF, w: isCloudy
};

#include "../helpers/fast_noise.glsl"
#include "../helpers/cloud_weather_utils.glsl"

uniform float uWorldScale;
uniform float uCloudCoverage;
uniform float time;

float regionalFbm(vec2 p, vec2 period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	vec2 g;
	for (int i = 0; i < 3; i++) {
		val += amp * (0.5 + 0.5 * psrdnoise(p * freq, period * freq, 0.0, g));
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outWeatherMap);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	float mapRange = 100000.0 * uWorldScale;
	float cellRange = 10000.0 * uWorldScale;

	vec3 p = vec3(uv.x * mapRange, 0.0, uv.y * mapRange);

	vec4 worleyDetails = worley3d_tiling_id(p / (cellRange * 0.25), 10.0);

	float macro = regionalFbm(p.xz / cellRange, vec2(10.0));
	float micro = 1.0 - worleyDetails.x;
	float coverage = clamp(micro - (1.0 - macro), 0.0, 1.0);
	float finalCoverage = clamp(coverage + (uCloudCoverage * 2.0 - 1.0), 0.0, 1.0);

	vec2 cellId = worleyDetails.yw;
	float cellID = simplex3d_tiling(worleyDetails.yzw, 10.0) * 0.5 + 0.5;
	float density = clamp(2.0 * cellID * macro, 0, 1);

	float distInMeters = micro * cellRange;
	float distF1InMeters = worleyDetails.x * cellRange;

	imageStore(outWeatherMap, pixel, vec4(finalCoverage, distF1InMeters, cellID, density));
	imageStore(outMinMaxMap, pixel, vec4(density, density, 0.0, 0.0));

	// Record seed info if this is the pixel closest to the cell center (f1)
	vec2 f1Pixel = (cellId * cellRange) / mapRange * vec2(size);
	if (distance(vec2(pixel), f1Pixel) < 1.0) {
		int cellIdx = int(mod(floor(cellId.y), 10.0) * 10.0 + mod(floor(cellId.x), 10.0));
		seeds[cellIdx] = vec4(cellId.x * cellRange, cellId.y * cellRange, distInMeters, (finalCoverage > 0.0 ? 1.0 : 0.0));
	}
}
