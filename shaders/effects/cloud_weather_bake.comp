#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba16f) uniform image2D outWeatherMap;
layout(binding = 1, rg16f) uniform image2D outMinMaxMap;

layout(std430, binding = [[CLOUD_SEEDS_BINDING]] ) buffer CloudSeeds {
	vec4 seeds[]; // x: worldX, y: worldZ, z: SDF, w: isCloudy
};

#include "../helpers/fast_noise.glsl"
#include "lygia/space/uncenter.glsl"
#include "lygia/math/gain.glsl"

uniform float uWorldScale;
uniform float uCloudCoverage;
uniform float uCloudThickness;
uniform float time;

float remap(float value, float valueMin, float valueMax) {
	return (value - valueMin) / (valueMax - valueMin);
}

float remapClamp(float value, float inMin, float inMax, float outMin, float outMax) {
    float t = clamp((value - inMin) / (inMax - inMin), 0.0, 1.0);
    return mix(outMin, outMax, t);
}

float adjust(float value, float scaly) {
	float f = 1.0 - value;
	float h = 0.4; // adjustable filter

	float a = scaly * (1.0-h) + h;
	return clamp((remap(a, f, f + h)), 0.0, 1.0);
}

float posNoise(vec2 p, float period) {
	return uncenter(psrdnoise(p * period, vec2(period)));
}

float localFbm(vec2 p, float period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < 5; i++) {
		WorleyData2D worleyDetails = worley2d_tiling_id(p * freq * period, period * freq);
		val += amp * (1.0 - worleyDetails.f1_dist);
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}

float regionalFbm(vec2 p, float period) {
	float val = 0.0;
	float amp = 0.5;
	float freq = 1.0;

	WorleyData2D worleyDetails = worley2d_tiling_id(p * max(1.0, period * 0.25), max(1.0, period * 0.25));
	float warpMag = 0.5 * posNoise(p, period);
	vec2 warp = warpMag * normalize(p - worleyDetails.f1);
	vec2 rPeriod = vec2(period);
	for (int i = 0; i < 4; i++) {
		val += amp * (0.5 + 0.5 * psrdnoise(mod(p+warp, rPeriod) * freq * rPeriod, rPeriod * freq));
		amp *= 0.5;
		freq *= 2.0;
	}
	return val;
}

float schlickGain(float x, float g) {
	g = clamp(g, 0.001, 0.999);
	float absDiff = abs(2.0 * x - 1.0);
	float denominator = g + absDiff * (1.0 - 2.0 * g);
	return 0.5 + ((x - 0.5) * (1.0 - g)) / denominator;
}

float schlickBias(float x, float g) {
	// Guard inputs to safe analytical ranges
	float xx = clamp(x, 0.0, 1.0);
	float gg = clamp(g, 1e-4, 1.0 - 1e-4);

	// Convert bias parameter to Schlick formulation factor
	// Schlick's fast alternative: f(x) = x / ((1/a - 2) * (1.0 - x) + 1.0)
	float k = (1.0 / gg) - 2.0;
	return xx / (k * (1.0 - xx) + 1.0);
}

float smaxCubic(float a, float b, float k) {
	k *= 1.4;
	float h = max(k - abs(a - b), 0.0);
	return max(a, b) + h * h * h / (6.0 * k * k);
}

// Distance from point p to line segment ab in 2D (in UV space, handling periodic wrapping for torus distance)
float distToSegmentWrapped(vec2 p, vec2 a, vec2 b, out float progressOnSegment) {
	// Calculate shortest displacement vector considering tiling [0,1]^2
	vec2 ab = b - a;
	ab -= floor(ab + 0.5); // shortest wrapped vector from a to b

	vec2 ap = p - a;
	ap -= floor(ap + 0.5); // shortest wrapped vector from a to p

	float ab2 = dot(ab, ab);
	if (ab2 < 1e-7) {
		progressOnSegment = 0.0;
		return length(ap);
	}

	float t = clamp(dot(ap, ab) / ab2, 0.0, 1.0);
	progressOnSegment = t;
	vec2 closest = t * ab; // relative to a
	return length(ap - closest);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outWeatherMap);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	float period00 = 64.0;
	float period0 = 32.0;
	float period1 = 16.0;
	float period2 = 8.0;
	float period3 = 4.0;
	float period4 = 2.0;

	vec2 p = uv;

	float macro = (regionalFbm(p, period2));

	HierarchicalWorleyData2D worleyDetails = hierarchicalWorleyTiled(p * period1, period1);
	float worley = pow(worleyDetails.f1_dist, 1.0);

	float finalCoverage = remapClamp(macro, worley, 1.0, 0.0, 1.0);
	finalCoverage = smaxCubic(finalCoverage, worley, 0.1);

	WorleyData2D density = worley2d_tiling_id(uv * period2, period2);
	WorleyData2D thickness = worley2d_tiling_id(uv * period3, period3);
	WorleyData2D type = worley2d_tiling_id((uv + 0.25*macro) * period4, period4);

	float typeTransition = abs(type.f2_dist - type.f1_dist);
	float typeValue = hash12Tile(type.f1, vec2(0.0));

	finalCoverage = pow(finalCoverage, 1.0 + (1.0-smoothstep(0, 0.05, typeTransition)));

	// --- Worley Tree Vector Field Computation ---
	// Evaluate 4 octaves of tiling Worley feature points (f1)
	const int NUM_OCTAVES = 4;
	float octavePeriods[NUM_OCTAVES] = float[NUM_OCTAVES](4.0, 8.0, 16.0, 32.0);

	vec2 f1_points[NUM_OCTAVES];
	for (int i = 0; i < NUM_OCTAVES; i++) {
		float per = octavePeriods[i];
		WorleyData2D wData = worley2d_tiling_id(uv * per, per);
		// Convert f1 cell ID + point to normalized UV space [0, 1]
		f1_points[i] = fract(wData.f1 / per);
	}

	// Connect consecutive octaves f1_points[0] -> f1_points[1] -> f1_points[2] -> f1_points[3]
	float minTreeDist = 1e6;
	float bestTreeProgress = 0.0;
	float segmentProgressStep = 1.0 / float(NUM_OCTAVES - 1);

	for (int i = 0; i < NUM_OCTAVES - 1; i++) {
		float segProg = 0.0;
		float distToSeg = distToSegmentWrapped(uv, f1_points[i], f1_points[i+1], segProg);

		if (distToSeg < minTreeDist) {
			minTreeDist = distToSeg;
			bestTreeProgress = (float(i) + segProg) * segmentProgressStep;
		}
	}

	// Distance from pixel to the 0th octave f1 point (root)
	vec2 rootDelta = uv - f1_points[0];
	rootDelta -= floor(rootDelta + 0.5);
	float distToRoot = length(rootDelta);

	// Weight distance to tree by distance to root $f_{1,0}$
	float weightedDist = minTreeDist * (1.0 + distToRoot * 4.0);

	// Shortest path distance to $f_{1,0}$ combining tree progress outwards from middle point + lateral distance
	float shortestPathDist = bestTreeProgress + weightedDist;

	imageStore(outWeatherMap, pixel, vec4(finalCoverage, typeValue, shortestPathDist, 1.0));
	imageStore(outMinMaxMap, pixel, vec4(finalCoverage, finalCoverage, 0.0, 0.0));
}
