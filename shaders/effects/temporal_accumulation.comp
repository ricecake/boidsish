#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outResult;

uniform sampler2D uCurrentFrame;
uniform sampler2D uHistoryFrame;
uniform sampler2D uVelocity;
uniform sampler2D uDepth;

#include "temporal_data.glsl"

uniform float uAlpha = 0.9; // Accumulation factor
uniform int uResolutionScale = 1;

// 2x2 Bayer pattern for interleaving
const ivec2 bayer_offsets_2x2[4] = ivec2[](
	ivec2(0, 0),
	ivec2(1, 1),
	ivec2(1, 0),
	ivec2(0, 1)
);

// 4x4 Bayer pattern for interleaving
const ivec2 bayer_offsets_4x4[16] = ivec2[](
	ivec2(0, 0), ivec2(2, 2), ivec2(0, 2), ivec2(2, 0),
	ivec2(1, 1), ivec2(3, 3), ivec2(1, 3), ivec2(3, 1),
	ivec2(0, 1), ivec2(2, 3), ivec2(0, 3), ivec2(2, 1),
	ivec2(1, 0), ivec2(3, 2), ivec2(1, 2), ivec2(3, 0)
);

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outResult);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

	// Determine if this pixel is newly calculated this frame
	bool is_new_pixel = false;
	if (uResolutionScale <= 1) {
		is_new_pixel = true;
	} else if (uResolutionScale == 2) {
		ivec2 offset = bayer_offsets_2x2[frameIndex % 4];
		is_new_pixel = ((pixel.x % 2) == offset.x && (pixel.y % 2) == offset.y);
	} else if (uResolutionScale == 4) {
		ivec2 offset = bayer_offsets_4x4[frameIndex % 16];
		is_new_pixel = ((pixel.x % 4) == offset.x && (pixel.y % 4) == offset.y);
	}

	// 1. Reprojection
	vec2 velocity = texture(uVelocity, uv).rg;
	vec2 prevUV = uv - velocity;

	vec4 current = texture(uCurrentFrame, uv);

	bool validHistory = true;
	if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
		validHistory = false;
	} else {
		float prevDepth = texture(uDepth, prevUV).r;
		float currentDepth = texture(uDepth, uv).r;
		if (abs(currentDepth - prevDepth) > 0.01) {
			validHistory = false;
		}
	}

	if (!validHistory) {
		// Fallback when history is invalid
		// If is_new_pixel is false, current is not updated, but texture(uCurrentFrame, uv) is a bilinear lookup which blends nearby valid pixels
		imageStore(outResult, pixel, current);
		return;
	}

	vec4 history = texture(uHistoryFrame, prevUV);

	if (!is_new_pixel) {
		// If not a new pixel, just propagate reprojected history
		imageStore(outResult, pixel, history);
		return;
	}

	// 3. Neighborhood Clamping to reduce ghosting
	// Sample 3x3 neighborhood of current frame, using stride uResolutionScale to avoid unwritten pixels
	vec4 m1 = vec4(0.0);
	vec4 m2 = vec4(0.0);
	vec2 currentTexelSize = 1.0 / textureSize(uCurrentFrame, 0);
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 offsetUV = uv + vec2(x, y) * float(uResolutionScale) * currentTexelSize;
			vec4 val = texture(uCurrentFrame, offsetUV);
			m1 += val;
			m2 += val * val;
		}
	}
	vec4 mean = m1 / 9.0;
	vec4 stddev = sqrt(max(vec4(0.0), (m2 / 9.0) - (mean * mean)));

	// Spatial stability: how uniform is the local neighborhood?
	float spatialLum = dot(mean.rgb, vec3(0.2126, 0.7152, 0.0722));
	float spatialStd = dot(stddev.rgb, vec3(0.2126, 0.7152, 0.0722));
	float stability = 1.0 - clamp(spatialStd / (spatialLum + 0.001), 0.0, 1.0);

	// Clamp history to neighborhood of current
	float gamma = mix(1.2, 4.0, stability);
	vec4  minColor = mean - gamma * stddev;
	vec4  maxColor = mean + gamma * stddev;
	history = clamp(history, minColor, maxColor);

	// Additionally reject current outliers that are far from history
	vec4 m_diff = abs(current - history);
	if (any(greaterThan(m_diff, stddev * (4.0 + stability * 8.0) + 0.1))) {
		current = mix(current, history, 0.5);
	}

	// 4. Accumulate
	float activeAlpha = uAlpha;
	float currentLum = dot(current.rgb, vec3(0.2126, 0.7152, 0.0722));
	float historyLum = dot(history.rgb, vec3(0.2126, 0.7152, 0.0722));

	if (stability > 0.8 && abs(currentLum - historyLum) > 0.1) {
		activeAlpha *= 0.5; // Adapt faster to stable lighting changes
	}

	vec4 result = mix(current, history, activeAlpha);

	imageStore(outResult, pixel, result);
}
