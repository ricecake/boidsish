#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba32f) uniform image2D outBoundingMap;

uniform sampler2D depthTexture;

#define ATMOSPHERE_HEIGHT_DEFINED
uniform float u_atmosphereHeight;

uniform sampler2D u_skyViewLUT;

uniform float uCloudMaxRayDistance;
uniform float uRenderScale;
uniform int   uFrameIndex;

// Include standard uniforms and utilities
#include "../atmosphere/common.glsl"
#include "../helpers/clouds.glsl"
#include "../helpers/fast_noise.glsl"
#include "../helpers/lighting.glsl"
#include "../types/temporal_data.glsl"
#include "helpers/math.glsl"

layout(binding = [[CLOUD_WEATHER_MIN_MAX_BINDING]]) uniform sampler2D u_cloudWeatherMinMaxTexture;

void main() {
	ivec2 fullResSize = textureSize(depthTexture, 0);
	int scaleFactor = max(1, int(round(1.0 / max(0.001, uRenderScale))));

	ivec2 offset = ivec2(0);
	if (scaleFactor > 1) {
		int numCells = scaleFactor * scaleFactor;
		int step = uFrameIndex % numCells;
		int x = 0;
		int y = 0;
		int tempFactor = scaleFactor;
		int bits = 0;
		while (tempFactor > 1) {
			bits++;
			tempFactor >>= 1;
		}
		for (int i = 0; i < bits; i++) {
			int shift = bits - 1 - i;
			int bitPair = (step >> (2 * shift)) & 3;
			int bx = (bitPair == 1 || bitPair == 2) ? 1 : 0;
			int by = (bitPair == 1 || bitPair == 3) ? 1 : 0;
			x = (x << 1) | bx;
			y = (y << 1) | by;
		}
		offset = ivec2(x, y);
	}

	ivec2 fullResWorkGroupID = ivec2(gl_WorkGroupID.xy) * scaleFactor + offset;
	ivec2 pixel = fullResWorkGroupID * ivec2(gl_WorkGroupSize.xy) + ivec2(gl_LocalInvocationID.xy);

	if (pixel.x >= fullResSize.x || pixel.y >= fullResSize.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(fullResSize);

	float depth = texture(depthTexture, uv).r;
	float z = depth * 2.0 - 1.0;
	vec4 clipSpacePosition = vec4(uv * 2.0 - 1.0, z, 1.0);
	vec4 viewSpacePosition = invProjection * clipSpacePosition;
	viewSpacePosition /= viewSpacePosition.w;
	vec3 worldPos = (invView * viewSpacePosition).xyz;
	vec3 rayDir = normalize(worldPos - viewPos);
	float dist = length(worldPos - viewPos);

	if (depth == 1.0) {
		dist = uCloudMaxRayDistance * worldScale;
		worldPos = viewPos + rayDir * dist;
	}

	float t_start1, t_end1, t_start2, t_end2;
	bool hitShell = intersectCloudShell(viewPos, rayDir, worldScale, t_start1, t_end1, t_start2, t_end2);

	int numSegments = 0;
	float segStart[2];
	float segEnd[2];

	if (hitShell) {
		if (t_start1 < t_end1 && t_start1 < dist) {
			segStart[numSegments] = t_start1;
			segEnd[numSegments] = min(t_end1, dist);
			numSegments++;
		}
		if (t_start2 < t_end2 && t_start2 < dist) {
			segStart[numSegments] = t_start2;
			segEnd[numSegments] = min(t_end2, dist);
			numSegments++;
		}
	}

	if (numSegments == 0) {
		imageStore(outBoundingMap, pixel, vec4(-1.0, -1.0, 0.0, 0.0));
		return;
	}

	vec4 previousBounds = imageLoad(outBoundingMap, pixel);

	if (cloudCoverage >= 1.0) {
		float global_start = segStart[0];
		float global_end = segEnd[numSegments - 1];
		imageStore(outBoundingMap, pixel, vec4(global_start, global_end, 1.0, previousBounds.b));
		return;
	}

	float firstHit = -1.0;
	float lastHit = -1.0;
	float totalDensity = 0.0;

	for (int s = 0; s < numSegments; s++) {
		float t = segStart[s];
		float seg_end = segEnd[s];
		int L = 3;
		float baseStepSize = 25.0 * worldScale;

		for (int i = 0; i < 2048; ++i) {
			if (t >= seg_end) break;

			vec3 p = viewPos + rayDir * t;
			vec3 advect = getCloudWindOffset(time);
			vec3 p_advected = p - advect;
			vec2 weatherUV = p_advected.xz / (100000.0 * worldScale);

			// Wrap horizontally
			weatherUV = fract(weatherUV);

			vec2 minMax = textureLod(u_cloudWeatherMinMaxTexture, weatherUV, float(L)).rg;
			float maxDensity = applyDynamicCoverage(minMax.y, cloudCoverage);

			if (maxDensity <= 0.001) {
				float mapRange = 100000.0 * worldScale;
				float texelSizeAtLevel0 = mapRange / 2048.0;
				float texelSize = float(1 << L) * texelSizeAtLevel0;

				vec2 dir2D = rayDir.xz;
				float len2D = max(length(dir2D), 1e-6);
				vec2 dir_norm = dir2D / len2D;

				vec2 p_xz = p_advected.xz;
				vec2 cell_idx = floor(p_xz / texelSize);

				vec2 next_bound;
				next_bound.x = (dir_norm.x > 0.0) ? (cell_idx.x + 1.0) * texelSize : cell_idx.x * texelSize;
				next_bound.y = (dir_norm.y > 0.0) ? (cell_idx.y + 1.0) * texelSize : cell_idx.y * texelSize;

				vec2 dist_to_bound;
				dist_to_bound.x = (abs(dir_norm.x) > 1e-6) ? (next_bound.x - p_xz.x) / dir_norm.x : 1e10;
				dist_to_bound.y = (abs(dir_norm.y) > 1e-6) ? (next_bound.y - p_xz.y) / dir_norm.y : 1e10;

				float dt_2D = min(dist_to_bound.x, dist_to_bound.y);
				float dt = (dt_2D / len2D) + 0.001; // +0.001 pushes it safely over the boundary line

				dt = clamp(dt, baseStepSize, 2000.0 * worldScale);
				t += dt;
				L = clamp(L + 1, 0, 10);
			}
			else {
				if (L > 0) {
					L--;
				} else {
					if (maxDensity > 0.01) {
						if (firstHit < 0.0) {
							firstHit = t;
						}
						lastHit = t;
						totalDensity += maxDensity * (baseStepSize / (1000.0 * worldScale));
					}
					t += baseStepSize;
				}
			}
		}
	}

	imageStore(outBoundingMap, pixel, vec4(firstHit, lastHit, totalDensity, previousBounds.b));
}
