#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outColor;
layout(binding = 1, rgba32f)  uniform image2D outDepth;
layout(binding = 2, rgba32f)  uniform image2D outMoments;

uniform sampler2D uCurrentFrame;     // Current low-res cloud RGBA
uniform sampler2D uHistoryFrame;     // Previous accumulated cloud RGBA
uniform sampler2D uSceneDepth;       // Full-res scene depth
uniform sampler2D uCurrentCloudDepth;// Current low-res cloud distance
uniform sampler2D uHistoryCloudDepth;// Previous accumulated cloud distance
uniform sampler2D uVelocityTexture;  // Current low-res cloud velocity (XZ)
uniform sampler2D uHistoryMoments;    // Previous accumulated moments (Luma1, Luma2, Density2, historyLength)

uniform mat4  uInvView;
uniform mat4  uInvProjection;
uniform mat4  uPrevViewProjection;
uniform float uBlendAlpha; // How much history to keep (0.85-0.95)

#include "../atmosphere/common.glsl"
#include "lygia/color/luma.glsl"


uniform int   uFrameIndex;
uniform vec2  uJitter;
uniform float uCloudAltitude;

vec3 RGBToYCoCg(vec3 rgb) {
	float y  = dot(rgb, vec3(0.25, 0.5, 0.25));
	float co = dot(rgb, vec3(0.5, 0.0, -0.5));
	float cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
	return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
	float y  = ycocg.x;
	float co = ycocg.y;
	float cg = ycocg.z;
	float r = y + co - cg;
	float g = y + cg;
	float b = y - co - cg;
	return vec3(r, g, b);
}


vec4 SampleHistoryCatmullRom(sampler2D tex, vec2 uv, vec2 texSize) {
	vec2 samplePos = uv * texSize;
	vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
	vec2 f = samplePos - texPos1;

	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2 w3 = f * f * (-0.5 + 0.5 * f);

	vec2 w12 = w1 + w2;
	vec2 offset12 = w2 / (w1 + w2);

	vec2 texPos0 = texPos1 - 1.0;
	vec2 texPos3 = texPos1 + 2.0;
	vec2 texPos12 = texPos1 + offset12;

	texPos0 /= texSize;
	texPos3 /= texSize;
	texPos12 /= texSize;

	vec4 result = vec4(0.0);
	result += texture(tex, vec2(texPos0.x, texPos12.y)) * w0.x * w12.y;
	result += texture(tex, vec2(texPos12.x, texPos0.y)) * w12.x * w0.y;
	result += texture(tex, vec2(texPos12.x, texPos12.y)) * w12.x * w12.y;
	result += texture(tex, vec2(texPos3.x, texPos12.y)) * w3.x * w12.y;
	result += texture(tex, vec2(texPos12.x, texPos3.y)) * w12.x * w3.y;

	return result / (w12.x * w12.y + w0.x * w12.y + w12.x * w0.y + w3.x * w12.y + w12.x * w3.y);
}

// Mitchell-Netravali Weight Function
float mitchell(float x, float B, float C) {
	float ax = abs(x);
	if (ax < 1.0) {
		return ((12.0 - 9.0 * B - 6.0 * C) * ax * ax * ax +
				(-18.0 + 12.0 * B + 6.0 * C) * ax * ax +
				(6.0 - 2.0 * B)) / 6.0;
	} else if (ax < 2.0) {
		return ((-B - 6.0 * C) * ax * ax * ax +
				(5.0 * B + 30.0 * C) * ax * ax +
				(-8.0 * B - 48.0 * C) * ax +
				(4.0 * B + 24.0 * C)) / 6.0;
	}
	return 0.0;
}

// 2D Bicubic Texture Fetch
vec4 textureMitchell(sampler2D tex, vec2 uv, vec2 textureSize) {
	vec2 texelSize = 1.0 / textureSize;
	uv = uv * textureSize - 0.5;

	vec2 f = fract(uv);
	vec2 c = floor(uv);

	vec4 color = vec4(0.0);
	float weightsSum = 0.0;

	// 4x4 Neighborhood Sampling
	for (int j = -1; j <= 2; j++) {
		float wy = mitchell(float(j) - f.y, 1.0/3.0, 1.0/3.0);

		for (int i = -1; i <= 2; i++) {
			float wx = mitchell(float(i) - f.x, 1.0/3.0, 1.0/3.0);
			float weight = wx * wy;

			vec2 pos = (c + vec2(i, j) + 0.5) * texelSize;
			color += texture(tex, pos) * weight;
			weightsSum += weight;
		}
	}

	return color / weightsSum;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outColor);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 jitteredUV = uv + uJitter;

	// 1. Fetch Current Frame Data (Noisy)
	vec4  currentRGBA = textureMitchell(uCurrentFrame, uv, vec2(size));
	vec4  currDepthProps = texture(uCurrentCloudDepth, uv);
	float currentCloudDist = currDepthProps.r;
	float currentCloudLastHit = currDepthProps.g;
	float currentCloudStep = currDepthProps.b;
	float currentCloudMaxDensity = currDepthProps.a;

	float currentThickness = max(currentCloudLastHit - currentCloudDist, 1.0 * WORLD_SCALE_VALUE);
	float currentMissProbability = smoothstep(0.1, 1.0, currentCloudStep / currentThickness);
	bool currentIsSky = currentCloudDist > 40000.0 * WORLD_SCALE_VALUE;

	// 2. Reproject History
	vec2 texelSize = 1.0 / vec2(size);
	float closestDist = 50000.0 * WORLD_SCALE_VALUE;
	vec2 closestUV = uv;

	// Dilated velocity search for better edge reprojection
	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 sampleUV = uv + vec2(x, y) * texelSize;
			float d = texture(uCurrentCloudDepth, sampleUV).a;
			if (d > closestDist) {
				closestDist = d;
				closestUV = sampleUV;
			}
		}
	}

	vec2 velocity = texture(uVelocityTexture, closestUV).rg;
	vec2 prevUV = uv + velocity;

	bool validHistory = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

	// 3. Disocclusion Detection (Depth-based)
	ivec2 sceneTexSize = textureSize(uSceneDepth, 0);
	ivec2 depthPos = ivec2(jitteredUV * vec2(sceneTexSize));
	float rawSceneDepth = texelFetch(uSceneDepth, depthPos, 0).r;

	vec4 ndcDepth = vec4(jitteredUV * 2.0 - 1.0, rawSceneDepth * 2.0 - 1.0, 1.0);
	vec4 viewSpaceScene = uInvProjection * ndcDepth;
	float linearSceneDepth = -(viewSpaceScene.z / viewSpaceScene.w);

	if (rawSceneDepth >= 1.0) {
		linearSceneDepth = 50000.0 * WORLD_SCALE_VALUE;
	}

	float depthEpsilon = 20.0 * WORLD_SCALE_VALUE + (linearSceneDepth * 0.02);

	if (linearSceneDepth < currentCloudDist - depthEpsilon) {
		validHistory = false;
	}


	vec4  historyDepthProps = validHistory ? texture(uHistoryCloudDepth, prevUV) : currDepthProps;
	float historyCloudDist = historyDepthProps.r;
	float historyCloudLastHit = historyDepthProps.g;
	float historyCloudStep = historyDepthProps.b;
	float historyCloudMaxDensity = historyDepthProps.a;

	float historyThickness = max(historyCloudLastHit - historyCloudDist, 1.0 * WORLD_SCALE_VALUE);
	bool historyIsSky = historyCloudDist > 40000.0 * WORLD_SCALE_VALUE;
	float historyMissProbability = smoothstep(0.1, 1.0, historyCloudStep / historyThickness);

	float structuralRigidity = smoothstep(0.0, 0.4, currentCloudMaxDensity);
	float nyquist = (max(historyMissProbability, currentMissProbability));
	float antiNyquist = (1.0 - nyquist);
	float structuralLock = structuralRigidity * antiNyquist;

	bool isSilhouetteEdge = (currentIsSky != historyIsSky);

	float newStructureConfidence = smoothstep(0.0, 0.5, max(0.0, currentCloudMaxDensity - historyCloudMaxDensity) / max(historyCloudMaxDensity, 0.1));

	if (validHistory) {
		float distDiff = abs(currentCloudDist - historyCloudDist);
		if (distDiff > depthEpsilon * 2.0) {
			validHistory = false;
		}
	}

	// 4. Accumulation
	vec4  historyRGBA = vec4(0.0);
	vec4  historyMoments = vec4(0.0);
	float historyLength = 0.0;

	if (validHistory) {
		historyRGBA = textureMitchell(uHistoryFrame, prevUV, vec2(size));
		historyMoments = texture(uHistoryMoments, prevUV);
		historyLength = historyMoments.w;
	}

	historyLength = min(32.0, historyLength + 1.0);
	if (!validHistory) {
		historyLength = 1.0;
		historyRGBA = currentRGBA;
		historyMoments = vec4(0.0);
	}

	// 5. Variance Clipping
	vec3 m1 = vec3(0.0);
	vec3 m2 = vec3(0.0);
	float alphaM1 = 0.0;
	float alphaM2 = 0.0;

	float weightSumColor = 0.0;
	float weightSumAlpha = 0.0;
	float weightSumTrans = 0.0;

	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			vec4 smpC = texture(uCurrentFrame, uv + vec2(x, y) * texelSize);
			vec4 smp = smpC;

			float spatialW = exp(-float(x*x + y*y) / 16.0);
			float opacity = clamp(1.0 - smp.a, 0.0, 1.0);

			float colorW = spatialW * max(opacity, 0.001);

			vec3 ycocg = RGBToYCoCg(smp.rgb);

			m1 += ycocg * colorW;
			m2 += ycocg * ycocg * colorW;

			alphaM1 += opacity * spatialW;
			alphaM2 += opacity * opacity * spatialW;

			weightSumColor += colorW;
			weightSumAlpha += spatialW;
		}
	}

	vec3 spatialMean = m1 / weightSumColor;
	vec3 stddev = sqrt(max(vec3(0.0), (m2 / weightSumColor) - (spatialMean * spatialMean)));

	float alphaMean = alphaM1 / weightSumAlpha;
	float alphaStd = sqrt(max(0.0, (alphaM2 / weightSumAlpha) - (alphaMean * alphaMean)));

	float histLumaMean = historyMoments.x;
	float histLumaSqMean = historyMoments.y;
	float temporalVar = max(0.0, histLumaSqMean - (histLumaMean * histLumaMean));
	float temporalStdDev = sqrt(temporalVar);

	// Dynamic Gamma
	float gamma = mix(0.75, 2.5, structuralLock);
	float alphaGamma = mix(0.5, 1.5, structuralLock);

	// SILHOUETTE ANTI-CRUSH:
	// If the ray randomly jumped off or onto the cloud edge, the 3x3 neighborhood
	// is temporarily mismatched with the history. Expand the box massively to
	// let the historical data survive the clip.
	if (isSilhouetteEdge) {
		gamma *= 1.5;
		alphaGamma *= 1.1;
	}

	// Minimum variance floor
	float minStddev = max(0.02, spatialMean.x * 0.15);
	stddev = max(stddev, vec3(minStddev));
	alphaStd = max(alphaStd, 0.05);

	float minExtents = max(0.02, spatialMean.x * 0.15);
	vec3 clipExtents = max(vec3(temporalStdDev * gamma), vec3(minExtents));

	vec3 minColor = spatialMean - clipExtents;
	vec3 maxColor = spatialMean + clipExtents;

	float falseNegativeLikelihood = smoothstep(0.1, 1.0, currentMissProbability);
	maxColor += spatialMean * falseNegativeLikelihood; // Expand bounds upward

	vec3 historyYCoCg = RGBToYCoCg(historyRGBA.rgb);

	// Clip-toward-spatialMean YCoCg AABB intersection
	vec3 clipDir = spatialMean - historyYCoCg;
	vec3 clipFactors = vec3(1.0);

	for (int i = 0; i < 3; i++) {
		if (abs(clipDir[i]) > 0.0001) {
			if (historyYCoCg[i] < minColor[i])
				clipFactors[i] = (minColor[i] - historyYCoCg[i]) / clipDir[i];
			else if (historyYCoCg[i] > maxColor[i])
				clipFactors[i] = (maxColor[i] - historyYCoCg[i]) / clipDir[i];
			else
				clipFactors[i] = 0.0;
		}
	}
	float clipT = clamp(max(clipFactors.x, max(clipFactors.y, clipFactors.z)), 0.0, 1.0);
	historyYCoCg = mix(historyYCoCg, spatialMean, clipT);
	historyRGBA.rgb = YCoCgToRGB(historyYCoCg);

	// Keep alpha bounds physical to prevent transmittance inversion
	float historyOpacity = clamp(1.0 - historyRGBA.a, 0.0, 1.0);
	// 1. Establish the standard spatial bounds
	float minAlpha = alphaMean - alphaGamma * alphaStd;
	float maxAlpha = alphaMean + alphaGamma * alphaStd;

	// 2. Asymmetric Box Expansion (The "Trust History" Fix)
	// If the current frame has a high miss probability, it's highly likely the spatial
	// neighborhood is falsely reporting empty sky. We dynamically inflate the maximum
	// bound to prevent valid history from being clipped away by a noisy miss.
	// float falseNegativeLikelihood = smoothstep(0.1, 1.0, currentMissProbability);
	maxAlpha += (1.0 - alphaMean) * falseNegativeLikelihood; // Expand bounds upward

	// 3. 1D Clip-Toward-spatialMean Intersection
	float alphaClipDir = alphaMean - historyOpacity;
	float alphaClipFactor = 1.0;

	if (abs(alphaClipDir) > 0.0001) {
		if (historyOpacity < minAlpha) {
			alphaClipFactor = (minAlpha - historyOpacity) / alphaClipDir;
		} else if (historyOpacity > maxAlpha) {
			alphaClipFactor = (maxAlpha - historyOpacity) / alphaClipDir;
		} else {
			alphaClipFactor = 0.0; // History is safely inside the bounds
		}
	}

	// 4. Apply the clip
	float finalAlphaClipT = clamp(alphaClipFactor, 0.0, 1.0);
	float clippedAlpha = mix(historyOpacity, alphaMean, finalAlphaClipT);
	historyRGBA.a = 1.0 - clamp(clippedAlpha, 0.0, 1.0);

	float alpha = 1.0 / historyLength;
	alpha = max(alpha, 0.05);

	// Force the alpha to 1.0 (trust current frame entirely) if we hit a new dense core
	alpha = mix(alpha, 1.0, newStructureConfidence);

	currentRGBA = vec4(YCoCgToRGB(spatialMean), 1-alphaMean);
	vec4 accumulatedRGBA = mix(historyRGBA, currentRGBA, alpha);

	float currentLuma = luma(currentRGBA.rgb);
	vec3  currentM = vec3(currentLuma, currentLuma * currentLuma, currentCloudMaxDensity * currentCloudMaxDensity);
	vec3  accumulatedM = mix(historyMoments.xyz, currentM, alpha);


	// 6. Output
	imageStore(outColor, pixel, accumulatedRGBA);

	// Accumulate density metadata for the spatial filter
	vec4 accumulatedDepthProps = mix(historyDepthProps, currDepthProps, alpha);
	// Distance and step size should stay closer to current to prevent depth blurring artifacts
	accumulatedDepthProps.rb = currDepthProps.rb;

	imageStore(outDepth, pixel, accumulatedDepthProps);
	imageStore(outMoments, pixel, vec4(accumulatedM, historyLength));
}
