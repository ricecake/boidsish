#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outColor;
layout(binding = 1, rgba32f)  uniform image2D outDepth;
layout(binding = 2, rgba32f)  uniform image2D outMoments;

uniform sampler2D uPackedFrame;
uniform sampler2D uPackedDepth;
uniform sampler2D uPackedVelocity;

uniform sampler2D uHistoryFrame;
uniform sampler2D uSceneDepth;
uniform sampler2D uHistoryCloudDepth;
uniform sampler2D uHistoryMoments;

#include "../atmosphere/common.glsl"
#include "../helpers/lighting.glsl"
#include "../types/temporal_data.glsl"
#include "lygia/color/luma.glsl"
#include "helpers/math.glsl"

vec3 RGBToYCoCg(vec3 rgb) {
	float y  = dot(rgb, vec3(0.25, 0.5, 0.25));
	float co = dot(rgb, vec3(0.5, 0.0, -0.5));
	float cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
	return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
	float y  = ycocg.x;
	float co = ycocg.y;
	float cg = ycocg.z;
	float r = y + co - cg;
	float g = y + cg;
	float b = y - co - cg;
	return vec3(r, g, b);
}

vec2 getDilatedVelocity_Thresholded(vec2 uv, vec2 texelSize) {
    float closestDist = 50000.0;
    vec2 bestVelocity = texture(uPackedVelocity, uv).xy;

    // Baseline density of the current pixel to establish expectations
    float centerDensity = texture(uPackedDepth, uv).a;

    // We only trust depths from pixels that are at least 50% as dense as the center,
    // or have a baseline solidity, ignoring the ultra-thin jittered shell.
    float densityThreshold = max(centerDensity * 0.5, 0.1);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 sampleUV = uv + vec2(x, y) * texelSize;

            vec2 sampleVel = texture(uPackedVelocity, sampleUV).xy;
            vec4 sampleProps = texture(uPackedDepth, sampleUV);

            float sampleDist = sampleProps.r;
            float sampleDensity = sampleProps.a;

            // Only accept this depth if it's a solid hit
            if (sampleDensity > densityThreshold && sampleDist < closestDist) {
                closestDist = sampleDist;
                bestVelocity = sampleVel;
            }
        }
    }

    return bestVelocity;
}

vec2 getDilatedVelocity_Weighted(vec2 uv, vec2 texelSize) {
    vec2 sumVelocity = vec2(0.0);
    float sumWeight = 0.0;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 sampleUV = uv + vec2(x, y) * texelSize;

            vec2 sampleVel = texture(uPackedVelocity, sampleUV).xy;
            vec4 sampleProps = texture(uPackedDepth, sampleUV);

            float sampleDepth = sampleProps.r;
            float sampleDensity = sampleProps.a;

            // Ignore pure sky pixels
            if (sampleDepth > 40000.0) continue;

            // Weight primarily by density to ignore jittered wisps.
            // You can also divide by depth to slightly favor foregrounds.
            float weight = sampleDensity * sampleDensity; // Square to penalize fuzzy edges

            sumVelocity += sampleVel * weight;
            sumWeight += weight;
        }
    }

    if (sumWeight > 0.0001) {
        return sumVelocity / sumWeight;
    }

    return texture(uPackedVelocity, uv).xy; // Fallback
}

// Mitchell-Netravali Weight Function
float mitchell(float x, float B, float C) {
	float ax = abs(x);
	if (ax < 1.0) {
		return ((12.0 - 9.0 * B - 6.0 * C) * ax * ax * ax +
				(-18.0 + 12.0 * B + 6.0 * C) * ax * ax +
				(6.0 - 2.0 * B)) / 6.0;
	} else if (ax < 2.0) {
		return ((-B - 6.0 * C) * ax * ax * ax +
				(5.0 * B + 30.0 * C) * ax * ax +
				(-8.0 * B - 48.0 * C) * ax +
				(4.0 * B + 24.0 * C)) / 6.0;
	}
	return 0.0;
}

// 2D Bicubic Texture Fetch
vec4 textureMitchell(sampler2D tex, vec2 uv, vec2 textureSize) {
	// B = 0.0, C = 0.5 is standard Catmull-Rom
	// B = 0.0, C = 0.75 or 1.0 adds an aggressive sharpening lobe
	vec2 texelSize = 1.0 / textureSize;
	uv = uv * textureSize - 0.5;
	vec2 f = fract(uv);
	vec2 c = floor(uv);
	vec4 color = vec4(0.0);
	float weightsSum = 0.0;
	for (int j = -1; j <= 2; j++) {
		float wy = mitchell(float(j) - f.y, 1.0/3.0, 1.0/3.0);
		// float wy = mitchell(float(j) - f.y, 0.0, 0.75);
		for (int i = -1; i <= 2; i++) {
			float wx = mitchell(float(i) - f.x, 1.0/3.0, 1.0/3.0);
			// float wx = mitchell(float(i) - f.x, 0.0, 0.75);
			float weight = wx * wy;
			vec2 pos = (c + vec2(i, j) + 0.5) * texelSize;
			color += texture(tex, pos) * weight;
			weightsSum += weight;
		}
	}
	return color / weightsSum;
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outColor);
	if (pixel.x >= size.x || pixel.y >= size.y) return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	ivec2 bayer_offsets[4] = ivec2[](ivec2(0, 0), ivec2(1, 1), ivec2(1, 0), ivec2(0, 1));
	ivec2 current_offset = bayer_offsets[frameIndex % 4];
	bool is_new_pixel = (pixel % 2) == current_offset;

	ivec2 packedPixel = pixel / 2;
	vec2 velocity = getDilatedVelocity_Weighted(packedPixel, size);
	vec2 prevUV = uv + velocity;
	bool validHistory = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

	vec4 currentRGBA = vec4(0.0);
	vec4 currDepthProps = vec4(0.0);
	if (is_new_pixel) {
		currentRGBA = texelFetch(uPackedFrame, packedPixel, 0);
		currDepthProps = texelFetch(uPackedDepth, packedPixel, 0);
	}

	float currentPathDensity = currDepthProps.a;

	vec4 historyRGBA = vec4(0.0);
	vec4 historyMoments = vec4(0.0);
	vec4 historyDepthProps = vec4(0.0);
	float historyLength = 0.0;

	if (validHistory) {
		if (length(velocity) < 0.01) {
			historyRGBA = texture(uHistoryFrame, prevUV);
		}
		else {
			historyRGBA = textureMitchell(uHistoryFrame, prevUV, vec2(size));
		}
		historyMoments = texture(uHistoryMoments, prevUV);
		historyDepthProps = texture(uHistoryCloudDepth, prevUV);
		historyLength = historyMoments.w;

		if (is_new_pixel) {
			float depthDiff = abs(currDepthProps.r - historyDepthProps.r);
			if (depthDiff > currDepthProps.b * 8.0) {
				validHistory = false;
			}
		}
	}

	historyLength = validHistory ? min(32.0, historyLength + 1.0) : 1.0;

	if (!validHistory) {
		if (is_new_pixel) {
			historyRGBA = currentRGBA;
			historyDepthProps = currDepthProps;
		} else {
			historyRGBA = vec4(0, 0, 0, 1);
			historyDepthProps = vec4(50000.0 * worldScale, 50000.0 * worldScale, 100.0, 0.0);
		}
		historyMoments = vec4(0.0);
	}

	float historyPathDensity = historyDepthProps.a;

	vec3 m1 = vec3(0.0);
	vec3 m2 = vec3(0.0);
	float weightSum = 0.0;
	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			ivec2 neighborPixel = pixel + ivec2(x, y);
			if (any(lessThan(neighborPixel, ivec2(0))) || any(greaterThanEqual(neighborPixel, size))) continue;

			vec4 sampleRGBA;
			if ((neighborPixel % 2) == current_offset) {
				sampleRGBA = texelFetch(uPackedFrame, neighborPixel / 2, 0);
			} else {
				sampleRGBA = texelFetch(uHistoryFrame, neighborPixel, 0);
			}

			float w = exp(-float(x*x + y*y) / 4.0);
			vec3 ycocg = RGBToYCoCg(sampleRGBA.rgb);
			m1 += ycocg * w;
			m2 += ycocg * ycocg * w;
			weightSum += w;
		}
	}

	vec3 mean = m1 / weightSum;
	vec3 stddev = sqrt(max(vec3(0.0), (m2 / weightSum) - (mean * mean)));
	float gamma = is_new_pixel ? 1.5 : 0.5;
	vec3 minColor = mean - stddev * gamma;
	vec3 maxColor = mean + stddev * gamma;

	vec3 historyYCoCg = RGBToYCoCg(historyRGBA.rgb);
	historyYCoCg = clamp(historyYCoCg, minColor, maxColor);
	historyRGBA.rgb = YCoCgToRGB(historyYCoCg);


	// 5. Accumulate
	float densityDiff = currentPathDensity - historyPathDensity;
	float maxDensity = max(max(currentPathDensity, historyPathDensity), 0.001);
	float relativeDiff = densityDiff / maxDensity;

	// Trailing edges (cloud leaves pixel) cause severe sky smearing. Be aggressive.
	// If density drops by more than 40% (relativeDiff < -0.4), start rejecting.
	// Leading edges (cloud enters pixel) cause less offensive ghosting. Be forgiving
	// to prevent the dither noise from surviving the edge.
	float trailingEdgeRejection = smoothstep(-0.2, -0.6, relativeDiff);
	float leadingEdgeRejection = smoothstep(0.5, 0.9, relativeDiff);

	float rejectionFactor = max(trailingEdgeRejection, leadingEdgeRejection);
	float pixelSpeed = length(velocity * size);
	float motionConfidence = smoothstep(0.1, 1.0, pixelSpeed); // Only reject if actually moving

	rejectionFactor *= motionConfidence;

	float alpha = 0.0;
	if (is_new_pixel) {
		historyLength = mix(historyLength, 1.0, rejectionFactor);
		alpha = 1.0 / max(historyLength, 1.0);
	}


	vec4 accumulatedRGBA = is_new_pixel ? mix(historyRGBA, currentRGBA, alpha) : historyRGBA;
	vec4 accumulatedDepth = is_new_pixel ? mix(historyDepthProps, currDepthProps, alpha) : historyDepthProps;

	float currentLuma = luma(accumulatedRGBA.rgb);
	vec3 currentM = vec3(currentLuma, currentLuma * currentLuma, accumulatedDepth.a * accumulatedDepth.a);
	vec4 accumulatedMoments = vec4(mix(historyMoments.xyz, currentM, is_new_pixel ? alpha : 0.01), historyLength);

	imageStore(outColor, pixel, accumulatedRGBA);
	imageStore(outDepth, pixel, accumulatedDepth);
	imageStore(outMoments, pixel, accumulatedMoments);
}
