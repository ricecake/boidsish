#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outColor;
layout(binding = 1, rgba32f)  uniform image2D outDepth;

uniform sampler2D uCurrentFrame;     // Current low-res cloud RGBA
uniform sampler2D uHistoryFrame;     // Previous accumulated cloud RGBA
uniform sampler2D uSceneDepth;       // Full-res scene depth
uniform sampler2D uCurrentCloudDepth;// Current low-res cloud distance
uniform sampler2D uHistoryCloudDepth;// Previous accumulated cloud distance
uniform sampler2D uVelocityTexture;  // Current low-res cloud velocity (XZ)

uniform mat4  uInvView;
uniform mat4  uInvProjection;
uniform mat4  uPrevViewProjection;
uniform float uBlendAlpha; // How much history to keep (0.85-0.95)

#include "../atmosphere/common.glsl"
#include "lygia/color/luma.glsl"


uniform int   uFrameIndex;
uniform vec2  uJitter;
uniform float uCloudAltitude;

vec3 RGBToYCoCg(vec3 rgb) {
	float y  = dot(rgb, vec3(0.25, 0.5, 0.25));
	float co = dot(rgb, vec3(0.5, 0.0, -0.5));
	float cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
	return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
	float y  = ycocg.x;
	float co = ycocg.y;
	float cg = ycocg.z;
	float r = y + co - cg;
	float g = y + cg;
	float b = y - co - cg;
	return vec3(r, g, b);
}


vec4 SampleHistoryCatmullRom(sampler2D tex, vec2 uv, vec2 texSize) {
	vec2 samplePos = uv * texSize;
	vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
	vec2 f = samplePos - texPos1;

	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2 w3 = f * f * (-0.5 + 0.5 * f);

	vec2 w12 = w1 + w2;
	vec2 offset12 = w2 / (w1 + w2);

	vec2 texPos0 = texPos1 - 1.0;
	vec2 texPos3 = texPos1 + 2.0;
	vec2 texPos12 = texPos1 + offset12;

	texPos0 /= texSize;
	texPos3 /= texSize;
	texPos12 /= texSize;

	vec4 result = vec4(0.0);
	result += texture(tex, vec2(texPos0.x, texPos12.y)) * w0.x * w12.y;
	result += texture(tex, vec2(texPos12.x, texPos0.y)) * w12.x * w0.y;
	result += texture(tex, vec2(texPos12.x, texPos12.y)) * w12.x * w12.y;
	result += texture(tex, vec2(texPos3.x, texPos12.y)) * w3.x * w12.y;
	result += texture(tex, vec2(texPos12.x, texPos3.y)) * w12.x * w3.y;

	return result / (w12.x * w12.y + w0.x * w12.y + w12.x * w0.y + w3.x * w12.y + w12.x * w3.y);
}

// Mitchell-Netravali Weight Function
float mitchell(float x, float B, float C) {
	float ax = abs(x);
	if (ax < 1.0) {
		return ((12.0 - 9.0 * B - 6.0 * C) * ax * ax * ax +
				(-18.0 + 12.0 * B + 6.0 * C) * ax * ax +
				(6.0 - 2.0 * B)) / 6.0;
	} else if (ax < 2.0) {
		return ((-B - 6.0 * C) * ax * ax * ax +
				(5.0 * B + 30.0 * C) * ax * ax +
				(-8.0 * B - 48.0 * C) * ax +
				(4.0 * B + 24.0 * C)) / 6.0;
	}
	return 0.0;
}

// 2D Bicubic Texture Fetch
vec4 textureMitchell(sampler2D tex, vec2 uv, vec2 textureSize) {
	vec2 texelSize = 1.0 / textureSize;
	uv = uv * textureSize - 0.5;

	vec2 f = fract(uv);
	vec2 c = floor(uv);

	vec4 color = vec4(0.0);
	float weightsSum = 0.0;

	// 4x4 Neighborhood Sampling
	for (int j = -1; j <= 2; j++) {
		float wy = mitchell(float(j) - f.y, 1.0/3.0, 1.0/3.0);

		for (int i = -1; i <= 2; i++) {
			float wx = mitchell(float(i) - f.x, 1.0/3.0, 1.0/3.0);
			float weight = wx * wy;

			vec2 pos = (c + vec2(i, j) + 0.5) * texelSize;
			color += texture(tex, pos) * weight;
			weightsSum += weight;
		}
	}

	return color / weightsSum;
}

// float antiFlickerBlend() {
//         float clamp_dist = (min(abs(history.x - nmin.x), abs(history.x - nmax.x))) / max(max(history.x, ex.x), 1e-5);
//         blend_factor *= mix(0.2, 1.0, smoothstep(0.0, 2.0, clamp_dist));
// }

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outColor);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 jitteredUV = uv + uJitter;

	vec4  currentRGBA = textureMitchell(uCurrentFrame, uv, vec2(size));
	vec4  currDepth = texture(uCurrentCloudDepth, uv);
	float currentCloudDist = currDepth.r;
	float currentCloudLastHit = currDepth.g;
	float currentCloudStep = currDepth.b;
	float currentCloudMaxDensity = currDepth.a;

	float currentThickness = max(currentCloudLastHit - currentCloudDist, 1.0 * WORLD_SCALE_VALUE);
	float currentMissProbability = smoothstep(0.1, 1.0, currentCloudStep / currentThickness);
	bool currentIsSky = currentCloudDist > 40000.0 * WORLD_SCALE_VALUE;

	vec2 texelSize = 1.0 / vec2(size);
	float closestDist = 50000.0 * WORLD_SCALE_VALUE;
	vec2 closestUV = uv;

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 sampleUV = uv + vec2(x, y) * texelSize;
			float d = texture(uCurrentCloudDepth, sampleUV).a;
			if (d < closestDist) {
				closestDist = d;
				closestUV = sampleUV;
			}
		}
	}

	vec2 velocity = texture(uVelocityTexture, closestUV).rg;
	vec2 prevUV = uv + velocity;

	// 2. History Fetch and Validation
	bool validHistory = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

	vec4 historyRGBA = currentRGBA;
	if (validHistory) {
		historyRGBA = textureMitchell(uHistoryFrame, prevUV, vec2(size));
		// historyRGBA = SampleHistoryCatmullRom(uHistoryFrame, prevUV, vec2(size));

		// Prevent Catmull-Rom ringing (overshoot and undershoot)
		// historyRGBA.rgb = max(vec3(0.0), historyRGBA.rgb); // Kill negative energy
		// historyRGBA.a = clamp(historyRGBA.a, 0.0, 1.0);    // Keep transmittance physical
	}

	vec4  historyDepth = validHistory ? texture(uHistoryCloudDepth, prevUV) : currDepth;
	float historyCloudDist = historyDepth.r;
	float historyCloudLastHit = historyDepth.g;
	float historyCloudStep = historyDepth.b;
	float historyCloudMaxDensity = historyDepth.a;

	float historyThickness = max(historyCloudLastHit - historyCloudDist, 1.0 * WORLD_SCALE_VALUE);
	bool historyIsSky = historyCloudDist > 40000.0 * WORLD_SCALE_VALUE;
	float historyMissProbability = smoothstep(0.1, 1.0, historyCloudStep / historyThickness);

	float structuralRigidity = smoothstep(0.0, 0.4, currentCloudMaxDensity);
	// float structuralFlux = abs(currentCloudMaxDensity - historyCloudMaxDensity)/historyCloudMaxDensity;

	float nyquist = (max(historyMissProbability, currentMissProbability));
	float antiNyquist = (1.0 - nyquist);
	float structuralLock = structuralRigidity * antiNyquist;

	// Guard against divide-by-zero on pure sky history pixels
	float structuralFlux = abs(currentCloudMaxDensity - historyCloudMaxDensity) / max(historyCloudMaxDensity, 0.001);

	// Your exact isolation mask
	// if (structuralFlux > 0.00001 && historyThickness/historyCloudStep < 1.0) finalRGBA = vec4(5, 0, 0, 0);
	bool isNoisyFringe = (structuralFlux  > 0.00001 &&
						  (historyThickness / max(historyCloudStep, 1.0)) < 1.0);
	// float fringy = step(historyCloudDist, 45000) * (1-structuralRigidity) *smoothstep(0.0, 0.000005, structuralFlux) * (1.0 - smoothstep(0.0, 1.0, historyThickness / max(historyCloudStep, 1.0)));
	float fringy = step(historyCloudDist, 45000)  * (1.0 - smoothstep(0.0, 1.0, historyThickness / max(historyCloudStep, 1.0)));

	// bool isNoisyFringe = smoothstep(0.0, 1.0, abs(currentCloudDist-currentCloudLastHit)/currentCloudStep ) < 0.7;
	// if (structuralFlux > 0.30 && structuralRigidity < 0.3 && historyThickness/historyCloudStep > 1.0) finalRGBA = vec4(5, 0, 0, 0);

	bool isSilhouetteEdge = (currentIsSky != historyIsSky);


	vec3 m1 = vec3(0.0);
	vec3 m2 = vec3(0.0);
	float alphaM1 = 0.0;
	float alphaM2 = 0.0;

	float weightSumColor = 0.0;
	float weightSumAlpha = 0.0;
	float weightSumTrans = 0.0;

	for (int y = -2; y <= 2; y++) {
		for (int x = -2; x <= 2; x++) {
			// if(isNoisyFringe) {
				// vec4 smpH = texture(uHistoryFrame, uv + vec2(x, y) * texelSize);
			// }
			// else {
				vec4 smpC = texture(uCurrentFrame, uv + vec2(x, y) * texelSize);
			// }

			// vec4 smp = mix(smpC, smpH, fringy);
			vec4 smp = smpC;

			float spatialW = exp(-float(x*x + y*y) / 16.0);
			float opacity = clamp(1.0 - smp.a, 0.0, 1.0);

			// THE DYNAMIC BLUR INCREASE:
			// If it's a solid core, we respect opacity (bilateral) to preserve the sharp edge.
			// If it's a noisy fringe, we force the opacity multiplier to 1.0, creating a
			// maximum-strength Gaussian blur that melts the stochastic noise into the sky.
			// float adjustedOpacity = isNoisyFringe ? 1.0 : max(opacity, 0.001);
			float colorW = spatialW * max(opacity, 0.001);

			// if(isNoisyFringe && x ==0 && y == 0) {
			// 	colorW = 0.0;
			// 	spatialW = 0.0;
			// }

			vec3 ycocg = RGBToYCoCg(smp.rgb);// + fringy*vec3(10, 0,0);

			m1 += ycocg * colorW;
			m2 += ycocg * ycocg * colorW;

			alphaM1 += opacity * spatialW;
			alphaM2 += opacity * opacity * spatialW;

			weightSumColor += colorW;
			weightSumAlpha += spatialW;
		}
	}

	vec3 mean = m1 / weightSumColor;
	vec3 stddev = sqrt(max(vec3(0.0), (m2 / weightSumColor) - (mean * mean)));

	float alphaMean = alphaM1 / weightSumAlpha;
	float alphaStd = sqrt(max(0.0, (alphaM2 / weightSumAlpha) - (alphaMean * alphaMean)));


	// 4. Variance Clipping driven by Peak Structural Density (PSD)

	// Dynamic Gamma
	float gamma = mix(0.75, 2.5, structuralLock);
	float alphaGamma = mix(0.5, 1.5, structuralLock);

	// SILHOUETTE ANTI-CRUSH:
	// If the ray randomly jumped off or onto the cloud edge, the 3x3 neighborhood
	// is temporarily mismatched with the history. Expand the box massively to
	// let the historical data survive the clip.
	if (isSilhouetteEdge) {
		gamma *= 1.0;
		alphaGamma *= 1.1;
		// gamma *= 4.0;
		// alphaGamma *= 3.0;
	}

	// Minimum variance floor
	float minStddev = max(0.02, mean.x * 0.15);
	stddev = max(stddev, vec3(minStddev));
	alphaStd = max(alphaStd, 0.05);

	vec3 minColor = mean - gamma * stddev;
	vec3 maxColor = mean + gamma * stddev;

float falseNegativeLikelihood = smoothstep(0.1, 1.0, currentMissProbability);
maxColor += mean * falseNegativeLikelihood; // Expand bounds upward


	vec3 historyYCoCg = RGBToYCoCg(historyRGBA.rgb);

	// Clip-toward-mean YCoCg AABB intersection
	vec3 clipDir = mean - historyYCoCg;
	vec3 clipFactors = vec3(1.0);

	for (int i = 0; i < 3; i++) {
		if (abs(clipDir[i]) > 0.0001) {
			if (historyYCoCg[i] < minColor[i])
				clipFactors[i] = (minColor[i] - historyYCoCg[i]) / clipDir[i];
			else if (historyYCoCg[i] > maxColor[i])
				clipFactors[i] = (maxColor[i] - historyYCoCg[i]) / clipDir[i];
			else
				clipFactors[i] = 0.0;
		}
	}
	float clipT = clamp(max(clipFactors.x, max(clipFactors.y, clipFactors.z)), 0.0, 1.0);
	float clipEnforcement = 1.0;//isSilhouetteEdge ? 0.0 : mix(0.1, 1.0, structuralLock);

	vec3 clippedYCoCg = mix(historyYCoCg, mean, clipT);
	historyYCoCg = mix(historyYCoCg, clippedYCoCg, clipEnforcement);

	historyRGBA.rgb = YCoCgToRGB(historyYCoCg);

	// Keep alpha bounds physical to prevent transmittance inversion
	float historyOpacity = clamp(1.0 - historyRGBA.a, 0.0, 1.0);
// 1. Establish the standard spatial bounds
float minAlpha = alphaMean - alphaGamma * alphaStd;
float maxAlpha = alphaMean + alphaGamma * alphaStd;

// 2. Asymmetric Box Expansion (The "Trust History" Fix)
// If the current frame has a high miss probability, it's highly likely the spatial
// neighborhood is falsely reporting empty sky. We dynamically inflate the maximum
// bound to prevent valid history from being clipped away by a noisy miss.
// float falseNegativeLikelihood = smoothstep(0.1, 1.0, currentMissProbability);
maxAlpha += (1.0 - alphaMean) * falseNegativeLikelihood; // Expand bounds upward

// 3. 1D Clip-Toward-Mean Intersection
float alphaClipDir = alphaMean - historyOpacity;
float alphaClipFactor = 1.0;

if (abs(alphaClipDir) > 0.0001) {
    if (historyOpacity < minAlpha) {
        alphaClipFactor = (minAlpha - historyOpacity) / alphaClipDir;
    } else if (historyOpacity > maxAlpha) {
        alphaClipFactor = (maxAlpha - historyOpacity) / alphaClipDir;
    } else {
        alphaClipFactor = 0.0; // History is safely inside the bounds
    }
}

// 4. Apply the clip
float finalAlphaClipT = clamp(alphaClipFactor, 0.0, 1.0);
float clippedAlpha = mix(historyOpacity, alphaMean, finalAlphaClipT);

// 5. Final Enforcement (allowing silhouette relaxation if needed)
historyOpacity = mix(historyOpacity, clippedAlpha, clipEnforcement);
historyRGBA.a = 1.0 - clamp(historyOpacity, 0.0, 1.0);

	// 5. Continuous confidence-based blend weight
	float absDistDiff = abs(currentCloudDist - historyCloudDist);
	float normalizedDiff = max(0.0, absDistDiff - currentCloudStep) / max(min(currentCloudDist, historyCloudDist), 1.0);

	float depthConfidence;
	if (currentIsSky != historyIsSky) {

		if (currentIsSky) {
			// We missed this frame, but hit last frame.
			// If the historical cloud was thick (low miss probability), this is a real structural change -> low confidence.
			// If the historical cloud was thin (high miss probability), this is just jitter noise -> high confidence.
			depthConfidence = mix(0.15, 0.95, historyMissProbability);
		} else {
			// We hit this frame, but missed last frame.
			// If we just hit a massive structure, trust the new data immediately to prevent ghosting -> low confidence.
			// If we just hit a tiny wisp, bridge it with the sky history to prevent fireflies -> high confidence.
			depthConfidence = mix(0.15, 0.95, currentMissProbability);
		}

	} else if (currentIsSky) {
		depthConfidence = 1.0;
	} else {
		// Both hit cloud: Standard structural depth evaluation.

		// We can optionally use the miss probability here as well to expand the
		// depth tolerance for thin, wispy clouds that suffer from high first-hit variance.
		float localMissProb = min(currentMissProbability, historyMissProbability);

		float baseTolerance = mix(0.80, 0.25, smoothstep(0.0, 0.1, alphaMean));
		float depthTolerance = baseTolerance + (localMissProb * 0.5); // Forgive up to 50% more variance on thin wisps

		depthConfidence = 1.0 - smoothstep(0.05, depthTolerance, normalizedDiff);
	}


	// 4. "Dumb" High-Retention Accumulation
	// We completely abandon volumetric depth tracking and Miss Probabilities.
	// The spatial filter provides stable, blurred edges; the TAA just needs to accumulate them.
	float uvEdgeDist = min(min(prevUV.x, 1.0 - prevUV.x), min(prevUV.y, 1.0 - prevUV.y));
	float uvConfidence = smoothstep(0.0, 0.01, uvEdgeDist);

	// 1. Fetch un-interpolated scene depth using texelFetch to preserve hard edges
	ivec2 sceneTexSize = textureSize(uSceneDepth, 0);
	ivec2 depthPos = ivec2(jitteredUV * vec2(sceneTexSize));
	float rawSceneDepth = texelFetch(uSceneDepth, depthPos, 0).r;

	vec4 ndcDepth = vec4(jitteredUV * 2.0 - 1.0, rawSceneDepth * 2.0 - 1.0, 1.0);
	vec4 viewSpaceScene = uInvProjection * ndcDepth;
	float linearSceneDepth = -(viewSpaceScene.z / viewSpaceScene.w);

	if (rawSceneDepth >= 1.0) {
		linearSceneDepth = 50000.0 * WORLD_SCALE_VALUE;
	}

	// 2. Distance-Scaling Epsilon
	// Precision drops at a distance. A 1.5% error margin prevents distant Z-fighting.
	float depthEpsilon = 10.0 * WORLD_SCALE_VALUE + (linearSceneDepth * 0.015);

	// 3. Standard Disocclusion
	// Foreground object covers background cloud
	if (linearSceneDepth < currentCloudDist - depthEpsilon) {
		validHistory = false;
	}

	// 4. Jitter Silhouette Lock
	// Because the raymarcher terminates at the depth buffer, currentCloudDist
	// will match linearSceneDepth if the ray hit the mountain.
	bool currentIsTerrain = (linearSceneDepth - currentCloudDist) < depthEpsilon;

	if (currentIsTerrain) {
		// Pixel is currently on the mountain.
		// If history was in the sky/clouds (significantly deeper), kill it to prevent white ringing.
		if (historyCloudDist > linearSceneDepth + depthEpsilon) {
			validHistory = false;
		}
	} else {
		// Pixel is currently in the sky/clouds.
		// If history was on the mountain, kill it to prevent dark ringing.
		if (abs(historyCloudDist - linearSceneDepth) < depthEpsilon && linearSceneDepth < 45000.0 * WORLD_SCALE_VALUE) {
			validHistory = false;
		}
	}

	vec4  outputRGBA = mix(currentRGBA, vec4(YCoCgToRGB(mean), 1-alphaMean), 1.0);
	float currLuma = luma(outputRGBA);
	float histLuma = luma(historyRGBA);


	float blendWeight = 1.0;
	float lumaDiff = abs(currLuma - histLuma) / max(max(currLuma, histLuma), 0.001);
	// float lumaDiff = abs(currLuma - histLuma) / (currLuma + histLuma + 0.001);
	float lumaMix = 1.0 - clamp(blendWeight + (lumaDiff * 0.35), 0.0, fringy);
	// float lumaEpsilon = (currLuma - histLuma) / (currLuma + histLuma);
	// float lumaMix = 1.0 / lumaEpsilon;


	// Aggressive accumulation: the spatial filter pre-blurs depth-coherent samples,
	// so the TAA only needs to be conservative at actual depth discontinuities.
	float targetWeight = lumaMix * uvConfidence;// * depthConfidence;// * fringy;
	// float targetWeight = 15/16 * uvConfidence;

	// if (isNoisyFringe) targetWeight = 15/16 * uvConfidence;
	// if (!validHistory) targetWeight *= 0.0;//150;
	// if(isSilhouetteEdge) targetWeight = 1.0;

	float finalCloudDist = currentCloudDist;

	// vec4  outputRGBA = mix(currentRGBA, vec4(mean, 1-alphaMean), step(0.5, fringy));

	vec4  finalRGBA = mix(currentRGBA, historyRGBA, targetWeight);
	// finalRGBA.a = mix(currentRGBA.a, historyRGBA.a, 0.5);
	finalRGBA.a = mix(currentRGBA.a, historyRGBA.a, 0.75);
	float finalCloudLastHit = mix(currentCloudLastHit, historyCloudLastHit, targetWeight);
	float finalCloudStep = mix(currentCloudStep, historyCloudStep, targetWeight);
	float finalCloudMaxDensity = mix(currentCloudMaxDensity, historyCloudMaxDensity, targetWeight);

	// finalRGBA.r = float((log(currentCloudStep))/(currentThickness/1024));
	// finalRGBA.a = 1.0-(float(structuralRigidity) * float((log(currentCloudStep))/(currentThickness/1024)));
	// finalRGBA.r  = 4*step(0.6, currentMissProbability);
	// finalRGBA.r = 4*structuralLock;
	// finalRGBA.gba = vec3(0);
	// finalRGBA = mix(vec4(0,0,0,1.0), vec4(10.0, 0,0,0.0), float(isSilhouetteEdge));
	// finalRGBA = vec4(10*velocity, 0, 0);

	// if (structuralLock < 0.6) finalRGBA = mix(vec4(5.0,0,0, 0.0), finalRGBA, smoothstep(0.4, 0.5, structuralLock));

	// if (isSilhouetteEdge) finalRGBA.g = smoothstep(0, 5, max(currentCloudStep, historyCloudStep));
	// if (isSilhouetteEdge) finalRGBA.g = smoothstep(0, 5, max(currentCloudMaxDensity, historyCloudMaxDensity));
	// if (finalCloudMaxDensity > 0.01) finalRGBA = vec4(currentThickness/1000, (int(currentThickness)%1000)/100, int(currentThickness)%10, 0.0);

	imageStore(outColor, pixel, finalRGBA);
	imageStore(outDepth, pixel, vec4(finalCloudDist, finalCloudLastHit, finalCloudStep, finalCloudMaxDensity));
}