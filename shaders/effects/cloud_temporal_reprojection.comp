#version 460 core
#extension GL_ARB_shader_group_vote : require
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outColor;
layout(binding = 1, rgba32f) uniform image2D outDepth;
layout(binding = 2, rgba32f) uniform image2D outMoments;
layout(binding = 3, rgba32f) uniform image2D uErrorMap;

struct TileQueueHeader {
	uint count;
	uint maxTiles;
	uint frameIndex;
	float budgetFraction;
	uint minRefreshInterval;
	uint tileCols;
	uint tileRows;
	uint totalTiles;
};

layout(std430, binding = 59) buffer TileQueueSSBO {
	TileQueueHeader uHeader;
	uvec2 uTileQueue[];
};

uniform sampler2D uPackedFrame;
uniform sampler2D uPackedDepth;
uniform sampler2D uPackedVelocity;

uniform sampler2D uHistoryFrame;
uniform sampler2D uSceneDepth;
uniform sampler2D uHistoryCloudDepth;
uniform sampler2D uHistoryMoments;

uniform float uCloudTemporalGamma;
uniform float uCloudMaxHistoryLength;
uniform float uRenderScale;
uniform bool  uEnableTemporal;
uniform bool  uHasHistory;

uniform float uDeltaTime;
uniform mat4  uPrevViewProjection;

#include "../atmosphere/common.glsl"
#include "../helpers/lighting.glsl"
#include "../types/temporal_data.glsl"
#include "lygia/color/luma.glsl"
#include "helpers/math.glsl"

shared float sharedError[64];
shared float sharedFlow[64];

vec3 RGBToYCoCg(vec3 rgb) {
	float y  = dot(rgb, vec3(0.25, 0.5, 0.25));
	float co = dot(rgb, vec3(0.5, 0.0, -0.5));
	float cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
	return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
	float y  = ycocg.x;
	float co = ycocg.y;
	float cg = ycocg.z;
	float r = y + co - cg;
	float g = y + cg;
	float b = y - co - cg;
	return vec3(r, g, b);
}

struct NeighborhoodStats {
	vec3 spatialMean;
	vec3 stddev;
	float alphaMean;
	float alphaStddev;
};

NeighborhoodStats computeNeighborhoodStats(sampler2D frameTex, vec2 uv, vec2 texelSize) {
	vec3 m1 = vec3(0.0);
	vec3 m2 = vec3(0.0);
	float alphaM1 = 0.0;
	float alphaM2 = 0.0;
	float weightSum = 0.0;

	float weights[3] = float[](0.25, 0.5, 0.25);

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 sampleUV = uv + vec2(x, y) * texelSize;
			vec4 smp = texture(frameTex, sampleUV);

			vec3 ycocg = RGBToYCoCg(smp.rgb);
			float opacity = 1.0 - smp.a;

			float w = weights[abs(x)] * weights[abs(y)];

			m1 += ycocg * w;
			m2 += ycocg * ycocg * w;
			alphaM1 += opacity * w;
			alphaM2 += opacity * opacity * w;
			weightSum += w;
		}
	}

	NeighborhoodStats stats;
	stats.spatialMean = m1 / weightSum;
	stats.stddev = sqrt(max(vec3(0.0), (m2 / weightSum) - (stats.spatialMean * stats.spatialMean)));

	stats.alphaMean = alphaM1 / weightSum;
	stats.alphaStddev = sqrt(max(0.0, (alphaM2 / weightSum) - (stats.alphaMean * stats.alphaMean)));

	return stats;
}

vec3 calculateDynamicExtents(vec3 spatialStdDev, vec4 historyMoments, float baseGamma) {
	float histLumaMean = historyMoments.x;
	float histLumaSqMean = historyMoments.y;
	float temporalVar = max(0.0, histLumaSqMean - (histLumaMean * histLumaMean));
	float temporalStdDev = sqrt(temporalVar);

	vec3 extents = max(spatialStdDev * baseGamma, vec3(temporalStdDev * (baseGamma * 0.75)));
	vec3 minExtents = vec3(0.02);
	return max(extents, minExtents);
}

vec3 clipAABB(vec3 historyYCoCg, vec3 spatialMean, vec3 minColor, vec3 maxColor) {
	vec3 clipDir = spatialMean - historyYCoCg;
	vec3 clipFactors = vec3(1.0);

	for (int i = 0; i < 3; i++) {
		if (abs(clipDir[i]) > 0.0001) {
			if (historyYCoCg[i] < minColor[i])
				clipFactors[i] = (minColor[i] - historyYCoCg[i]) / clipDir[i];
			else if (historyYCoCg[i] > maxColor[i])
				clipFactors[i] = (maxColor[i] - historyYCoCg[i]) / clipDir[i];
			else
				clipFactors[i] = 0.0;
		}
	}
	float clipT = clamp(max(clipFactors.x, max(clipFactors.y, clipFactors.z)), 0.0, 1.0);
	return mix(historyYCoCg, spatialMean, clipT);
}

float clipAlpha(float historyAlpha, float minAlpha, float maxAlpha, float centerAlpha) {
	float clipDir = centerAlpha - historyAlpha;
	float clipFactor = 1.0;

	if (abs(clipDir) > 0.0001) {
		if (historyAlpha < minAlpha) {
			clipFactor = (minAlpha - historyAlpha) / clipDir;
		} else if (historyAlpha > maxAlpha) {
			clipFactor = (maxAlpha - historyAlpha) / clipDir;
		} else {
			clipFactor = 0.0;
		}
	}
	return mix(historyAlpha, centerAlpha, clamp(clipFactor, 0.0, 1.0));
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outColor);
	uint localIdx = gl_LocalInvocationIndex;
	bool inBounds = (pixel.x < size.x && pixel.y < size.y);

	ivec2 clampedPixel = clamp(pixel, ivec2(0), size - ivec2(1));
	vec2 uv = (vec2(clampedPixel) + 0.5) / vec2(size);
	vec2 texelSize = 1.0 / vec2(size);

	ivec2 tileCoord = clampedPixel / ivec2(8);
	vec4 tileErrorData = imageLoad(uErrorMap, ivec2(tileCoord));
	uint tileLastUpdated = uint(round(tileErrorData.a));
	bool tileWasRenderedThisFrame = (tileLastUpdated == uHeader.frameIndex);

	vec4 currDepthProps = texelFetch(uPackedDepth, clampedPixel, 0);
	vec2 velocity = texelFetch(uPackedVelocity, clampedPixel, 0).xy;
	vec2 prevUV = uv + velocity;

	bool validHistory = uHasHistory && all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

	vec4 currentRGBA = texelFetch(uPackedFrame, clampedPixel, 0);

	vec4 historyRGBA = vec4(0.0);
	vec4 historyMoments = vec4(0.0);
	vec4 historyDepthProps = vec4(0.0);
	float historyLength = 0.0;

	if (uEnableTemporal && validHistory) {
		historyRGBA = texture(uHistoryFrame, prevUV);
		historyMoments = texture(uHistoryMoments, prevUV);
		historyDepthProps = texture(uHistoryCloudDepth, prevUV);
		historyLength = historyMoments.w;

		float depthDiff = abs(currDepthProps.r - historyDepthProps.r);
		float allowedDiff = max(currDepthProps.b * 16.0, 0.15 * currDepthProps.r);
		allowedDiff = max(allowedDiff, 1000.0 * worldScale);
		if (depthDiff > allowedDiff) validHistory = false;
	}

	historyLength = (uEnableTemporal && validHistory) ? min(uCloudMaxHistoryLength, historyLength + 1.0) : 1.0;

	if (!uEnableTemporal || !validHistory) {
		historyRGBA = currentRGBA;
		historyDepthProps = currDepthProps;
		historyMoments = vec4(0.0);
	}

	float currentPathDensity = currDepthProps.a;
	float historyPathDensity = historyDepthProps.a;

	float lumaCurrent = luma(currentRGBA.rgb);
	float lumaHistory = luma(historyRGBA.rgb);
	float lumaDiff = abs(lumaCurrent - lumaHistory);
	float maxLuma = max(max(lumaCurrent, lumaHistory), 0.001);
	float relativeLumaDiff = lumaDiff / maxLuma;
	float lumaRejection = max(smoothstep(0.02, 0.25, relativeLumaDiff), smoothstep(0.03, 0.30, lumaDiff));

	float densityDelta = abs(currentPathDensity - historyPathDensity);
	float densityError = smoothstep(0.05, 0.5, densityDelta);

	float disocclusionError = validHistory ? 0.0 : 1.0;

	float centerDensity = currentPathDensity;
	float rightDensity = texture(uPackedDepth, uv + vec2(texelSize.x, 0.0)).a;
	float topDensity   = texture(uPackedDepth, uv + vec2(0.0, texelSize.y)).a;
	vec2 densityGradient = vec2(rightDensity - centerDensity, topDensity - centerDensity);
	float flowDensityChange = length(densityGradient) * length(velocity * vec2(size));
	float flowPredictor = clamp(flowDensityChange * 3.0, 0.0, 1.0);

	float perPixelError = inBounds ? (tileWasRenderedThisFrame ? max(max(lumaRejection, densityError), disocclusionError) : 0.5) : 0.0;
	float perPixelFlow = inBounds ? flowPredictor : 0.0;

	sharedError[localIdx] = perPixelError;
	sharedFlow[localIdx] = perPixelFlow;

	barrier();

	// Thread 0 aggregates error map metrics for the 8x8 tile
	if (localIdx == 0u) {
		float maxTileError = 0.0;
		float maxTileFlow = 0.0;
		for (uint i = 0u; i < 64u; i++) {
			maxTileError = max(maxTileError, sharedError[i]);
			maxTileFlow = max(maxTileFlow, sharedFlow[i]);
		}
		vec4 tileErr = imageLoad(uErrorMap, ivec2(tileCoord));
		tileErr.r = max(tileErr.r, maxTileError);
		tileErr.g = max(tileErr.g, maxTileFlow);
		imageStore(uErrorMap, ivec2(tileCoord), tileErr);
	}

	if (!inBounds) return;

	vec4 accumulatedRGBA;
	vec4 accumulatedDepth;
	vec4 accumulatedMoments;

	if (!tileWasRenderedThisFrame) {
		// Inactive tile: bypass blending with stale raymarch target and output reprojected history
		accumulatedRGBA = historyRGBA;
		accumulatedDepth = historyDepthProps;
		accumulatedMoments = vec4(historyMoments.xyz, historyLength);
	} else {
		bool isSky = (currentPathDensity < 0.01) && (historyPathDensity < 0.01);

		if (isSky) {
			float alpha = 1.0;
			if (uEnableTemporal) {
				historyLength = mix(historyLength, 1.0, lumaRejection);
				alpha = 1.0 / max(historyLength, 1.0);
				alpha = max(alpha, lumaRejection * 0.85);
			}

			accumulatedRGBA = mix(historyRGBA, currentRGBA, alpha);
			accumulatedDepth = mix(historyDepthProps, currDepthProps, alpha);

			float currentLuma = luma(accumulatedRGBA.rgb);
			vec3 currentM = vec3(currentLuma, currentLuma * currentLuma, accumulatedDepth.a * accumulatedDepth.a);
			accumulatedMoments = vec4(mix(historyMoments.xyz, currentM, alpha), historyLength);
		} else {
			NeighborhoodStats stats = computeNeighborhoodStats(uPackedFrame, uv, texelSize);

			float gamma = uCloudTemporalGamma;
			vec3 extents = calculateDynamicExtents(stats.stddev, historyMoments, gamma);
			vec3 minColor = stats.spatialMean - extents;
			vec3 maxColor = stats.spatialMean + extents;

			float minAlpha = stats.alphaMean - stats.alphaStddev * gamma;
			float maxAlpha = stats.alphaMean + stats.alphaStddev * gamma;

			vec3 historyYCoCg = RGBToYCoCg(historyRGBA.rgb);
			float historyOpacity = clamp(1.0 - historyRGBA.a, 0.0, 1.0);

			float lumaConfidence = smoothstep(0.20, 0.02, relativeLumaDiff);
			float motionConfidenceFactor = smoothstep(2.0, 0.2, length(velocity * size));
			float confidence = lumaConfidence * motionConfidenceFactor;

			vec3 clippedHistoryYCoCg = clipAABB(historyYCoCg, stats.spatialMean, minColor, maxColor);
			float clippedHistoryOpacity = clipAlpha(historyOpacity, minAlpha, maxAlpha, stats.alphaMean);

			historyYCoCg = mix(clippedHistoryYCoCg, historyYCoCg, confidence * 0.9);
			float blendedOpacity = mix(clippedHistoryOpacity, historyOpacity, confidence * 0.9);

			historyRGBA.rgb = YCoCgToRGB(historyYCoCg);
			historyRGBA.a = 1.0 - clamp(blendedOpacity, 0.0, 1.0);

			float densityDiff = currentPathDensity - historyPathDensity;
			float relativeDiff = densityDiff / max(max(currentPathDensity, historyPathDensity), 0.001);
			float trailingEdgeRejection = 1.0 - smoothstep(-0.5, -0.3, relativeDiff);
			float leadingEdgeRejection = smoothstep(0.4, 0.8, relativeDiff);
			float spatialRejection = max(trailingEdgeRejection, leadingEdgeRejection) * smoothstep(0.1, 1.0, length(velocity * size));

			float totalRejection = max(spatialRejection, lumaRejection);

			float alpha = 1.0;
			if (uEnableTemporal) {
				historyLength = mix(historyLength, 1.0, totalRejection);
				alpha = 1.0 / max(historyLength, 1.0);
				alpha = max(alpha, lumaRejection * 0.85);
			}

			accumulatedRGBA = mix(historyRGBA, currentRGBA, alpha);
			accumulatedDepth = mix(historyDepthProps, currDepthProps, alpha);

			float currentLuma = luma(accumulatedRGBA.rgb);
			vec3 currentM = vec3(currentLuma, currentLuma * currentLuma, accumulatedDepth.a * accumulatedDepth.a);
			accumulatedMoments = vec4(mix(historyMoments.xyz, currentM, alpha), historyLength);
		}
	}

	imageStore(outColor, clampedPixel, accumulatedRGBA);
	imageStore(outDepth, clampedPixel, accumulatedDepth);
	imageStore(outMoments, clampedPixel, accumulatedMoments);
}
