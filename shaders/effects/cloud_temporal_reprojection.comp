#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outColor;
layout(binding = 1, rgba32f)  uniform image2D outDepth;

uniform sampler2D uCurrentFrame;     // Current low-res cloud RGBA
uniform sampler2D uHistoryFrame;     // Previous accumulated cloud RGBA
uniform sampler2D uSceneDepth;       // Full-res scene depth
uniform sampler2D uCurrentCloudDepth;// Current low-res cloud distance
uniform sampler2D uHistoryCloudDepth;// Previous accumulated cloud distance
uniform sampler2D uVelocityTexture;  // Current low-res cloud velocity (XZ)

uniform mat4  uInvView;
uniform mat4  uInvProjection;
uniform mat4  uPrevViewProjection;
uniform float uBlendAlpha; // How much history to keep (0.85-0.95)

#include "../atmosphere/common.glsl"

uniform int   uFrameIndex;
uniform vec2  uJitter;
uniform float uCloudAltitude;

vec3 RGBToYCoCg(vec3 rgb) {
	float y  = dot(rgb, vec3(0.25, 0.5, 0.25));
	float co = dot(rgb, vec3(0.5, 0.0, -0.5));
	float cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
	return vec3(y, co, cg);
}

vec3 YCoCgToRGB(vec3 ycocg) {
	float y  = ycocg.x;
	float co = ycocg.y;
	float cg = ycocg.z;
	float r = y + co - cg;
	float g = y + cg;
	float b = y - co - cg;
	return vec3(r, g, b);
}


vec4 SampleHistoryCatmullRom(sampler2D tex, vec2 uv, vec2 texSize) {
	vec2 samplePos = uv * texSize;
	vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
	vec2 f = samplePos - texPos1;

	vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
	vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
	vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
	vec2 w3 = f * f * (-0.5 + 0.5 * f);

	vec2 w12 = w1 + w2;
	vec2 offset12 = w2 / (w1 + w2);

	vec2 texPos0 = texPos1 - 1.0;
	vec2 texPos3 = texPos1 + 2.0;
	vec2 texPos12 = texPos1 + offset12;

	texPos0 /= texSize;
	texPos3 /= texSize;
	texPos12 /= texSize;

	vec4 result = vec4(0.0);
	result += texture(tex, vec2(texPos0.x, texPos12.y)) * w0.x * w12.y;
	result += texture(tex, vec2(texPos12.x, texPos0.y)) * w12.x * w0.y;
	result += texture(tex, vec2(texPos12.x, texPos12.y)) * w12.x * w12.y;
	result += texture(tex, vec2(texPos3.x, texPos12.y)) * w3.x * w12.y;
	result += texture(tex, vec2(texPos12.x, texPos3.y)) * w12.x * w3.y;

	return result / (w12.x * w12.y + w0.x * w12.y + w12.x * w0.y + w3.x * w12.y + w12.x * w3.y);
}

void main() {
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(outColor);
	if (pixel.x >= size.x || pixel.y >= size.y)
		return;

	vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
	vec2 jitteredUV = uv + uJitter;

	vec4  currentRGBA = texture(uCurrentFrame, uv);
	vec4  currDepth = texture(uCurrentCloudDepth, uv);
	float currentCloudDist = currDepth.r;
	float currentCloudLastHit = currDepth.g;
	float currentCloudStep = currDepth.b;

	// 1. Reprojection using screen-space motion vectors
	// The velocity texture now contains direct UV offsets (prevUV - currentUV)
	// that already encode both camera motion and cloud advection.

	// 3x3 Dilation: use the motion vector from the closest cloud pixel
	// to avoid edge artifacts where sky pixels have less accurate vectors.
	vec2 texelSize = 1.0 / vec2(size);
	float closestDist = 50000.0 * WORLD_SCALE_VALUE;
	vec2 closestUV = uv;

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec2 sampleUV = uv + vec2(x, y) * texelSize;
			float d = texture(uCurrentCloudDepth, sampleUV).r;
			if (d < closestDist) {
				closestDist = d;
				closestUV = sampleUV;
			}
		}
	}

	vec2 velocity = texture(uVelocityTexture, closestUV).rg;
	vec2 prevUV = uv + velocity;

	// 2. History Fetch and Validation
	bool validHistory = all(greaterThanEqual(prevUV, vec2(0.0))) && all(lessThanEqual(prevUV, vec2(1.0)));

	vec4 historyRGBA = currentRGBA;
	if (validHistory) {
		historyRGBA = SampleHistoryCatmullRom(uHistoryFrame, prevUV, vec2(size));

		// Prevent Catmull-Rom ringing (overshoot and undershoot)
		historyRGBA.rgb = max(vec3(0.0), historyRGBA.rgb); // Kill negative energy
		historyRGBA.a = clamp(historyRGBA.a, 0.0, 1.0);    // Keep transmittance physical
	}

	vec4  historyDepth = validHistory ? texture(uHistoryCloudDepth, prevUV) : currDepth;
	float historyCloudDist = historyDepth.r;
	float historyCloudLastHit = historyDepth.g;
	float historyCloudStep = historyDepth.b;

	// 3. Neighborhood Analysis (3x3)
	// vec2 texelSize = 1.0 / vec2(size);
	vec3 m1 = vec3(0.0);
	vec3 m2 = vec3(0.0);
	float alphaMean = 0.0;
	float alphaM2 = 0.0;
	float transMean = 0.0;

	float weightSumColor = 0.0;
	float weightSumAlpha = 0.0;
	float weightSumTrans = 0.0;
	vec3 localMin = vec3(100000.0);
	vec3 localMax = vec3(-100000.0);

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			vec4 smp = texture(uCurrentFrame, uv + vec2(x, y) * texelSize);

			localMin = min(localMin, smp.rgb);
			localMax = max(localMax, smp.rgb);

			// Spatial Gaussian weight
			float spatialW = (x == 0 && y == 0) ? 0.25 : ((x == 0 || y == 0) ? 0.125 : 0.0625);

			// Weight color stats by opacity so the black sky doesn't ruin the cloud bounds
			float opacity = clamp(1.0 - smp.a, 0.0, 1.0);
			float colorW = spatialW * max(opacity, 0.001);

			vec3 ycocg = RGBToYCoCg(smp.rgb);

			m1 += ycocg * colorW;
			m2 += ycocg * ycocg * colorW;
			weightSumColor += colorW;

			alphaMean += opacity * spatialW;
			alphaM2 += opacity * opacity * spatialW;
			weightSumAlpha += spatialW;

			transMean += smp.a * spatialW;
			weightSumTrans += spatialW;
		}
	}
	historyRGBA.rgb = clamp(historyRGBA.rgb, localMin, localMax);

	vec3 mean = m1 / weightSumColor;
	vec3 stddev = sqrt(max(vec3(0.0), (m2 / weightSumColor) - (mean * mean)));

	alphaMean /= weightSumAlpha;
	float alphaStd = sqrt(max(0.0, (alphaM2 / weightSumAlpha) - (alphaMean * alphaMean)));

	transMean /= weightSumTrans;

	// Tighter variance bounds — relax only slightly in low-density regions
	// Alpha clamping: loosest at boundary regions (mid-transmittance) where the
	// binary density step causes oscillation, tighter in solid cloud or clear sky
	// float boundaryness = 1.0 - abs(alphaMean - 0.5) * 2.0; // 1.0 at alphaMean=0.5, 0.0 at extremes
	float boundaryness = 1.0 - smoothstep(0.0, 0.80, alphaMean); // 1.0 at alphaMean=0.5, 0.0 at extremes
	float alphaGamma = mix(0.5, 1.0, boundaryness);
	float gamma = mix(3.00, 3.8, boundaryness);

	// 4. Variance clipping (clip toward mean rather than hard clamp for stability)
	vec3 minColor = mean - gamma * stddev;
	vec3 maxColor = mean + gamma * stddev;

	vec3 historyYCoCg = RGBToYCoCg(historyRGBA.rgb);

	// Clip-toward-mean: find the intersection of the line from history to mean with the AABB
	vec3 clipDir = mean - historyYCoCg;
	vec3 clipFactors = vec3(1.0);

	for (int i = 0; i < 3; i++) {
		if (abs(clipDir[i]) > 0.0001) {
			if (historyYCoCg[i] < minColor[i])
				clipFactors[i] = (minColor[i] - historyYCoCg[i]) / clipDir[i];
			else if (historyYCoCg[i] > maxColor[i])
				clipFactors[i] = (maxColor[i] - historyYCoCg[i]) / clipDir[i];
			else
				clipFactors[i] = 0.0;
		}
	}

	float clipT = clamp(max(clipFactors.x, max(clipFactors.y, clipFactors.z)), 0.0, 1.0);

	// STOCHASTIC FRINGE FIX:
	// Smoothly bypass the clip in low-density regions so the temporal accumulation can stabilize.
	float clipBlend = smoothstep(0.5, 0.75, alphaMean);

	vec3 clippedYCoCg = mix(historyYCoCg, mean, clipT);
	historyYCoCg = mix(historyYCoCg, clippedYCoCg, clipBlend);
	historyRGBA.rgb = YCoCgToRGB(historyYCoCg);

	float historyOpacity = clamp(1.0 - historyRGBA.a, 0.0, 1.0);
	historyOpacity = clamp(historyOpacity, alphaMean - alphaGamma * alphaStd, alphaMean + alphaGamma * alphaStd);
	historyRGBA.a = 1.0 - historyOpacity;

	// 5. Continuous confidence-based blend weight
	float absDistDiff = abs(currentCloudDist - historyCloudDist);
	float normalizedDiff = max(0.0, absDistDiff - currentCloudStep) / max(min(currentCloudDist, historyCloudDist), 1.0);

	// Depth confidence: smoothly reduces blend as depth disagreement grows.
	// For cloud/sky transitions (one is far-sky, other is near-cloud), use a gentler
	// falloff to allow the boundary to converge rather than snapping.
	bool currentIsSky = currentCloudDist > 40000.0 * WORLD_SCALE_VALUE;
	bool historyIsSky = historyCloudDist > 40000.0 * WORLD_SCALE_VALUE;

	float depthConfidence;
	if (currentIsSky != historyIsSky) {
		// Edge miss: maintain high confidence to bridge the skybox gap
		depthConfidence = 0.85;
	} else if (currentIsSky) {
		depthConfidence = 1.0;
	} else {
		// In low-density wisps, forgive a massive 80% depth disagreement
		// In solid clouds, enforce the strict 25% boundary check
		float depthTolerance = mix(0.80, 0.25, smoothstep(0.0, 0.1, alphaMean));
		depthConfidence = 1.0 - smoothstep(0.05, depthTolerance, normalizedDiff);
	}

	// UV confidence: reduce blend near screen edges where reprojection is less reliable
	float uvEdgeDist = min(min(prevUV.x, 1.0 - prevUV.x), min(prevUV.y, 1.0 - prevUV.y));
	float uvConfidence = smoothstep(0.0, 0.01, uvEdgeDist);

// 1. Fetch un-interpolated scene depth using texelFetch to preserve hard edges
	ivec2 sceneTexSize = textureSize(uSceneDepth, 0);
	ivec2 depthPos = ivec2(jitteredUV * vec2(sceneTexSize));
	float rawSceneDepth = texelFetch(uSceneDepth, depthPos, 0).r;

	vec4 ndcDepth = vec4(jitteredUV * 2.0 - 1.0, rawSceneDepth * 2.0 - 1.0, 1.0);
	vec4 viewSpaceScene = uInvProjection * ndcDepth;
	float linearSceneDepth = -(viewSpaceScene.z / viewSpaceScene.w);

	if (rawSceneDepth >= 1.0) {
		linearSceneDepth = 50000.0 * WORLD_SCALE_VALUE;
	}

	// 2. Distance-Scaling Epsilon
	// Precision drops at a distance. A 1.5% error margin prevents distant Z-fighting.
	float depthEpsilon = 10.0 * WORLD_SCALE_VALUE + (linearSceneDepth * 0.015);

	// 3. Standard Disocclusion
	// Foreground object covers background cloud
	if (linearSceneDepth < currentCloudDist - depthEpsilon) {
		validHistory = false;
	}

	// 4. Jitter Silhouette Lock
	// Because the raymarcher terminates at the depth buffer, currentCloudDist
	// will match linearSceneDepth if the ray hit the mountain.
	bool currentIsTerrain = (linearSceneDepth - currentCloudDist) < depthEpsilon;

	if (currentIsTerrain) {
		// Pixel is currently on the mountain.
		// If history was in the sky/clouds (significantly deeper), kill it to prevent white ringing.
		if (historyCloudDist > linearSceneDepth + depthEpsilon) {
			validHistory = false;
		}
	} else {
		// Pixel is currently in the sky/clouds.
		// If history was on the mountain, kill it to prevent dark ringing.
		if (abs(historyCloudDist - linearSceneDepth) < depthEpsilon && linearSceneDepth < 45000.0 * WORLD_SCALE_VALUE) {
			validHistory = false;
		}
	}

	float targetWeight = 0.96 * smoothstep(0.25, 0.75, depthConfidence) * uvConfidence;

	if (!validHistory) targetWeight = 0.0;

	vec4  finalRGBA = mix(currentRGBA, historyRGBA, targetWeight);
	float finalCloudDist = currentCloudDist;
	float finalCloudLastHit = mix(currentCloudLastHit, historyCloudLastHit, targetWeight);
	float finalCloudStep = mix(currentCloudStep, historyCloudStep, targetWeight);

	imageStore(outColor, pixel, finalRGBA);
	imageStore(outDepth, pixel, vec4(finalCloudDist, finalCloudLastHit, finalCloudStep, 0.0));
}