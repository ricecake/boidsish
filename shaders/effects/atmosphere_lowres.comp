#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outPackedColor;
layout(binding = 1, rgba32f) uniform image2D outPackedDepth;
layout(binding = 2, rg16f)   uniform image2D outPackedVelocity;

uniform sampler2D depthTexture;

uniform float uDeltaTime;

uniform vec3  cloudColorUniform;
#define ATMOSPHERE_HEIGHT_DEFINED
uniform float u_atmosphereHeight;

uniform sampler2D uHistoryDepth;
uniform sampler2D uHistoryMoments;
uniform mat4  uPrevViewProjection;
uniform bool  uHasHistory;

uniform sampler2D u_skyViewLUT;

uniform float uCloudMaxRayDistance;
uniform int   uCloudMinSamples;
uniform int   uCloudMaxSamples;
uniform float uCloudExtinction;
uniform vec3  uCloudExtinctionColor;

#include "../atmosphere/common.glsl"
#include "../helpers/clouds.glsl"
#include "../helpers/fast_noise.glsl"
#include "../helpers/lighting.glsl"
#include "../types/temporal_data.glsl"
#include "helpers/math.glsl"
#include "lygia/generative/wavelet.glsl"
#include "lygia/generative/voronoi.glsl"
#include "lygia/generative/random.glsl"
#include "helpers/astral.glsl"

float R_earth = kEarthRadius * 1000.0 * worldScale;


void main() {
	ivec2 packedPixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 packedSize = imageSize(outPackedColor);
	if (packedPixel.x >= packedSize.x || packedPixel.y >= packedSize.y)
		return;

	// 2x2 Bayer pattern for interleaving
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 offset = bayer_offsets[frameIndex % 4];
	ivec2 fullResPixel = packedPixel * 2 + offset;
	ivec2 fullResSize = packedSize * 2;

	vec2 TexCoords = (vec2(fullResPixel) + 0.5) / vec2(fullResSize);

	float depth = texture(depthTexture, TexCoords).r;
	float z = depth * 2.0 - 1.0;
	vec4  clipSpacePosition = vec4(TexCoords * 2.0 - 1.0, z, 1.0);
	vec4  viewSpacePosition = invProjection * clipSpacePosition;
	viewSpacePosition /= viewSpacePosition.w;
	vec3 worldPos = (invView * viewSpacePosition).xyz;
	vec3 canonicalRayDir = normalize(worldPos - viewPos);
	float dist = length(worldPos - viewPos);

	vec3 rayDir = canonicalRayDir;

	if (depth == 1.0) {
		dist = uCloudMaxRayDistance * worldScale;
		worldPos = viewPos + rayDir * dist;
	}

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	float R_floor = R_earth + (cloudAltitude - 500.0) * worldScale;
	float R_ceiling = R_earth + (cloudAltitude + cloudThickness * 10.0 + 5000.0) * worldScale;

	vec3 earthCenter = vec3(viewPos.x, -R_earth, viewPos.z);
	vec3 relRo = viewPos - earthCenter;

	float t_start = 1e10;
	float t_end = -1e10;

	float t0, t1;
	if (intersectSphere(relRo, rayDir, R_ceiling, t0, t1)) {
		t_start = max(0.0, t0);
		t_end = t1;

		if (intersectSphere(relRo, rayDir, R_floor, t0, t1)) {
			if (t0 < 0.0) {
				t_start = max(t_start, t1);
			} else {
				t_end = min(t_end, t0);
			}
		}
	}

	t_end = min(t_end, dist);

	int samples = 64;
	float historyVariance = 0.0;
	float historyLength = 0.0;

	// Guided Marching using history
	float expectedStart = t_start;
	float expectedEnd = t_end;
	float maxEmptyMult = 1.0;

	if (uHasHistory && t_start < t_end) {
		vec4 prevClip = uPrevViewProjection * vec4(viewPos + rayDir * max(t_start, 0.1), 1.0);
		vec2 histUV = (prevClip.xy / prevClip.w) * 0.5 + 0.5;

		if (all(greaterThanEqual(histUV, vec2(0.0))) && all(lessThanEqual(histUV, vec2(1.0)))) {
			vec4 histDepth = texture(uHistoryDepth, histUV);
			float histFirst = histDepth.r;
			float histLast = histDepth.g;
			float histStep = histDepth.b;

			vec4 histMoments = texture(uHistoryMoments, histUV);
			historyVariance = max(0.0, histMoments.y - histMoments.x * histMoments.x);
			historyLength = histMoments.w;

			float varianceBoost = smoothstep(0.0, 0.05, historyVariance);
			float historyBoost = 1.0 - smoothstep(1.0, 16.0, historyLength);
			float historyConfidence = max(varianceBoost, historyBoost);
			samples = int(mix(float(uCloudMinSamples), float(uCloudMaxSamples), pow(historyConfidence, 2.0)));

			if (histFirst > 0.0 && histFirst < uCloudMaxRayDistance * 0.4 * worldScale) {
				float marginScale = mix(1.0, 4.0, historyConfidence);
				float margin = max(histStep * 2.0 * marginScale, (histLast - histFirst) * 0.5 * marginScale);

				expectedStart = histFirst - margin;
				expectedEnd = histLast + margin;
				maxEmptyMult = mix(1.0, 4.0, historyConfidence);
			}
		}
	}

	// float jitter = bayer4x4StepPhase(fullResPixel, frameIndex);
	// float jitter = fastSpatiotemporalBlueNoise(fullResPixel, 0, uFrameIndex);
	float jitter = InterleavedGradientNoise(fullResPixel, frameIndex);
	// float jitter = 0.0;


	vec3  cloudColor = vec3(0.0);
	vec3 cloudTransmittance = vec3(1.0);
	float totalWeight = 0.0;
	float weightedDistSum = 0.0;
	vec3  weightedAdvectionSum = vec3(0.0);
	vec3 accumulatedOpticalDepth = vec3(0.0);
	float firstHitDist = -1.0;
	float lastHitDist = -1.0;
	float pathDensity = 0.0;

	float rayDist = t_end - t_start;
	float precisionLimit = max(1.0, t_end * 1e-5);
	float baseStepSize = clamp(rayDist / float(samples), precisionLimit, 200.0);

	float t_offset = jitter * baseStepSize;
	float firstStepSize = baseStepSize;
	float minStepSize = 100000;

	if (t_start < t_end) {
		vec3 lightEnergy = vec3(0.0);
		vec3 prevDensity = vec3(0.0);
		vec3 prevTransmission = vec3(-1.0);
		vec3 prevTransmissionDelta = vec3(0.0);
		const int shadow_samples = 5;

		vec3 primaryLightDir = vec3(0, 1, 0);
		for (int j = 0; j < num_lights; j++) {
			if (lights[j].type == LIGHT_TYPE_DIRECTIONAL) {
				primaryLightDir = normalize(-lights[j].direction);
				break;
			}
		}

		float H0 = length(relRo) - R_earth;
		float roDotRd = dot(relRo, rayDir);
		float h0Term = 2.0 * R_earth * H0 + H0 * H0;

		float lodDistanceThreshold = 25000.0 * worldScale;

		int MAX_ITERATIONS = 500;

		float t = t_start + jitter * baseStepSize;
		float blendDist = 500.0 * worldScale;

		for (int i = 0; i < MAX_ITERATIONS; i++) {
			if (t >= dist || t >= t_end || max(cloudTransmittance.x, max(cloudTransmittance.y, cloudTransmittance.z)) < 0.01) break;

			vec3 p = viewPos + rayDir * t;
			CloudWeather weather = computeCloudWeather(p, props);
			CloudLayer layer = computeCloudLayer(weather, props);

			float r2_minus_R2 = h0Term + 2.0 * t * roDotRd + t * t;
			float r = sqrt(max(0.0, r2_minus_R2 + R_earth * R_earth));
			float altitude = r2_minus_R2 / (r + R_earth);

			float rayXZLen = max(length(rayDir.xz), 1e-4);

			// 1. Outside XZ Footprint: Jump using 2D SDF
			if (weather.sdf >= 0.0) {
				float jump = clamp(weather.sdf / rayXZLen, 2*worldScale, 500*worldScale);
				t += jump;
				prevDensity = vec3(0.0);
				continue;
			}

			// 2. Inside XZ Footprint, but outside vertical bounds: Jump to floor or ceiling
			if (altitude < layer.baseFloor - 0.1 || altitude > layer.baseCeiling + 0.1) {
				float targetAlt = (altitude < layer.baseFloor) ? layer.baseFloor : layer.baseCeiling;
				float t0, t1;
				if (intersectSphere(relRo, rayDir, R_earth + targetAlt, t0, t1)) {
					float jumpT = 1e10;
					if (t0 > t + 0.1) jumpT = min(jumpT, t0);
					if (t1 > t + 0.1) jumpT = min(jumpT, t1);
					if (jumpT < t_end) {
						t = jumpT;
						prevDensity = vec3(0.0);
						continue;
					}
				}
				// If we can't hit the vertical bounds, move across the footprint to find the exit
				t += max(baseStepSize, abs(weather.sdf) / rayXZLen);
				prevDensity = vec3(0.0);
				continue;
			}

			// 3. Inside Cloud Volume: Measure thickness and evenly sample
			float t_entry = t;
			float t_exit = t_end;
			float t0, t1;
			if (intersectSphere(relRo, rayDir, R_earth + layer.baseFloor, t0, t1)) {
				if (t0 > t + 0.1) t_exit = min(t_exit, t0);
				if (t1 > t + 0.1) t_exit = min(t_exit, t1);
			}
			if (intersectSphere(relRo, rayDir, R_earth + layer.baseCeiling, t0, t1)) {
				if (t0 > t + 0.1) t_exit = min(t_exit, t0);
				if (t1 > t + 0.1) t_exit = min(t_exit, t1);
			}

			// Estimate SDF exit
			CloudWeather exitPointWeather = computeCloudWeather(viewPos + rayDir * t, props);
			int iter = 0;
			float loop_t = t;
			float t_last_inside = t;

			while (loop_t < t_exit && iter < 30) {
				if (exitPointWeather.sdf >= 0.0) {
					break; // Left the XZ footprint
				}

				t_last_inside = loop_t;

				float jump = abs(exitPointWeather.sdf) / rayXZLen;
				loop_t += clamp(jump, 2.0 * props.worldScale, 200.0 * props.worldScale);

				exitPointWeather = computeCloudWeather(viewPos + rayDir * loop_t, props);
				iter++;
			}

			if (loop_t >= t_exit) {
				t_last_inside = t_exit - (2.0 * props.worldScale);
			}

			float t_exit_inside = max(t_entry + (2.0 * props.worldScale), t_last_inside);

			float cloudVolumeT = t_exit_inside - t_entry;
			float targetStepSize = 50.0 * props.worldScale;

			int innerSamples = max(3, int(ceil(cloudVolumeT / targetStepSize)));
			float innerStepSize = cloudVolumeT / float(innerSamples);

			t_exit = max(t_exit_inside, loop_t) + (2.0 * props.worldScale);

			// --- Adaptive Raymarching Setup ---
			float baseTargetStepSize = 50.0 * props.worldScale;
			float currentStepSize = baseTargetStepSize;
			float subT = t_entry + (jitter * currentStepSize);

			// Use a high max iteration limit, as we rely on t_exit and transmittance to break
			int MAX_INNER_SAMPLES = 250;

			for (int k = 0; k < MAX_INNER_SAMPLES; k++) {
				if (subT >= t_exit || max(cloudTransmittance.x, max(cloudTransmittance.y, cloudTransmittance.z)) < 0.01) break;

				vec3 subP = viewPos + rayDir * subT;

				// Sub-sample altitude and lighting properties
				float r2_sub = h0Term + 2.0 * subT * roDotRd + subT * subT;
				float r_sub = sqrt(max(0.0, r2_sub + R_earth * R_earth));
				float subAltitude = r2_sub / (r_sub + R_earth);
				float h_norm = clamp((subAltitude - props.altitude * props.worldScale) / max(props.thickness * props.worldScale, 1.0), 0.0, 1.0);

				float useCheapEval = subT / lodDistanceThreshold;
				CloudWeather weather = computeCloudWeather(subP, props);
				CloudLayer layer = computeCloudLayer(weather, props);
				vec3 sampleAdvection;
				vec3 d = calculateCloudDensity(subP, weather, layer, props, time, useCheapEval, sampleAdvection);

				if (max(d.x, max(d.y, d.z)) > 0.01) {
					if (firstHitDist < 0.0) {
						firstHitDist = subT;
						firstStepSize = currentStepSize; // Record the actual step size used to hit
					}
					lastHitDist = subT;
				}

				pathDensity = max(pathDensity, max(d.x, max(d.y, d.z)));

				float integrationStep = currentStepSize;
				if (any(greaterThan(d, vec3(0.000))) || any(greaterThan(prevDensity, vec3(0.000)))) {
					vec3 averageDensity = (prevDensity + d) * 0.5;
					vec3 rgbExtinction = uCloudExtinctionColor * uCloudExtinction;
					vec3 stepDensity = averageDensity * integrationStep * rgbExtinction;
					vec3 transmittanceAtStep = exp(-stepDensity);
					prevTransmissionDelta = prevTransmission - transmittanceAtStep;
					prevTransmission = transmittanceAtStep;

					vec3 stepScattering = vec3(0.0);
					vec3 emissiveGlow = vec3(0.0);

					// PASS 1: Global Directional Lights (Sun/Moon)
					for (int j = 0; j < min(2, num_lights); j++) {
						if (lights[j].type != LIGHT_TYPE_DIRECTIONAL) continue;
						if (lights[j].intensity <= 0.0) continue;

						// Standard Cloud Scattering (Shadowed)
						// Skip if doesn't cast shadows OR doesn't have volumetric shadow flag
						if ((lights[j].flags & LIGHT_FLAG_CASTS_SHADOW) == 0 ||
						    (lights[j].flags & LIGHT_FLAG_VOLUMETRIC_SHADOW) == 0) continue;

						vec3 L;
						float attenuation;
						calculateLightContribution(j, subP, L, attenuation);

						if (attenuation * lights[j].intensity < 0.001) continue;

						float cosTheta = dot(rayDir, L);
						float phase = cloudPhase(cosTheta);

						float traceDist = 0.0;
						vec3 lightTransmittance = vec3(1.0);

						float r_world = length(subP - earthCenter);
						float r_km = r_world / (1000.0 * worldScale);
						float mu = dot((subP - earthCenter) / r_world, L);

						float t0_s, t1_s;
						float st_start = 1e10;
						float st_end = -1e10;
						if (intersectSphere(subP, L, R_ceiling, t0_s, t1_s)) {
							st_start = max(0.0, t0_s);
							st_end = t1_s;
							if (intersectSphere(subP, L, R_floor, t0_s, t1_s)) {
								if (t0_s < 0.0) t0_s = t1_s; // handle logic safely
								st_end = min(st_end, t0_s);
							}
						}
						traceDist = min(st_end - st_start, layer.thickness * 1.5);

						vec2 transUV = getTransmittanceUV(r_km, mu);
						lightTransmittance = texture(u_transmittanceLUT, transUV).rgb;

						vec3 opticalDepthToLight = vec3(0.0);
						if (traceDist > 0.01 * worldScale) {
							float shadowStepSize = traceDist / float(shadow_samples);
							for (int ks = 0; ks < shadow_samples; ks++) {
								vec3 sp = subP + L * (float(ks) + jitter) * shadowStepSize;
								vec3 dummyAdvect;
								vec3 currentShadowDensity = calculateCloudDensity(sp, weather, layer, props, time, 100.0, dummyAdvect);

								vec3 stepOD = currentShadowDensity * shadowStepSize * (rgbExtinction * cloudShadowOpticalDepthMultiplier);
								opticalDepthToLight += stepOD;
								if (all(greaterThan(opticalDepthToLight, vec3(3.0)))) {
									break;
								}
							}
						}

						vec3 shadowTerm = mix(
							beerPowder(opticalDepthToLight, stepDensity),
							exp(-opticalDepthToLight),
							cloudBeerPowderMix
						);

						float lightScale = (j == 0 ? cloudSunLightScale : cloudMoonLightScale);

						stepScattering += lightTransmittance * lights[j].color.rgb * shadowTerm * phase *
							lights[j].intensity * attenuation * lightScale;
					}

					// PASS 2: Local Lights (Point/Spot/Emissive/Flash) - CLUSTERED
					// Evaluate global lights loop first (index 3456)
					Cluster global_cloud_cluster = clusters[3456];
					for (uint idx = 0; idx < global_cloud_cluster.count; idx++) {
						int j = int(global_cloud_cluster.lightIndices[idx]);
						if (lights[j].intensity <= 0.0) continue;

						// Cloud Emissive Lighting (Lightning)
						if ((lights[j].flags & LIGHT_FLAG_CLOUD_EMISSIVE) != 0) {
							// Sheet-like segment light: distance to line segment (position -> direction)
							vec3 A = lights[j].position;
							vec3 B = lights[j].direction;
							vec3 AP = subP - A;
							vec3 AB = B - A;
							float h = clamp(dot(AP, AB) / dot(AB, AB), 0.0, 1.0);
							float distToSegment = length(AP - AB * h);

							float emissiveRadius = lights[j].inner_cutoff;
							float falloff = 1.0 / (1.0 + 0.01 * distToSegment + 0.0001 * distToSegment * distToSegment);
							falloff *= smoothstep(emissiveRadius * 1.5, emissiveRadius * 0.5, distToSegment);

							emissiveGlow += lights[j].color.rgb * lights[j].intensity * falloff;
						}

						// Standard Cloud Scattering (Shadowed)
						// Skip if doesn't cast shadows OR doesn't have volumetric shadow flag
						if ((lights[j].flags & LIGHT_FLAG_CASTS_SHADOW) == 0 ||
						    (lights[j].flags & LIGHT_FLAG_VOLUMETRIC_SHADOW) == 0) continue;

						vec3 L;
						float attenuation;
						calculateLightContribution(j, subP, L, attenuation);

						if (attenuation * lights[j].intensity < 0.001) continue;

						float cosTheta = dot(rayDir, L);
						float phase = cloudPhase(cosTheta);

						float traceDist = length(lights[j].position - subP);
						if ((lights[j].flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
							vec3 lp = lights[j].position + viewPos;
							traceDist = length(lp - subP);
						}

						vec3 opticalDepthToLight = vec3(0.0);
						if (traceDist > 0.01 * worldScale) {
							float shadowStepSize = traceDist / float(shadow_samples);
							for (int ks = 0; ks < shadow_samples; ks++) {
								vec3 sp = subP + L * (float(ks) + jitter) * shadowStepSize;
								vec3 dummyAdvect;
								vec3 currentShadowDensity = calculateCloudDensity(sp, weather, layer, props, time, 100.0, dummyAdvect);

								vec3 stepOD = currentShadowDensity * shadowStepSize * (rgbExtinction * cloudShadowOpticalDepthMultiplier);
								opticalDepthToLight += stepOD;
								if (all(greaterThan(opticalDepthToLight, vec3(3.0)))) {
									break;
								}
							}
						}

						vec3 shadowTerm = mix(
							beerPowder(opticalDepthToLight, stepDensity),
							exp(-opticalDepthToLight),
							cloudBeerPowderMix
						);

						stepScattering += lights[j].color.rgb * shadowTerm * phase *
							lights[j].intensity * attenuation;
					}

					uint cloud_cluster_index = getClusterIndex(subP);
					Cluster cloud_cluster = clusters[cloud_cluster_index];

					for (uint idx = 0; idx < cloud_cluster.count; idx++) {
						int j = int(cloud_cluster.lightIndices[idx]);
						if (lights[j].intensity <= 0.0) continue;

						// Cloud Emissive Lighting (Lightning)
						if ((lights[j].flags & LIGHT_FLAG_CLOUD_EMISSIVE) != 0) {
							// Sheet-like segment light: distance to line segment (position -> direction)
							vec3 A = lights[j].position;
							vec3 B = lights[j].direction;
							vec3 AP = subP - A;
							vec3 AB = B - A;
							float h = clamp(dot(AP, AB) / dot(AB, AB), 0.0, 1.0);
							float distToSegment = length(AP - AB * h);

							float emissiveRadius = lights[j].inner_cutoff;
							float falloff = 1.0 / (1.0 + 0.01 * distToSegment + 0.0001 * distToSegment * distToSegment);
							falloff *= smoothstep(emissiveRadius * 1.5, emissiveRadius * 0.5, distToSegment);

							emissiveGlow += lights[j].color.rgb * lights[j].intensity * falloff;
						}

						// Standard Cloud Scattering (Shadowed)
						// Skip if doesn't cast shadows OR doesn't have volumetric shadow flag
						if ((lights[j].flags & LIGHT_FLAG_CASTS_SHADOW) == 0 ||
						    (lights[j].flags & LIGHT_FLAG_VOLUMETRIC_SHADOW) == 0) continue;

						vec3 L;
						float attenuation;
						calculateLightContribution(j, subP, L, attenuation);

						if (attenuation * lights[j].intensity < 0.001) continue;

						float cosTheta = dot(rayDir, L);
						float phase = cloudPhase(cosTheta);

						float traceDist = length(lights[j].position - subP);
						if ((lights[j].flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
							vec3 lp = lights[j].position + viewPos;
							traceDist = length(lp - subP);
						}

						vec3 opticalDepthToLight = vec3(0.0);
						if (traceDist > 0.01 * worldScale) {
							float shadowStepSize = traceDist / float(shadow_samples);
							for (int ks = 0; ks < shadow_samples; ks++) {
								vec3 sp = subP + L * (float(ks) + jitter) * shadowStepSize;
								vec3 dummyAdvect;
								vec3 currentShadowDensity = calculateCloudDensity(sp, weather, layer, props, time, 100.0, dummyAdvect);

								vec3 stepOD = currentShadowDensity * shadowStepSize * (rgbExtinction * cloudShadowOpticalDepthMultiplier);
								opticalDepthToLight += stepOD;
								if (all(greaterThan(opticalDepthToLight, vec3(3.0)))) {
									break;
								}
							}
						}

						vec3 shadowTerm = mix(
							beerPowder(opticalDepthToLight, stepDensity),
							exp(-opticalDepthToLight),
							cloudBeerPowderMix
						);

						stepScattering += lights[j].color.rgb * shadowTerm * phase *
							lights[j].intensity * attenuation;
					}

					// --- Sun/Time of Day Scaling ---
					float sunHeight = max(primaryLightDir.y, 0.0);
					float ambientScale = mix(0.3, 1.0, smoothstep(0.0, 0.3, sunHeight));

					// --- 1. Sample SH Probes (Sky, Horizon, and Ground) ---
					vec3 skySH     = evalSHIrradianceSpatial(subP, vec3(0.0, 1.0, 0.0));
					vec3 horizonSH = evalSHIrradianceSpatial(subP, normalize(vec3(primaryLightDir.x, 0.15, primaryLightDir.z)));
					vec3 groundSH  = evalSHIrradianceSpatial(subP, vec3(0.0, -1.0, 0.0));

					// Base directional blends
					vec3 ambientTop    = mix(skySH, horizonSH, 0.4) * ambientScale;
					vec3 ambientBottom = groundSH * ambientScale; // Ground upwelling

					// --- 2. Approximate Vertical Optical Depth ---
					float ambientExtinction = 0.1; // Tuning var: how fast ambient light dies in the cloud

					// Sky light attenuates as it travels down through the cloud density
					vec3 downwardOD = stepDensity * (1.0 - h_norm) * layer.thickness;
					vec3 skyAttenuation = exp(-downwardOD * ambientExtinction);

					// Ground light attenuates as it travels up through the cloud density
					vec3 upwardOD = stepDensity * h_norm * layer.thickness;
					vec3 groundAttenuation = exp(-upwardOD * ambientExtinction);

					// --- 3. The Powder Effect ---
					float powderScale = 15.0; // Tuning var: intensity of dark inward-facing crevices
					vec3 powder = vec3(1.0) - exp(-stepDensity * powderScale);

					// --- 4. Final Integration ---
					// Apply directional attenuation to their respective sources
					vec3 finalAmbient = (ambientTop * skyAttenuation) + (ambientBottom * groundAttenuation);

					// Modulate ambient by the powder effect, then combine with primary scattering
					vec3 S = stepScattering + (finalAmbient * powder) + emissiveGlow;
					//+ 10*computeNebula(subP/10000.0, 0.01*time);

					vec3 weight = cloudTransmittance * (vec3(1.0) - transmittanceAtStep);
					// Extract scalars for stable temporal weighting
					float scalarAccumOD = dot(accumulatedOpticalDepth, vec3(0.3333));
					float bias = exp(-scalarAccumOD * 15.0);
					float scalarWeight = dot(weight, vec3(0.3333));
					float stepWeight = scalarWeight * bias;
					weightedDistSum += subT * stepWeight;
					weightedAdvectionSum += sampleAdvection * stepWeight;
					// Accumulate RGB energy
					lightEnergy += S * weight;
					totalWeight += stepWeight;

					cloudTransmittance *= transmittanceAtStep;
					accumulatedOpticalDepth += stepDensity;
				}
				prevDensity = d;

				// --- Calculate Next Step Size ---
				float stepScaleMultiplier = 1.0;

				// // 1. Transmittance backoff: Take larger steps through dense cores where we can't see much anyway
				// float scalarTransmittance = dot(cloudTransmittance, vec3(0.3333));
				// stepScaleMultiplier *= mix(4.0, 1.0, scalarTransmittance);

				// // 2. History bounds: You calculate expectedStart/expectedEnd and maxEmptyMult in the history block.
				// // Use them here to rush through areas that were empty last frame.
				// if (uHasHistory && (subT < expectedStart || subT > expectedEnd)) {
				// 	stepScaleMultiplier *= maxEmptyMult;
				// }

				// // 3. SDF Proximity: Larger steps deeper inside the cloud volume (where SDF is increasingly negative)
				// // Assuming weather.sdf returns a distance field where interior is negative
				// float coreDepthRatio = 1.0 - smoothstep(-300.0 * props.worldScale, 0.0, weather.sdf);
				// stepScaleMultiplier *= mix(1.0, 2.0, coreDepthRatio);

				// currentStepSize = baseTargetStepSize * stepScaleMultiplier;
				subT += currentStepSize;
			}

			t = t_exit;
			prevDensity = vec3(0.0);
		}
		cloudColor = lightEnergy * cloudColorUniform;
	}

	vec4 finalColor = vec4(cloudColor, dot(cloudTransmittance, vec3(0.3333)));
	vec4 finalDepth;
	vec2 finalVelocity;

	if (totalWeight > 0.001) {
		float stableHitDist = weightedDistSum / totalWeight;
		vec3 avgAdvection = weightedAdvectionSum / totalWeight;

		finalDepth = vec4(firstHitDist, lastHitDist, firstStepSize, pathDensity);

		// Reproject using the accumulated per-sample advection directly
		vec3 stableHitPos = viewPos + canonicalRayDir * stableHitDist;
		vec3 advectionDelta = avgAdvection * uDeltaTime;

		vec3 prevHitPos = stableHitPos - advectionDelta;
		vec4 prevClipHit = uPrevViewProjection * vec4(prevHitPos, 1.0);
		vec2 prevScreenUV = (prevClipHit.xy / prevClipHit.w) * 0.5 + 0.5;

		finalVelocity = prevScreenUV - TexCoords;
		// finalVelocity = vec2(minStepSize/10, 0);
	} else {
		finalDepth = vec4(uCloudMaxRayDistance * 0.5 * worldScale, uCloudMaxRayDistance * 0.5 * worldScale, firstStepSize, pathDensity);
		vec3 advectionOffset = getCloudAdvectionSpeed(0.0, time);
		vec3 advectionDelta = advectionOffset * uDeltaTime;

		vec3 currentPos = viewPos + canonicalRayDir * 5000.0 * worldScale;
		vec3 prevPos = currentPos - advectionDelta;
		vec4 prevClip = uPrevViewProjection * vec4(prevPos, 1.0);
		vec2 prevScreen = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
		finalVelocity = prevScreen - TexCoords;
	}

	imageStore(outPackedColor, packedPixel, finalColor);
	// imageStore(outPackedColor, packedPixel, vec4(abs(finalVelocity), 0,0));
	imageStore(outPackedDepth, packedPixel, finalDepth);
	imageStore(outPackedVelocity, packedPixel, vec4(finalVelocity, 0.0, 0.0));
}
