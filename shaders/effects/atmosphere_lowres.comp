#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D outPackedColor;
layout(binding = 1, rgba32f) uniform image2D outPackedDepth;
layout(binding = 2, rg16f)   uniform image2D outPackedVelocity;

uniform sampler2D depthTexture;

uniform float uDeltaTime;

uniform vec3  cloudColorUniform;
#define ATMOSPHERE_HEIGHT_DEFINED
uniform float u_atmosphereHeight;

uniform sampler2D uHistoryDepth;
uniform sampler2D uHistoryMoments;
uniform mat4  uPrevViewProjection;
uniform bool  uHasHistory;

uniform sampler2D u_skyViewLUT;
uniform sampler2D u_multiScatteringLUT;

uniform float uCloudMaxRayDistance;
uniform int   uCloudMinSamples;
uniform int   uCloudMaxSamples;
uniform float uCloudExtinction;

uniform float uVolumetricIntensity;
uniform float uVolumetricAnisotropy;
uniform float uVolumetricHazeExposure;

#define USE_TERRAIN_DATA
#include "../atmosphere/common.glsl"
#include "../helpers/clouds.glsl"
#include "../helpers/fast_noise.glsl"
#include "../helpers/lighting.glsl"
#include "../helpers/terrain_shadows.glsl"
#include "../types/temporal_data.glsl"
#include "helpers/math.glsl"
#include "lygia/generative/wavelet.glsl"
#include "lygia/generative/voronoi.glsl"
#include "lygia/generative/random.glsl"

float R_earth = kEarthRadius * 1000.0 * worldScale;

void main() {
	ivec2 packedPixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 packedSize = imageSize(outPackedColor);
	if (packedPixel.x >= packedSize.x || packedPixel.y >= packedSize.y)
		return;

	// 2x2 Bayer pattern for interleaving
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 offset = bayer_offsets[frameIndex % 4];
	ivec2 fullResPixel = packedPixel * 2 + offset;
	ivec2 fullResSize = packedSize * 2;

	vec2 TexCoords = (vec2(fullResPixel) + 0.5) / vec2(fullResSize);

	float depth = texture(depthTexture, TexCoords).r;
	float z = depth * 2.0 - 1.0;
	vec4  clipSpacePosition = vec4(TexCoords * 2.0 - 1.0, z, 1.0);
	vec4  viewSpacePosition = invProjection * clipSpacePosition;
	viewSpacePosition /= viewSpacePosition.w;
	vec3 worldPos = (invView * viewSpacePosition).xyz;
	vec3 canonicalRayDir = normalize(worldPos - viewPos);
	float dist = length(worldPos - viewPos);

	if (depth == 1.0) {
		dist = uCloudMaxRayDistance * worldScale;
		worldPos = viewPos + canonicalRayDir * dist;
	}

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	float R_floor = R_earth + (cloudAltitude - 500.0) * worldScale;
	float R_ceiling = R_earth + (cloudAltitude + cloudThickness * 10.0 + 5000.0) * worldScale;

	vec3 earthCenter = vec3(viewPos.x, -R_earth, viewPos.z);
	vec3 relRo = viewPos - earthCenter;

	float t_cloud_start = 1e10;
	float t_cloud_end = -1e10;

	float tc0, tc1;
	if (intersectSphere(relRo, canonicalRayDir, R_ceiling, tc0, tc1)) {
		t_cloud_start = max(0.0, tc0);
		t_cloud_end = min(tc1, dist);

		if (intersectSphere(relRo, canonicalRayDir, R_floor, tc0, tc1)) {
			if (tc0 < 0.0) {
				t_cloud_start = max(t_cloud_start, tc1);
			} else {
				t_cloud_end = min(t_cloud_end, tc0);
			}
		}
	}

	// Jittering
	float jitter = InterleavedGradientNoise(fullResPixel, frameIndex);

	vec3  accumulatedColor = vec3(0.0);
	float accumulatedTransmittance = 1.0;

	float firstHitDist = -1.0;
	float lastHitDist = -1.0;
	float pathDensity = 0.0;
	float totalWeight = 0.0;
	float weightedDistSum = 0.0;
	vec3  weightedAdvectionSum = vec3(0.0);

	vec3 primaryLightDir = vec3(0, 1, 0);
	for (int j = 0; j < num_lights; j++) {
		if (lights[j].type == LIGHT_TYPE_DIRECTIONAL) {
			primaryLightDir = normalize(-lights[j].direction);
			break;
		}
	}

	// --- STAGE 1: Near-field Fog/God Rays (0 - 1000m) ---
	float t_fog_end = min(dist, 1000.0);
	int fogSteps = 32;
	float fogStepSize = t_fog_end / float(fogSteps);

	for (int i = 0; i < fogSteps; i++) {
		float t = (float(i) + jitter) * fogStepSize;
		if (t >= dist) break;

		vec3 p = viewPos + canonicalRayDir * t;
		Sampling s = getAtmospherePropertiesAtPos(p);
		float atmosExtinction = (s.rayleigh.r + s.rayleigh.g + s.rayleigh.b + s.mie.r + s.mie.g + s.mie.b) / 3.0 * 0.001;
		float stepExtinction = atmosExtinction * uVolumetricHazeExposure;
		float stepTransmittance = exp(-stepExtinction * fogStepSize);

		if (stepExtinction > 0.00001) {
			vec3 scattering = vec3(0.0);
			for (int j = 0; j < min(2, num_lights); j++) {
				if (lights[j].type != LIGHT_TYPE_DIRECTIONAL || lights[j].intensity <= 0.0) continue;
				vec3 L = normalize(-lights[j].direction);
				float cosTheta = dot(canonicalRayDir, L);
				float rPhase = rayleighPhase(cosTheta);
				float mPhase = henyeyGreenstein(uVolumetricAnisotropy, cosTheta);
				vec3 atmosScat = (s.rayleigh * rPhase + s.mie * mPhase) * 0.001;

				float shadow = min(terrainShadowVolumetric(p, L), calculateShadow(j, p, vec3(0, 1, 0), L));
				shadow *= calculateCloudShadow(j, p);

				float r_km = kEarthRadius + p.y / (1000.0 * max(0.0001, worldScale));
				vec3 lightTransmittance = texture(u_transmittanceLUT, getTransmittanceUV(r_km, L.y)).rgb;
				scattering += lights[j].color * lights[j].intensity * lightTransmittance * shadow * atmosScat;
			}
			// Local Lights (Point/Spot)
			for (int j = 2; j < num_lights; j++) {
				vec3 L; float atten;
				calculateLightContribution(j, p, L, atten);
				if (atten <= 0.0) continue;
				float cosTheta = dot(canonicalRayDir, L);
				float mPhase = henyeyGreenstein(uVolumetricAnisotropy, cosTheta);
				float shadow = calculateShadow(j, p, vec3(0, 1, 0), L);
				scattering += lights[j].color * lights[j].intensity * atten * shadow * mPhase * s.mie * 0.001;
			}

			vec3 stepScattering = scattering * (1.0 - stepTransmittance) / max(stepExtinction, 0.00001);
			accumulatedColor += stepScattering * accumulatedTransmittance * uVolumetricIntensity;
		}
		accumulatedTransmittance *= stepTransmittance;
	}

	// --- STAGE 2: Intermediate Atmosphere and Clouds ---
	float t = t_fog_end;
	float rayXZLen = max(length(canonicalRayDir.xz), 1e-4);
	int iterations = 0;

	while (t < dist && iterations < 300 && accumulatedTransmittance > 0.01) {
		iterations++;
		vec3 p = viewPos + canonicalRayDir * t;
		CloudWeather weather = computeCloudWeather(p, props);

		// 2a. Optimized skipping/stepping for intermediate atmosphere
		if (weather.sdf >= 0.0 && (t < t_cloud_start || t > t_cloud_end)) {
			float next_event = min(dist, t_cloud_start > t ? t_cloud_start : dist);
			float atmosDist = min(next_event - t, 2000.0 * worldScale);

			Sampling s = getAtmospherePropertiesAtPos(p);
			float stepExtinction = (s.rayleigh.r + s.rayleigh.g + s.rayleigh.b + s.mie.r + s.mie.g + s.mie.b) / 3.0 * 0.001 * uVolumetricHazeExposure;
			float stepTransmittance = exp(-stepExtinction * atmosDist);

			if (stepExtinction > 0.00001) {
				vec3 scattering = vec3(0.0);
				for (int j = 0; j < min(2, num_lights); j++) {
					if (lights[j].type != LIGHT_TYPE_DIRECTIONAL || lights[j].intensity <= 0.0) continue;
					vec3 L = normalize(-lights[j].direction);
					float shadow = calculateCloudShadow(j, p) * terrainShadowVolumetric(p, L);
					float r_km = kEarthRadius + p.y / (1000.0 * max(0.0001, worldScale));
					vec3 lightTransmittance = texture(u_transmittanceLUT, getTransmittanceUV(r_km, L.y)).rgb;
					scattering += lights[j].color * lights[j].intensity * lightTransmittance * shadow * (s.rayleigh + s.mie) * 0.001;
				}
				accumulatedColor += scattering * (1.0 - stepTransmittance) / max(stepExtinction, 0.00001) * accumulatedTransmittance * uVolumetricIntensity;
			}
			accumulatedTransmittance *= stepTransmittance;
			t += atmosDist;
			continue;
		}

		// 2b. SDF-based jumping outside cloud footprints
		if (weather.sdf >= 0.0) {
			float jump = clamp(weather.sdf / rayXZLen, 5.0 * worldScale, 500.0 * worldScale);
			// Still account for atmosphere during jump
			Sampling s = getAtmospherePropertiesAtPos(p);
			float stepExtinction = (s.rayleigh.r + s.rayleigh.g + s.rayleigh.b + s.mie.r + s.mie.g + s.mie.b) / 3.0 * 0.001 * uVolumetricHazeExposure;
			accumulatedTransmittance *= exp(-stepExtinction * jump);
			t += jump;
			continue;
		}

		// 2c. Inner Cloud Volume March
		CloudLayer layer = computeCloudLayer(weather, props);
		float cloudVolumeT = min(dist, t + 250.0 * worldScale) - t;
		int innerSteps = 4;
		float innerStepSize = cloudVolumeT / float(innerSteps);

		for (int k = 0; k < innerSteps; k++) {
			float subT = t + (float(k) + jitter) * innerStepSize;
			if (subT >= dist) break;

			vec3 subP = viewPos + canonicalRayDir * subT;
			vec4 densityResult = calculateCloudDensity(subP, weather, layer, props, time, subT > 25000.0 * worldScale);
			float d = densityResult.x;

			Sampling s = getAtmospherePropertiesAtPos(subP);
			float atmosExt = (s.rayleigh.r + s.rayleigh.g + s.rayleigh.b + s.mie.r + s.mie.g + s.mie.b) / 3.0 * 0.001 * uVolumetricHazeExposure;
			float cloudExt = d * uCloudExtinction;
			float stepExt = atmosExt + cloudExt;
			float stepTrans = exp(-stepExt * innerStepSize);

			if (stepExt > 0.00001) {
				vec3 S_atmos = vec3(0.0);
				vec3 S_cloud = vec3(0.0);

				// Directional Lights
				for (int j = 0; j < min(2, num_lights); j++) {
					if (lights[j].type != LIGHT_TYPE_DIRECTIONAL || lights[j].intensity <= 0.0) continue;
					vec3 L = normalize(-lights[j].direction);
					float shadow = calculateCloudShadow(j, subP) * terrainShadowVolumetric(subP, L);
					float r_km = kEarthRadius + subP.y / (1000.0 * max(0.0001, worldScale));
					vec3 lightTransmittance = texture(u_transmittanceLUT, getTransmittanceUV(r_km, L.y)).rgb;

					// Atmos contribution
					S_atmos += lights[j].color * lights[j].intensity * lightTransmittance * shadow * (s.rayleigh + s.mie) * 0.001;

					// Cloud contribution
					if (d > 0.01) {
						S_cloud += lights[j].color * lights[j].intensity * lightTransmittance * shadow * cloudPhase(dot(canonicalRayDir, L)) * cloudColorUniform * (j == 0 ? cloudSunLightScale : cloudMoonLightScale);
					}
				}

				vec3 scattering = S_atmos * uVolumetricIntensity + S_cloud * d;
				accumulatedColor += scattering * (1.0 - stepTrans) / max(stepExt, 0.00001) * accumulatedTransmittance;
			}

			if (d > 0.01) {
				if (firstHitDist < 0.0) firstHitDist = subT;
				lastHitDist = subT;
				pathDensity = max(pathDensity, d);

				float weight = accumulatedTransmittance * (1.0 - stepTrans);
				float stepWeight = weight * exp(-totalWeight * 2.0);
				weightedDistSum += subT * stepWeight;
				weightedAdvectionSum += densityResult.yzw * stepWeight;
				totalWeight += stepWeight;
			}

			accumulatedTransmittance *= stepTrans;
		}
		t += cloudVolumeT;
	}

	vec4 finalColor = vec4(accumulatedColor, accumulatedTransmittance);
	vec4 finalDepth;
	vec2 finalVelocity;

	if (totalWeight > 0.001) {
		float stableHitDist = weightedDistSum / totalWeight;
		finalDepth = vec4(firstHitDist, lastHitDist, 50.0, pathDensity);
		vec3 stableHitPos = viewPos + canonicalRayDir * stableHitDist;
		vec3 prevHitPos = stableHitPos - (weightedAdvectionSum / totalWeight) * uDeltaTime;
		vec4 prevClipHit = uPrevViewProjection * vec4(prevHitPos, 1.0);
		finalVelocity = (prevClipHit.xy / prevClipHit.w) * 0.5 + 0.5 - TexCoords;
	} else {
		finalDepth = vec4(dist, dist, 50.0, pathDensity);
		vec4 prevClip = uPrevViewProjection * vec4(viewPos + canonicalRayDir * dist, 1.0);
		finalVelocity = (prevClip.xy / prevClip.w) * 0.5 + 0.5 - TexCoords;
	}

	imageStore(outPackedColor, packedPixel, finalColor);
	imageStore(outPackedDepth, packedPixel, finalDepth);
	imageStore(outPackedVelocity, packedPixel, vec4(finalVelocity, 0.0, 0.0));
}
