float R_earth = kEarthRadius * 1000.0 * worldScale;

/**
 * Calculates the bifurcated step size for a volumetric ray sampling system.
 *
 * @param in_cloud         State flag: true if currently evaluating high-resolution density.
 * @param zero_count       State counter: tracks consecutive steps with zero density.
 * @param macro_density    Low-resolution density query (e.g., from a weather map or coarse SDF).
 * @param B                Minimum baseline step size (the "expensive" step).
 * @param cheap_mult       Multiplier for the base step size in empty space (e.g., 2.0 to 4.0).
 * @param escape_threshold Number of zero-density steps required to exit the cloud state.
 * @return                 The calculated step size for the current iteration.
 */
float calculateBifurcatedStepSize(
    inout bool in_cloud,
    inout int zero_count,
    float macro_density,
    float B,
    float cheap_mult,
    int escape_threshold
) {
    float cheap_step = B * cheap_mult;

    if (!in_cloud) {
        // --- STATE: EMPTY SPACE ---
        if (macro_density > 0.01) {
            // Cloud boundary detected.
            // Toggle state and step backward by the cheap step to ensure
            // we don't overshoot the high-frequency boundary details.
            in_cloud = true;
            zero_count = 0;
            return -cheap_step;
        }
        // Remain in empty space
        return cheap_step;

    } else {
        // --- STATE: INSIDE CLOUD ---
        if (macro_density <= 0.0) {
            // Potential exit detected. Increment the verification counter.
            zero_count++;
            if (zero_count >= escape_threshold) {
                // Threshold met. Officially escaped the cloud volume.
                in_cloud = false;
                return cheap_step;
            }
        } else {
            // Still firmly inside the cloud. Reset the escape counter.
            zero_count = 0;
        }

        // Remain in dense space evaluation
        return B;
    }
}

float schlickPhase(float cosTheta, float k) {
    float kCos = k * cosTheta;
    float denom = 1.0 - kCos;
    // 0.079577 is 1 / (4 * PI)
    return 0.079577 * (1.0 - k * k) / (denom * denom);
}

float dualLobeSchlick(float cosTheta, float kFwd, float kBck, float weight) {
    return mix(schlickPhase(cosTheta, -kBck), schlickPhase(cosTheta, kFwd), weight);
}

void CalculateStochasticClusterLight(
	vec3 p,
	vec3 rayDir,
	float jitter,
	CloudWeather    weather,
	CloudProperties props,
	vec3 rgbExtinction,
	vec3 stepOpticalDepth,
	Cluster light_cluster,
	float currentLOD,
	inout vec3 stepScattering,
	inout vec3 emissiveGlow
) {
	for (uint idx = 0; idx < light_cluster.count; idx++) {
		int j = int(light_cluster.lightIndices[idx]);
		if (lights[j].intensity <= 0.0) continue;

		if ((lights[j].flags & LIGHT_FLAG_CLOUD_EMISSIVE) != 0) {
			vec3 A = lights[j].position;
			vec3 B = lights[j].direction;
			vec3 AP = p - A;
			vec3 AB = B - A;
			float h = clamp(dot(AP, AB) / dot(AB, AB), 0.0, 1.0);
			float distToSegment = length(AP - AB * h);

			float emissiveRadius = lights[j].inner_cutoff;
			float falloff = 1.0 / (1.0 + 0.01 * distToSegment + 0.0001 * distToSegment * distToSegment);
			falloff *= smoothstep(emissiveRadius * 1.5, emissiveRadius * 0.5, distToSegment);

			float ridgeGlow = mix(1.0, 1.0 - weather.ridge, 0.5);
			emissiveGlow += lights[j].color.rgb * lights[j].intensity * falloff * ridgeGlow;
		}

		if ((lights[j].flags & LIGHT_FLAG_CASTS_SHADOW) == 0 ||
			(lights[j].flags & LIGHT_FLAG_VOLUMETRIC_SHADOW) == 0) continue;

		vec3 L;
		float attenuation;
		calculateLightContribution(j, p, L, attenuation);

		if (attenuation * lights[j].intensity < 0.001) continue;

		float cosTheta = dot(rayDir, L);
		float phase = cloudPhase(cosTheta);

		float traceDist = length(lights[j].position - p);
		if ((lights[j].flags & LIGHT_FLAG_CAMERA_RELATIVE) != 0) {
			vec3 lp = lights[j].position + viewPos;
			traceDist = length(lp - p);
		}

		vec3 opticalDepthToLight = vec3(0.0);
		if (traceDist > 0.01 * worldScale) {
			int shadow_steps = 5;
			// Start with a small step to catch the crisp local self-shadowing
			float shadow_step_size = 100.0 * worldScale;
			// Double the distance each step to quickly escape the atmosphere
			float step_multiplier = 2.0;

			// Dither the start position to hide the banding
			float current_t = shadow_step_size * (0.5 + 0.5 * jitter);

			for (int k = 0; k < shadow_steps; ++k) {
				if (current_t > traceDist) break;

				vec3 sp_c = p + L * current_t;

				CloudWeather shadow_weather_c = computeCloudWeather(sp_c, props, currentLOD);

				// Use the minimal evaluation to keep the inner loop fast
				CloudDensityResult shadowRes_c = calculateCloudDensity(sp_c, shadow_weather_c, props, time, 0.0, true);

				// Accumulate the optical depth linearly
				opticalDepthToLight += shadowRes_c.density * shadow_step_size * (rgbExtinction * cloudShadowOpticalDepthMultiplier);

				// Accumulate emissive glow, attenuated by the shadow we've marched through so far
				emissiveGlow += shadowRes_c.emissivity * exp(-opticalDepthToLight);

				// Grow the ray forward
				current_t += shadow_step_size;
				shadow_step_size *= step_multiplier;
			}
		}

		vec3 shadowTerm = mix(
			beerPowder(opticalDepthToLight, stepOpticalDepth),
			exp(-opticalDepthToLight),
			cloudBeerPowderMix
		);

		stepScattering += lights[j].color.rgb * shadowTerm * phase *
			lights[j].intensity * attenuation;
	}
}

vec3 EvaluateStepLighting(
	vec3 p,
	vec3 rayDir,
	float jitter,
	CloudWeather weather,
	CloudProperties props,
	vec3 rgbExtinction,
	vec3 stepDensity,
	vec3 stepOpticalDepth,
	float h_norm,
	vec3 sampleAdvection,
	float sampleAo,
	vec3 sampleAlbedo,
	inout vec3 emissiveGlow,
	vec3 skySH,
	vec3 horizonSH,
	vec3 groundSH,
	vec3 primaryLightDir,
	float R_ceiling,
	float R_floor,
	vec3 earthCenter,
	float currentLOD
) {
	vec3 stepScattering = vec3(0.0);

	// Fast ambient occlusion approximation using the distance to the cloud edge
	float edgeDistance = getDistanceToCloudEdge(weather.coverage, h_norm, weather.heightMap, weather.thickness);
	// Convert distance to transmittance/visibility using the step density as the local extinction.
	// We apply a soft multiplier (0.05) to align the occlusion intensity with the visual range.
	vec3 localAmbientVisibility = exp(-edgeDistance * stepDensity * 0.05);


	// PASS 1: Global Directional Lights (Sun/Moon)
	for (int j = 0; j < min(2, num_lights); j++) {
		if (lights[j].type != LIGHT_TYPE_DIRECTIONAL) continue;
		if (lights[j].intensity <= 0.0) continue;

		if ((lights[j].flags & LIGHT_FLAG_CASTS_SHADOW) == 0 ||
			(lights[j].flags & LIGHT_FLAG_VOLUMETRIC_SHADOW) == 0) continue;

		vec3 L;
		float attenuation;
		calculateLightContribution(j, p, L, attenuation);

		if (attenuation * lights[j].intensity < 0.001) continue;

		float traceDist = 0.0;
		vec3 lightTransmittance = vec3(1.0);

		float r_world = length(p - earthCenter);
		float r_km = r_world / (1000.0 * worldScale);
		float mu = dot((p - earthCenter) / r_world, L);

		float st_start = 1e10;
		float st_end = -1e10;
		intersectCloudShell(p, L, worldScale, st_start, st_end);
		traceDist = min(st_end - st_start, props.thickness * 1.5 * worldScale);

		vec2 transUV = getTransmittanceUV(r_km, mu);
		lightTransmittance = texture(u_transmittanceLUT, transUV).rgb;

		vec3 opticalDepthToLight = vec3(0.0);
		if (u_useCloudShadowMap && j == 0) {
			vec4 lightSpacePos = u_cloudShadowMatrix * vec4(p, 1.0);
			vec2 shadowUV = lightSpacePos.xy * 0.5 + 0.5;
			float accumulatedDensity = sampleDeepOpacityMap(shadowUV, h_norm, 0.0);
			opticalDepthToLight = accumulatedDensity * (rgbExtinction * cloudShadowOpticalDepthMultiplier);
		}
		else if (traceDist > 0.01 * worldScale) {
			float current_t = 20.0 + (100.0 * jitter); // Start just outside the current position
			float current_dt = 100.0;                  // The physical size of the integration chunk
			for (int i = 0; i < 5; i++) {
				if (current_t > traceDist) break;
				vec3 sp_c = p + L * current_t;
				CloudWeather shadow_weather_c = computeCloudWeather(sp_c, props, currentLOD);
				CloudDensityResult shadowRes_c = calculateCloudDensity(sp_c, shadow_weather_c, props, time, 0.0, true);
				opticalDepthToLight += max(vec3(0.00), shadowRes_c.density) * current_dt * (rgbExtinction * cloudShadowOpticalDepthMultiplier);
				emissiveGlow += shadowRes_c.emissivity * exp(-opticalDepthToLight);
				// localAmbientVisibility += exp(-(stepLength * (1.0-pow(3*pow(L.y, 2)-1.0, 2)/4)));
				current_t += current_dt; // Move the ray forward
				current_dt *= 2.0;
			}
		}

		float cosTheta = dot(rayDir, L);
		// float phase = cloudPhase(cosTheta);

		// vec3 shadowTerm = mix(
		// 	beerPowder(opticalDepthToLight, stepOpticalDepth),
		// 	exp(-opticalDepthToLight),
		// 	cloudBeerPowderMix
		// );

		// Setup multi-scattering constants
		const int OCTAVES = 3;
		const float extinctionMult = 0.5; // Halve the optical depth each octave
		const float phaseWidenMult = 0.5; // Broaden the lobe each octave
		const float energyAttenuation = 0.5; // Reduce energy contribution each octave
		const float msCatChaos = 0.5;

		// Base parameters for the dual lobe
		float kFwd = cloudPhaseG1;
		float kBck = cloudPhaseG2;
		float phaseWeight = cloudPhaseAlpha;

		vec3 msScattering = vec3(0.0);
		float currentExtinction = 1.0;
		float currentKfwd = kFwd;
		float currentKbck = kBck;
		float currentEnergy = 1.0;
		float currentScatChaos = (1.0 - cloudPhaseIsotropic);

		for(int oct = 0; oct < OCTAVES; oct++) {
			// 1. Widen the phase function for this octave
			float phase = dualLobeSchlick(cosTheta, currentKfwd, currentKbck, phaseWeight);
			phase = mix((1.0 / (4.0 * PI)), phase, currentScatChaos);


			// 2. Reduce the optical depth to let light penetrate deeper
			vec3 octaveOpticalDepth = opticalDepthToLight * currentExtinction;
			vec3 octaveStepDensity = stepDensity * currentExtinction;

			// 3. Calculate shadow term for this octave (retaining your Beer-Powder mix logic)
			vec3 shadowTerm = mix(
				beerPowder(octaveOpticalDepth, octaveStepDensity),
				exp(-octaveOpticalDepth),
				cloudBeerPowderMix
			);

			// 4. Accumulate
			msScattering += shadowTerm * phase * currentEnergy;

			// 5. Shift parameters for the next octave
			currentExtinction *= extinctionMult;
			currentKfwd *= phaseWidenMult;
			currentKbck *= phaseWidenMult;
			currentEnergy *= energyAttenuation;
			currentScatChaos *= msCatChaos;
		}

		// Apply the accumulated multi-scattering to the final step scattering calculation
		float lightScale = (j == 0 ? cloudSunLightScale : cloudMoonLightScale);
		stepScattering += lightTransmittance * lights[j].color.rgb * msScattering *
			lights[j].intensity * attenuation * lightScale;


		// float lightScale = (j == 0 ? cloudSunLightScale : cloudMoonLightScale);

		// stepScattering += lightTransmittance * lights[j].color.rgb * shadowTerm * phase *
		// 	lights[j].intensity * attenuation * lightScale;
	}


	uint cloud_cluster_index = getClusterIndex(p);
	Cluster cloud_cluster = clusters[cloud_cluster_index];
	Cluster global_cloud_cluster = clusters[3456];

	CalculateStochasticClusterLight(
		p,
		rayDir,
		jitter,
		weather,
		props,
		rgbExtinction,
		stepOpticalDepth,
		global_cloud_cluster,
		currentLOD,
		stepScattering,
		emissiveGlow
	);

	CalculateStochasticClusterLight(
		p,
		rayDir,
		jitter,
		weather,
		props,
		rgbExtinction,
		stepOpticalDepth,
		cloud_cluster,
		currentLOD,
		stepScattering,
		emissiveGlow
	);


	const float ambientExtinction = 1.0;
	const float powderScale = 300.0;
	// vec3 powder = vec3(1.0) - 1.0/(1.0+(stepDensity * powderScale));
	vec3 powder = vec3(1.0) - 1.0/(1.0+(25*(stepDensity-0.00) * powderScale));
	float sunHeight = max(primaryLightDir.y, 0.0);
	float ambientScale = mix(0.3, 1.0, smoothstep(0.0, 0.3, sunHeight));

	vec3 ambientTop    = mix(skySH, horizonSH, 0.4) * ambientScale;
	vec3 ambientBottom = groundSH * ambientScale;

	vec3 upwardOD = stepDensity * h_norm * weather.thickness;
	vec3 downwardOD = stepDensity * (1.0 - h_norm) * weather.thickness;
	// vec3 groundAttenuation = exp(-upwardOD * ambientExtinction);
	// vec3 skyAttenuation = exp(-downwardOD * ambientExtinction);
	vec3 groundAttenuation = 1.0 / (1.0 + upwardOD);
	vec3 skyAttenuation = 1.0 / (1.0 + downwardOD);

	vec3 finalAmbient = ((ambientTop * skyAttenuation) + (ambientBottom * groundAttenuation)) * localAmbientVisibility;

	if (lightningPulse > 0.001) {
		float wavePos = clamp(1.0 - lightningPulse, 0.0, 1.0);

		// Vertical middle centering (peak around h = 0.5)
		float midHeightEnvelope = exp(-pow((h_norm - 0.5) * 4.0, 2.0));

		// Temporal & spatial staggering over time
		float temporalPhase = fract(time * 0.7 + weather.ridge * 3.0);
		float stagger = sin(temporalPhase * 6.28318) * 0.5 + 0.5;

		float ridgeDist = abs(weather.ridge - wavePos * 0.85);
		float waveFront = exp(-ridgeDist * ridgeDist * 16.0);
		float coreGlow = exp(-weather.ridge * 4.0 / max(0.1, lightningPulse));
		float propagationGlow = (coreGlow * 0.7 + waveFront * 1.3) * lightningPulse * midHeightEnvelope * (stagger);

		emissiveGlow += lightningColor * propagationGlow * 12.0;
	}

	vec3 S = (stepScattering + (finalAmbient * powder)) * (uCloudAlbedo * sampleAlbedo) + emissiveGlow;

	return S;
}

void main() {
	ivec2 packedPixel = ivec2(gl_GlobalInvocationID.xy);
	ivec2 packedSize = imageSize(outPackedColor);
	if (packedPixel.x >= packedSize.x || packedPixel.y >= packedSize.y)
		return;

	// 2x2 Bayer pattern for interleaving
	ivec2 bayer_offsets[4] = ivec2[](
		ivec2(0, 0),
		ivec2(1, 1),
		ivec2(1, 0),
		ivec2(0, 1)
	);
	ivec2 offset = bayer_offsets[frameIndex % 4];
	ivec2 fullResPixel = packedPixel * 2 + offset;
	ivec2 fullResSize = packedSize * 2;

	vec2 TexCoords = (vec2(fullResPixel) + 0.5) / vec2(fullResSize);

	float depth = texture(depthTexture, TexCoords).r;
	float z = depth * 2.0 - 1.0;
	vec4  clipSpacePosition = vec4(TexCoords * 2.0 - 1.0, z, 1.0);
	vec4  viewSpacePosition = invProjection * clipSpacePosition;
	viewSpacePosition /= viewSpacePosition.w;
	vec3 worldPos = (invView * viewSpacePosition).xyz;
	vec3 canonicalRayDir = normalize(worldPos - viewPos);
	float dist = length(worldPos - viewPos);

	vec3 rayDir = canonicalRayDir;

	if (depth > 0.9999) {
		dist = uCloudMaxRayDistance * worldScale;
		worldPos = viewPos + rayDir * dist;
	}

	CloudProperties props;
	props.altitude = cloudAltitude;
	props.thickness = cloudThickness;
	props.densityBase = cloudDensity;
	props.coverage = cloudCoverage;
	props.worldScale = worldScale;

	float R_floor = R_earth + (cloudAltitude - 500.0) * worldScale;
	float R_ceiling = R_earth + (cloudAltitude + 2.0 * cloudThickness + 500.0) * worldScale;

	vec3 earthCenter = vec3(viewPos.x, -R_earth, viewPos.z);
	vec3 relRo = viewPos - earthCenter;

	float t_start = 1e10;
	float t_end = -1e10;
	intersectCloudShell(viewPos, rayDir, worldScale, t_start, t_end);

	t_end = min(t_end, dist);

	int samples = uCloudMaxSamples;

	float jitter = InterleavedGradientNoise(fullResPixel, frameIndex);

	vec3  cloudColor = vec3(0.0);
	vec3 cloudTransmittance = vec3(1.0);
	float totalWeight = 0.0;
	float weightedDistSum = 0.0;
	vec3  weightedAdvectionSum = vec3(0.0);
	vec3 accumulatedOpticalDepth = vec3(0.0);
	float firstHitDist = -1.0;
	float lastHitDist = -1.0;
	float pathDensity = 0.0;

	float rayDist = t_end - t_start;
	float precisionLimit = max(1.0, t_end * 1e-5);
	float baseStepSize = clamp(rayDist / float(samples), precisionLimit, 25.0);

	ivec2 boundingSize = textureSize(u_cloudMinMaxBoundingTexture, 0);
	float b_firstHit = -1.0;
	float b_lastHit = -1.0;
	float b_totalDensity = 0.0;

	for (int y = -1; y <= 1; y++) {
		for (int x = -1; x <= 1; x++) {
			ivec2 samplePixel = clamp(packedPixel + ivec2(x, y), ivec2(0), boundingSize - 1);
			vec4 b = texelFetch(u_cloudMinMaxBoundingTexture, samplePixel, 0);

			if (b.r >= 0.0) {
				if (b_firstHit < 0.0) {
					b_firstHit = b.r;
				} else {
					b_firstHit = min(b_firstHit, b.r);
				}
				b_lastHit = max(b_lastHit, b.g);
			}
			b_totalDensity = max(b_totalDensity, b.b);
		}
	}

	if (b_firstHit < 0.0 || b_totalDensity < 0.01) {
		// Output clear sky / no clouds and early return
		imageStore(outPackedColor, packedPixel, vec4(0.0, 0.0, 0.0, 1.0));
		imageStore(outPackedDepth, packedPixel, vec4(uCloudMaxRayDistance * 0.5 * worldScale, uCloudMaxRayDistance * 0.5 * worldScale, baseStepSize, 0.0));

		vec3 advectionOffset = getCloudAdvectionSpeed(0.0, time);
		vec3 advectionDelta = advectionOffset * uDeltaTime;
		vec3 currentPos = viewPos + canonicalRayDir * 5000.0 * worldScale;
		vec3 prevPos = currentPos - advectionDelta;
		vec4 prevClip = uPrevViewProjection * vec4(prevPos, 1.0);
		vec2 prevScreen = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
		vec2 finalVelocity = prevScreen - TexCoords;
		imageStore(outPackedVelocity, packedPixel, vec4(finalVelocity, 0.0, 0.0));
		return;
	}

	b_firstHit = max(t_start, b_firstHit - (50.0 * worldScale));
	b_lastHit = min(t_end, b_lastHit + (50.0 * worldScale));

	t_start = max(t_start, b_firstHit);
	t_end = min(t_end, b_lastHit);

	float absoluteShellDist = t_end - t_start;
	rayDist = t_end - t_start;
	baseStepSize = max(precisionLimit, rayDist / float(samples));

	float firstStepSize = baseStepSize;
	float its = 0.0;
	int MAX_ITERATIONS = 1000;

	float steps = 0.0;
	float firstHitStep = 0.0;
	float magic_stepping = 0.0;

	vec3 rgbExtinction = uCloudExtinctionColor * uCloudExtinction;

	if (t_start < t_end) {
		vec3 lightEnergy = vec3(0.0);
		vec3 prevDensity = vec3(0.0);

		vec3 primaryLightDir = vec3(0, 1, 0);
		for (int j = 0; j < num_lights; j++) {
			if (lights[j].type == LIGHT_TYPE_DIRECTIONAL) {
				primaryLightDir = normalize(-lights[j].direction);
				break;
			}
		}

		bool inVolume = false;
		float stepGrowthRate = 0.0125;

		float t = min(t_end, t_start + jitter * baseStepSize);
		float t_prev = t_start;
		prevDensity = vec3(0.0);

		vec3 probePos = viewPos + rayDir * max(0.0, t);
		vec3 skySH     = evalSHIrradianceSpatial(probePos, vec3(0.0, 1.0, 0.0));
		vec3 horizonSH = evalSHIrradianceSpatial(probePos, normalize(vec3(primaryLightDir.x, 0.15, primaryLightDir.z)));
		vec3 groundSH;

		CloudWeather weather;
		float lastWeatherT = -1e9;
		float lodStartDist = 25000.0 * worldScale;
		float lodFadeRange = 150000.0 * worldScale;

		int zero_count = 0;
		for (int i = 0; i < MAX_ITERATIONS; i++) {
			steps = i;
			if (t_prev >= dist || t_prev >= t_end || all(lessThan(cloudTransmittance, vec3(0.05)))) break;

			vec3 p = viewPos + rayDir * t;
			float currentLod = clamp((t - lodStartDist) / lodFadeRange, 0.0, 1.0);
			float dynamicStepMultiplier = max(1.0, t / (50000.0 * worldScale));
			float currentBaseStepSize = baseStepSize * dynamicStepMultiplier;
			float weatherUpdateInterval = 48.0 * worldScale * dynamicStepMultiplier;

			if (i == 0 || abs(t - lastWeatherT) >= weatherUpdateInterval) {
				weather = computeCloudWeather(p, props, currentLod);
				groundSH  = evalSHIrradianceSpatial(probePos, vec3(0.0, -1.0, 0.0));
				lastWeatherT = t;
			}

			bool doCheap = (t_prev >= t_end * 0.5 || all(lessThan(cloudTransmittance, vec3(0.75))));

			CloudDensityResult densityRes = calculateCloudDensity(p, weather, props, time, currentLod, doCheap);

			vec3 d = densityRes.density;

			float nextStepSize = calculateBifurcatedStepSize(inVolume, zero_count, max(d.x,max(d.y,d.z)), currentBaseStepSize, 3, 3);

			if (nextStepSize < 0.0) {
				// We overshot. Move 't' backward, but do NOT update 't_prev'.
				// Continue to bypass integration so we don't calculate negative density.
				t += nextStepSize;
				continue;
			}

			if (!inVolume) {
				// Lock in the current position BEFORE moving forward.
				t_prev = t;
				t += nextStepSize;
				continue;
			}

			float stepSize = t - t_prev;
			if (stepSize > 0.0) {
				float h_norm = getCloudRelativeHeight(p, weather);
				float integrationStep = stepSize;

				if (max(d.x, max(d.y, d.z)) > 0.01) {
					if (firstHitDist < 0.0) {
						firstHitDist = t;
						firstStepSize = stepSize;
						firstHitStep = i;
					}
					lastHitDist = t;
				}

				pathDensity = max(pathDensity, max(d.x, max(d.y, d.z)));

				if (any(greaterThan(d, vec3(0.000))) || any(greaterThan(prevDensity, vec3(0.000)))) {
					vec3 localExtinction = rgbExtinction * densityRes.relativeExtinction;
					vec3 averageDensity = (prevDensity + d) * 0.5;
					vec3 stepDensity = averageDensity * localExtinction;
					vec3 stepOpticalDepth = averageDensity * integrationStep * localExtinction;
					vec3 transmittanceAtStep = exp(-stepOpticalDepth);

					vec3 S = EvaluateStepLighting(
						p,
						rayDir,
						jitter,
						weather,
						props,
						localExtinction,
						stepDensity,
						stepOpticalDepth,
						h_norm,
						densityRes.advectionSpeed,
						densityRes.ao,
						densityRes.albedo,
						densityRes.emissivity,
						skySH,
						horizonSH,
						groundSH,
						primaryLightDir,
						R_ceiling,
						R_floor,
						earthCenter,
						currentLod
					);

					vec3 weight = cloudTransmittance * (vec3(1.0) - transmittanceAtStep);
					float scalarAccumOD = dot(accumulatedOpticalDepth, vec3(0.3333));
					float bias = exp(-scalarAccumOD * 15.0);
					float scalarWeight = dot(weight, vec3(0.3333));
					float stepWeight = scalarWeight * bias;
					weightedDistSum += t * stepWeight;
					weightedAdvectionSum += densityRes.advectionSpeed * stepWeight;
					lightEnergy += S * weight;
					totalWeight += stepWeight;

					cloudTransmittance *= transmittanceAtStep;
					accumulatedOpticalDepth += stepOpticalDepth;
				}
				prevDensity = d;
				t_prev = t;
			}

			t += nextStepSize;
			t = min(t_end, t);
		}
		cloudColor = lightEnergy * cloudColorUniform;
	}

	vec4 finalColor = vec4(cloudColor, dot(smoothstep(0.05, 1, cloudTransmittance), vec3(0.3333)));
	// vec4 finalColor = vec4(mix(vec3(0,10,0), vec3(10,0,0), smoothstep(0, 100, magic_stepping)), 0.0);
	// vec4 finalColor = vec4(mix(vec3(0,10,0), vec3(10,0,0), smoothstep(0, 100, firstHitDist/firstHitStep)), 0.0);
	// finalColor = mix(finalColor, vec4(mix(vec3(0,10000000,0), vec3(10000000,0,0), smoothstep(0, 100, firstHitStep)), 0.0), 0.3);
	// vec4 finalColor = vec4(magic_stepping * 100, 0.0, 0, 0);
	vec4 finalDepth;
	vec2 finalVelocity;

	if (totalWeight > 0.001) {
		float stableHitDist = weightedDistSum / totalWeight;
		vec3 avgAdvection = weightedAdvectionSum / totalWeight;

		finalDepth = vec4(firstHitDist, lastHitDist, firstStepSize, pathDensity);
		// Reproject using the accumulated per-sample advection directly
		vec3 stableHitPos = viewPos + canonicalRayDir * stableHitDist;
		// vec3 advectionDelta = avgAdvection * uDeltaTime;
		float distanceDamping = 1.0 - smoothstep(10000.0 * worldScale, 50000.0 * worldScale, stableHitDist);
		vec3 advectionDelta = (avgAdvection * distanceDamping) * uDeltaTime;

		vec3 prevHitPos = stableHitPos - advectionDelta;
		vec4 prevClipHit = uPrevViewProjection * vec4(prevHitPos, 1.0);
		vec2 prevScreenUV = (prevClipHit.xy / prevClipHit.w) * 0.5 + 0.5;

		finalVelocity = prevScreenUV - TexCoords;
	} else {
		finalDepth = vec4(uCloudMaxRayDistance * 0.5 * worldScale, uCloudMaxRayDistance * 0.5 * worldScale, firstStepSize, pathDensity);
		vec3 advectionOffset = getCloudAdvectionSpeed(0.0, time);
		vec3 advectionDelta = advectionOffset * uDeltaTime;

		vec3 currentPos = viewPos + canonicalRayDir * 5000.0 * worldScale;
		vec3 prevPos = currentPos - advectionDelta;
		vec4 prevClip = uPrevViewProjection * vec4(prevPos, 1.0);
		vec2 prevScreen = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
		finalVelocity = prevScreen - TexCoords;
	}

	imageStore(outPackedColor, packedPixel, finalColor);
	// imageStore(outPackedColor, packedPixel, vec4(vec3(its/10, 0, 0),0));
	imageStore(outPackedDepth, packedPixel, finalDepth);
	imageStore(outPackedVelocity, packedPixel, vec4(finalVelocity, 0.0, 0.0));
}
