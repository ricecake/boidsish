				// 			searchDist += searchStep;
				// 		}
				// 		searchStep *= 0.5;
				// 	}
				// 	t = searchDist; // Snap the ray exactly to the high-definition boundary
				// 	wasInVolume = true;
				// }

				vec3 rgbExtinction = uCloudExtinctionColor * uCloudExtinction;
				vec3 maj = rgbExtinction - d_cheap;
				float mu_maj = max(length(maj), 1e-4);

				float integrationStep = stepSize;

				// Residual Ratio Tracking inside the step
				d = d_cheap;
				vec3 T_r_step = vec3(1.0);
				bool sampledFull = false;
				CloudDensityResult densityResFull;

				if (any(greaterThan(d_cheap, vec3(0.000))) || any(greaterThan(prevCheapDensity, vec3(0.000)))) {
					float t_track = 0.0;
					float seed = jitter + p.x * 12.9898 + p.y * 78.233 + float(i) * 0.153;
					for (int k = 0; k < 2; ++k) {
						float u = fract(sin(seed + float(k) * 43.123) * 43758.5453);
						float s = -log(max(1e-5, 1.0 - u)) / mu_maj;
						t_track += s;
						if (t_track >= integrationStep) break;

						vec3 track_p = viewPos + rayDir * (t_prev + t_track);
						CloudWeather track_weather = computeCloudWeather(track_p, props, lod);
						CloudLayer track_layer = computeCloudLayer(track_weather, props);

						densityResFull = calculateCloudDensity(track_p, track_weather, track_layer, props, time, useCheapEval);
						CloudDensityResult d_cheap_track = calculateCloudDensityMinimal(track_p, track_weather, track_layer, props);

						vec3 mu_full = densityResFull.density * rgbExtinction;
						vec3 mu_cheap = d_cheap_track.density * rgbExtinction;
						vec3 mu_r = mu_full - mu_cheap;

						T_r_step *= (vec3(1.0) - mu_r / mu_maj);
						d = densityResFull.density;
						sampledFull = true;
					}
				}

				CloudDensityResult densityRes = sampledFull ? calculateCloudDensity(p, weather, layer, props, time, useCheapEval) : densityResCheap;
				d = densityRes.density;
				vec3 sampleAdvection = densityRes.advectionSpeed;
				float sampleAo = densityRes.ao;
				vec3 sampleAlbedo = densityRes.albedo;

				if (max(d.x, max(d.y, d.z)) > 0.01) {
					if (firstHitDist < 0.0) {
						firstHitDist = t;
						firstStepSize = stepSize;
						firstHitStep = i;
					}
					lastHitDist = t;
				}

				pathDensity = max(pathDensity, max(d.x, max(d.y, d.z)));

				if (any(greaterThan(d, vec3(0.000))) || any(greaterThan(prevDensity, vec3(0.000)))) {
					vec3 averageDensityCheap = (prevCheapDensity + d_cheap) * 0.5;
					vec3 stepDensityCheap = averageDensityCheap * integrationStep * rgbExtinction;
					vec3 T_c_step = exp(-stepDensityCheap);

					vec3 transmittanceAtStep = T_c_step * T_r_step;
					prevTransmissionDelta = prevTransmission - transmittanceAtStep;
					prevTransmission = transmittanceAtStep;

					vec3 averageDensity = (prevDensity + d) * 0.5;
					vec3 stepDensity = averageDensity * integrationStep * rgbExtinction;

					vec3 stepScattering = vec3(0.0);
					vec3 emissiveGlow = densityRes.emissivity;

					vec3 S = EvaluateStepLighting(
						p,
						rayDir,
						jitter,
						weather,
						layer,
						props,
						rgbExtinction,
						stepDensity,
						h_norm,
						densityRes.advectionSpeed,
						densityRes.ao,
						densityRes.albedo,
						emissiveGlow,
						skySH,
						horizonSH,
						groundSH,
						primaryLightDir,
						R_ceiling,
						R_floor,
						earthCenter
					);

					vec3 weight = cloudTransmittance * (vec3(1.0) - transmittanceAtStep);
					float scalarAccumOD = dot(accumulatedOpticalDepth, vec3(0.3333));
					float bias = exp(-scalarAccumOD * 15.0);
					float scalarWeight = dot(weight, vec3(0.3333));
					float stepWeight = scalarWeight * bias;
					weightedDistSum += t * stepWeight;
					weightedAdvectionSum += sampleAdvection * stepWeight;
					lightEnergy += S * weight;
					totalWeight += stepWeight;

					cloudTransmittance *= transmittanceAtStep;
					accumulatedOpticalDepth += stepDensity;
				}
				prevDensity = d;
				prevCheapDensity = d_cheap;
				t_prev = t;
			}

			// float nextStepSize = baseStepSize;
			// nextStepSize = min(t_end - t, max(baseStepSize, t * stepGrowthRate));
			// nextStepSize = nextStepSize * length(1.0 + 0.001/max(prevCheapDensity,0.001));
			// nextStepSize = nextStepSize * max(1.0-2.5*distance(d, prevDensity),0.001);
			float nextStepSize = calculateAdaptiveStepSize(t, prevCheapDensity, d, prevDensity, baseStepSize, 0.00125, 0.0001, 2.50);
			t += nextStepSize;
			t = min(t_end, t);
			currentStepSize = nextStepSize;
		}
		cloudColor = lightEnergy * cloudColorUniform;
	}

	vec4 finalColor = vec4(cloudColor, dot(cloudTransmittance, vec3(0.3333)));
	// vec4 finalColor = vec4(mix(vec3(0,10,0), vec3(10,0,0), smoothstep(0, 100, magic_stepping)), 0.0);
	// vec4 finalColor = vec4(mix(vec3(0,10,0), vec3(10,0,0), smoothstep(0, 100, firstHitDist/firstHitStep)), 0.0);
	// vec4 finalColor = vec4(mix(vec3(0,10,0), vec3(10,0,0), smoothstep(0, 100, firstHitStep)), 0.0);
	// vec4 finalColor = vec4(magic_stepping * 100, 0.0, 0, 0);
	vec4 finalDepth;
	vec2 finalVelocity;

	if (totalWeight > 0.001) {
		float stableHitDist = weightedDistSum / totalWeight;
		vec3 avgAdvection = weightedAdvectionSum / totalWeight;

		finalDepth = vec4(firstHitDist, lastHitDist, firstStepSize, pathDensity);

		// Reproject using the accumulated per-sample advection directly
		vec3 stableHitPos = viewPos + canonicalRayDir * stableHitDist;
		vec3 advectionDelta = avgAdvection * uDeltaTime;

		vec3 prevHitPos = stableHitPos - advectionDelta;
		vec4 prevClipHit = uPrevViewProjection * vec4(prevHitPos, 1.0);
		vec2 prevScreenUV = (prevClipHit.xy / prevClipHit.w) * 0.5 + 0.5;

		finalVelocity = prevScreenUV - TexCoords;
		// finalVelocity = vec2(minStepSize/10, 0);
	} else {
		finalDepth = vec4(uCloudMaxRayDistance * 0.5 * worldScale, uCloudMaxRayDistance * 0.5 * worldScale, firstStepSize, pathDensity);
		vec3 advectionOffset = getCloudAdvectionSpeed(0.0, time);
		vec3 advectionDelta = advectionOffset * uDeltaTime;

		vec3 currentPos = viewPos + canonicalRayDir * 5000.0 * worldScale;
		vec3 prevPos = currentPos - advectionDelta;
		vec4 prevClip = uPrevViewProjection * vec4(prevPos, 1.0);
		vec2 prevScreen = (prevClip.xy / prevClip.w) * 0.5 + 0.5;
		finalVelocity = prevScreen - TexCoords;
	}

	imageStore(outPackedColor, packedPixel, finalColor);
	// imageStore(outPackedColor, packedPixel, vec4(vec3(its/10, 0, 0),0));
	imageStore(outPackedDepth, packedPixel, finalDepth);
	imageStore(outPackedVelocity, packedPixel, vec4(finalVelocity, 0.0, 0.0));
}
