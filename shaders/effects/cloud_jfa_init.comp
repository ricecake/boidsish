#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) uniform image2D outJFA;
uniform sampler2D uWeatherMap;
uniform float uCloudCoverage;

#define JUMPFLOOD_TYPE vec4
#define JUMPFLOOD_ENCODE_FNC(VEC) vec4(VEC, 0.0, 1.0)

// jumpFlood.glsl jumpFloodEncode implementation:
// JUMPFLOOD_TYPE jumpFloodEncode(SAMPLER_TYPE tex, vec2 st) { return JUMPFLOOD_ENCODE_FNC(st * JUMPFLOOD_SAMPLE_FNC(tex, st).a); }
// Here JUMPFLOOD_SAMPLE_FNC is texture(tex, uv) by default.
// Our weather map has 'coverage' potentially in weather.r or weather.a?
// Actually in cloud_weather_bake.comp: imageStore(outWeatherMap, pixel, vec4(weatherMap, heightMap, cellID, 1.0));
// So weatherMap (coverage) is in R.
// jumpFloodEncode by default uses .a. Let's redefine JUMPFLOOD_SAMPLE_FNC to use .r.

#ifndef JUMPFLOOD_SAMPLE_FNC
#define JUMPFLOOD_SAMPLE_FNC(TEX, UV) vec4(0.0, 0.0, 0.0, texture(TEX, UV).r)
#endif

#include "lygia/morphological/jumpFlood.glsl"

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outJFA);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    vec4 weather = texture(uWeatherMap, uv);

    float coverage = uCloudCoverage * weather.r;

    // If there's potential for cloud, it's a seed
    // We use a threshold slightly below the actual coverage to be safe
    bool isCloud = coverage > 0.1;

    vec4 data = vec4(0.0);
    if (isCloud) {
        data = jumpFloodEncode(uWeatherMap, uv);
    }

    imageStore(outJFA, pixel, data);
}
