#version 460 core

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

#include "../helpers/constants.glsl"

#define USE_TERRAIN_DATA
#include "../helpers/terrain_shadows.glsl"
#include "../helpers/lighting.glsl"

// Sky and Aerial Perspective LUTs
uniform sampler2D u_skyViewLUT;
uniform sampler3D u_aerialPerspectiveLUT;

uniform vec3 u_probePosition;

struct SpaceProbeData {
	float shadow_level;
	float shadow_from_terrain;
	float cloud_shadow;
	float ambient_occlusion;
	vec4 light_directional;
	vec4 light_other;
	vec4 light_ambient;
	vec4 sh_coeffs[9];
};

layout(std430, binding = [[SPACE_PROBE_BINDING]]) buffer SpaceProbeBuffer {
	SpaceProbeData u_spaceProbeData;
};

// SH basis constants
const float C1 = 0.282095;
const float C2 = 0.488603;
const float C3 = 1.092548;
const float C4 = 0.315392;
const float C5 = 0.546274;

void projectRadianceToSH(vec3 dir, vec3 radiance, float weight, inout vec3 sh[9]) {
	float x = dir.x;
	float y = dir.y;
	float z = dir.z;

	float mcWeight = 4.0 * PI * weight;

	sh[0] += radiance * C1 * mcWeight;
	sh[1] += radiance * (C2 * y) * mcWeight;
	sh[2] += radiance * (C2 * z) * mcWeight;
	sh[3] += radiance * (C2 * x) * mcWeight;
	sh[4] += radiance * (C3 * x * y) * mcWeight;
	sh[5] += radiance * (C3 * y * z) * mcWeight;
	sh[6] += radiance * (C4 * (3.0 * y * y - 1.0)) * mcWeight;
	sh[7] += radiance * (C3 * x * z) * mcWeight;
	sh[8] += radiance * (C5 * (x * x - z * z)) * mcWeight;
}

vec3 sampleSkyLUT(vec3 rd, vec3 probeOrigin) {
	float azimuth = atan(rd.x, -rd.z);
	if (azimuth < 0.0) azimuth += 2.0 * PI;
	float uvX = azimuth / (2.0 * PI);

	float elevation = asin(clamp(rd.y, -1.0, 1.0));
	float adjV = sqrt(abs(elevation) / (PI * 0.5));
	float uvY = (elevation < 0.0) ? (0.5 - 0.5 * adjV) : (0.5 + 0.5 * adjV);

	vec3 skyRadiance = max(texture(u_skyViewLUT, vec2(uvX, uvY)).rgb, vec3(0.01, 0.05, 0.1));

	// Account for atmosphere between probe and sky (Aerial Perspective)
	float u = uvX;
	float v = elevation / PI + 0.5;
	float w = 1.0; // Sample at max distance

	vec4 ap = texture(u_aerialPerspectiveLUT, vec3(u, v, w));
	vec3 inScattering = ap.rgb;
	float transmittance = ap.a;

	vec3 finalSky = skyRadiance * transmittance + inScattering;
	float cloudShadow = calculateCloudShadowFactor(probeOrigin, rd, 1.0);
	return finalSky * cloudShadow;
}

vec3 sampleTerrainFallback(vec3 worldPos, vec3 rayDir) {
	float scaledChunkSize = u_terrainParams.x * u_terrainParams.y;
	float worldScaleVal = u_terrainParams.y;

	float currentDist = 0.5 * worldScaleVal;
	const int k_coarseSteps = 16;
	float stepSize = 8.0 * worldScaleVal;

	for (int i = 0; i < k_coarseSteps; ++i) {
		vec3 p = worldPos + rayDir * currentDist;
		vec2 gridPos = p.xz / scaledChunkSize - vec2(u_originSize.xy);
		ivec2 chunkCoord = ivec2(floor(gridPos));

		if (chunkCoord.x >= 0 && chunkCoord.x < u_originSize.z && chunkCoord.y >= 0 && chunkCoord.y < u_originSize.z) {
			int slice = int(texelFetch(u_chunkGrid, chunkCoord, 0).r);
			if (slice >= 0) {
				vec2 uv = fract(gridPos);
				vec2 remappedUV = (uv * u_terrainParams.x + 0.5) / (u_terrainParams.x + 1.0);
				vec4 hNorm = texture(u_heightmapArray, vec3(remappedUV, float(slice)));
				if (p.y <= hNorm.r) {
					vec2 biomeInfo = texture(u_biomeMap, vec3(remappedUV, float(slice))).rg;
					int lowIdx = int(biomeInfo.x);
					float t = biomeInfo.y;
					vec3 albedo = mix(u_biomes[lowIdx].albedo_roughness.rgb, u_biomes[min(lowIdx + 1, 7)].albedo_roughness.rgb, t);
					vec3 normal = normalize(hNorm.gba);

					vec3 radiance = vec3(0.0);
					for (int l = 0; l < min(num_lights, 2); ++l) {
						vec3 L = normalize(lights[l].type == 1 ? -lights[l].direction : (lights[l].position - p));
						float NdotL = max(0.0, dot(normal, L));

						if (lights[l].type == 1 && L.y <= 0.0) continue;

						float shadow = 1.0;
						vec3 atmosphereTransmittance = vec3(1.0);

						if (lights[l].type == 1) {
							float r = kEarthRadiusKM + (p.y / (1000.0 * worldScaleVal));
							atmosphereTransmittance = texture(u_transmittanceLUT, getTransmittanceUV(r, L.y)).rgb;
							shadow *= calculateCloudShadow(l, p);
							shadow *= terrainShadowCoverage(p, normal, L);
						}

						radiance += albedo * lights[l].color * lights[l].intensity * atmosphereTransmittance * NdotL * 0.5 * shadow;
					}
					return radiance;
				}
			}
		} else {
			if (rayDir.y < -0.01) {
				float t = -worldPos.y / rayDir.y;
				if (t > 0.0 && t < currentDist + stepSize) {
					return vec3(0.05, 0.04, 0.03) * ambient_light * 0.5;
				}
			}
			break;
		}
		currentDist += stepSize;
	}
	return sampleSkyLUT(rayDir, worldPos);
}

void main() {
	// 1. Find the primary directional light (if any)
	int dir_light_idx = -1;
	for (int i = 0; i < num_lights; ++i) {
		if (lights[i].type == LIGHT_TYPE_DIRECTIONAL) {
			dir_light_idx = i;
			break;
		}
	}

	// 2. Evaluate Shadows
	float shadow_from_terrain = 1.0;
	float cloud_shadow = 1.0;
	float shadow_level = 1.0;

	if (dir_light_idx != -1) {
		vec3 sunDir = normalize(-lights[dir_light_idx].direction);
		shadow_from_terrain = terrainShadowCoverage(u_probePosition, vec3(0.0, 1.0, 0.0), sunDir);
		cloud_shadow = calculateCloudShadowFactor(u_probePosition, sunDir, cloudShadowIntensity);
		shadow_level = calculateShadow(dir_light_idx, u_probePosition, vec3(0.0, 1.0, 0.0), sunDir);
		shadow_level *= cloud_shadow;
	}

	// 3. Evaluate Ambient Occlusion
	float terrainAO = calculateTerrainOcclusion(u_probePosition, vec3(0.0, 1.0, 0.0));
	float cloudAO = calculateCloudAmbientOcclusion(u_probePosition);
	float ambient_occlusion = terrainAO * cloudAO;

	// 4. Evaluate Light Levels
	// Isotropic Directional light
	vec3 light_directional = vec3(0.0);
	for (int i = 0; i < num_lights; ++i) {
		if (lights[i].type == LIGHT_TYPE_DIRECTIONAL) {
			vec3 L = normalize(-lights[i].direction);
			float shadow = calculateShadow(i, u_probePosition, vec3(0.0, 1.0, 0.0), L);
			shadow *= calculateCloudShadowFactor(u_probePosition, L, cloudShadowIntensity);
			light_directional += lights[i].color * lights[i].intensity * shadow;
		}
	}

	// Isotropic Local Light ("other")
	vec3 light_other = vec3(0.0);
	for (int i = 0; i < num_lights; ++i) {
		if (lights[i].type != LIGHT_TYPE_DIRECTIONAL) {
			vec3 L;
			float atten;
			calculateLightContribution(i, u_probePosition, L, atten);
			float shadow = 1.0;
			if ((lights[i].flags & LIGHT_FLAG_CASTS_SHADOW) != 0) {
				shadow = calculateShadow(i, u_probePosition, vec3(0.0, 1.0, 0.0), L);
			}
			light_other += lights[i].color * lights[i].intensity * atten * shadow;
		}
	}

	// Ambient light levels (base + spatially-interpolated SH probe)
	vec3 light_ambient = ambient_light + evalSHIrradianceSpatial(u_probePosition, vec3(0.0, 1.0, 0.0));

	// 5. Evaluate Spherical Harmonics at the Space Probe position
	vec3 newSH[9];
	for (int i = 0; i < 9; ++i) {
		newSH[i] = vec3(0.0);
	}

	const int numSamples = 64;
	float weight = 1.0 / float(numSamples);

	for (int i = 0; i < numSamples; ++i) {
		// Fibonacci sphere point
		float theta = acos(1.0 - 2.0 * (float(i) + 0.5) / float(numSamples));
		float phi = 2.0 * PI * float(i) * 0.618033988749895;

		vec3 rd = vec3(sin(theta) * cos(phi), cos(theta), sin(theta) * sin(phi));

		vec3 radiance;
		if (rd.y >= 0.0) {
			radiance = sampleSkyLUT(rd, u_probePosition);
		} else {
			radiance = sampleTerrainFallback(u_probePosition, rd);
		}

		projectRadianceToSH(rd, radiance, weight, newSH);
	}

	// Write results to the SSBO
	u_spaceProbeData.shadow_level = shadow_level;
	u_spaceProbeData.shadow_from_terrain = shadow_from_terrain;
	u_spaceProbeData.cloud_shadow = cloud_shadow;
	u_spaceProbeData.ambient_occlusion = ambient_occlusion;
	u_spaceProbeData.light_directional = vec4(light_directional, 1.0);
	u_spaceProbeData.light_other = vec4(light_other, 1.0);
	u_spaceProbeData.light_ambient = vec4(light_ambient, 1.0);

	for (int i = 0; i < 9; ++i) {
		u_spaceProbeData.sh_coeffs[i] = vec4(newSH[i], 1.0);
	}
}
