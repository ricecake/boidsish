#version 460 core

#define WIND_COMPUTE
#include "helpers/wind.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba32f, binding = [[INTEGRATED_WIND_IMAGE_BINDING]]) uniform image2D u_integratedWindImage;
layout(rgba32f, binding = [[INTEGRATED_WIND_UV_IMAGE_BINDING]]) uniform image2D u_integratedWindUvImage;

uniform float u_deltaTime;

void main() {
    ivec2 texelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(u_integratedWindImage);

    if (texelCoord.x >= size.x || texelCoord.y >= size.y) {
        return;
    }

    // Calculate world position corresponding to this texel
    float gridSpacing = u_windParams.x;
    vec2 uv = (vec2(texelCoord) + 0.5) / vec2(size);

    // World XZ = (uv * originSize.yw + originSize.xz) * gridSpacing
    vec2 worldXZ = (uv * vec2(u_windOriginSize.y, u_windOriginSize.w) + vec2(u_windOriginSize.xz)) * gridSpacing;

    // We sample at a representative height (e.g., ground level + 1.0)
    // The wind system uses getTerrainHeight internally for deflection
    TerrainSurface surface = getTerrainSurface(worldXZ);
    float height = surface.height + 1.0;

    vec4 instWindData = computeWindAtPositionOptimized(vec3(worldXZ.x, height, worldXZ.y), surface.height, surface.normal);
    vec3 instWind = instWindData.xyz;
    float instSpeed = length(instWind);
    vec2 instDir = instSpeed > 0.001 ? normalize(instWind.xz) : vec2(1.0, 0.0);

    vec4 prevData = imageLoad(u_integratedWindImage, texelCoord);
    vec3 prevEMA = prevData.xyz;
    float prevSpeedStdDev = prevData.w;

    vec4 prevUvData = imageLoad(u_integratedWindUvImage, texelCoord);
    vec2 prevUV = prevUvData.xy;
    float prevDirStdDev = prevUvData.z; // Directional standard deviation (in radians)

    float dt = max(0.0001, u_deltaTime);

    if (length(prevEMA) < 0.0001 && prevSpeedStdDev <= 0.0) {
        imageStore(u_integratedWindImage, texelCoord, vec4(instWind, 0.0));
        // Initialize the offset to 0.0, not the spatial 'uv'
        imageStore(u_integratedWindUvImage, texelCoord, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }

    // Error between new wind vector and stored EMA value drives adaptation
    vec3 diff = instWind - prevEMA;
    float errorMag = length(diff);

    // Adaptive exponential moving average:
    // Damps high-frequency oscillations while adapting quickly to big swings.
    float adaptFactor = clamp(errorMag / (prevSpeedStdDev + 0.5), 0.0, 1.0);
    float lambdaEff = mix(2.5, 25.0, adaptFactor);
    float alpha = clamp(1.0 - exp(-lambdaEff * dt), 0.01, 1.0);

    vec3 newEMA = prevEMA + alpha * diff;
    float newEmaSpeed = length(newEMA);
    vec2 newEmaDir = newEmaSpeed > 0.001 ? normalize(newEMA.xz) : vec2(1.0, 0.0);

    // Track directional variance/error between instantaneous wind direction and EMA wind direction
    float dotDir = clamp(dot(instDir, newEmaDir), -1.0, 1.0);
    float dirAngleDiff = acos(dotDir); // Angular error in radians
    float instDirVar = dirAngleDiff * dirAngleDiff;

    float alphaVar = 1.0 - exp(-3.0 * dt);

    // Moving variance & standard deviation update for speed/intensity
    float instSpeedVar = dot(diff, diff);
    float newSpeedVar = mix(prevSpeedStdDev * prevSpeedStdDev, instSpeedVar, alphaVar);
    float newSpeedStdDev = sqrt(max(0.0, newSpeedVar));

    // Moving variance & standard deviation update for direction
    float newDirVar = mix(prevDirStdDev * prevDirStdDev, instDirVar, alphaVar);
    float newDirStdDev = sqrt(max(0.0, newDirVar));

    // Pre-integrate raw velocity (world units) along EMA wind direction
    vec2 uvVelocity = newEMA.xz;
    vec2 newUV = prevUV + uvVelocity * dt * 0.25;

    imageStore(u_integratedWindImage, texelCoord, vec4(newEMA, newSpeedStdDev));
    imageStore(u_integratedWindUvImage, texelCoord, vec4(newUV, newDirStdDev, 0.0));}
