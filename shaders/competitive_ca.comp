#version 430 core

#include "lygia/generative/random.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform readonly image2D u_read_state;
layout(rgba32f, binding = 1) uniform writeonly image2D u_write_state;
layout(rgba32f, binding = 2) uniform writeonly image2D u_display_state;

uniform int u_mode; // 0 = Continuous Growth, 1 = Continuous Cyclic, 2 = Soft Voting, 3 = Energy-Conserving Two-Pass
uniform int u_pass; // 1 = Pass 1 (Growth & Competition), 2 = Pass 2 (Drain Logic)
uniform float u_dt;
uniform float u_growth;
uniform float u_competition;
uniform float u_diffusion;
uniform float u_sharpness;
uniform float u_fuzziness;
uniform int u_radius;
uniform float u_time;

// Standard spatial-temporal PRNG hash function
float hash(vec3 p) {
	p = fract(p * 0.3183099 + 0.1);
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

// Simple pseudo-random hash based on coordinate and time
float rand(vec2 co) {
	return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}

vec4 read_state_pixel(ivec2 pos) {
	ivec2 size = imageSize(u_read_state);
	// Wrap coordinates for toroidal boundary conditions
	pos.x = (pos.x + size.x) % size.x;
	pos.y = (pos.y + size.y) % size.y;
	return imageLoad(u_read_state, pos);
}

void main() {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(u_read_state);
	if (pos.x >= size.x || pos.y >= size.y) return;

	vec4 C = read_state_pixel(pos);
	vec4 new_C = C;

	if (u_mode == 3) {
		// --- MODE 3: Energy-Conserving Two-Pass Competitive CA ---
		ivec2 offsets[] = ivec2[](
			ivec2(0,1),
			ivec2(1,0),
			ivec2(0,-1),
			ivec2(-1,0),

			ivec2(1,1),
			ivec2(-1,-1),
			ivec2(-1,1),
			ivec2(1,-1)
		);

		if (u_pass == 1) {
			// --- Pass 1: Evaluate Growth & Competition ---
			float avgProb = 0.0;
			float maxEnergy = -1.0;
			float dominantID = C.r;
			int activeNeighbors = 0;

			// 1. Gather neighborhood data
			for (int i = 0; i < offsets.length(); i++) {
				vec4 neighbor = read_state_pixel(pos + offsets[i]);
				if (neighbor.r != 0.0) {
					float weight = 1.0/pow(length(offsets[i]),3);
					avgProb += weight * neighbor.b;
					activeNeighbors++;

					// Track the strongest neighbor for competition
					if (neighbor.g * weight > maxEnergy) {
						maxEnergy = weight * neighbor.g;
						dominantID = neighbor.r;
					}
				}
			}

			vec4 nextState = C;

			// 2. Evaluate Growth for Empty Cells
			if (C.r == 0.0 && activeNeighbors > 0) {
				avgProb /= float(activeNeighbors);
				// Use u_growth as a multiplier for probability
				float finalProb = avgProb * u_growth;
				float roll = hash(vec3(vec2(pos), u_time));

				if (roll < finalProb) {
					// Growth successful
					float overRoll = finalProb - roll; // Amount surpassed
					float substrateEnergy = C.g;
					float requestedEnergy = overRoll * maxEnergy;
					float parentDeficit = max(requestedEnergy - substrateEnergy, 0.0);

					nextState.r = dominantID;           // Inherit ID from strongest neighbor
					nextState.b = max(0.9, avgProb);              // Inherit average probability
					nextState.g = substrateEnergy + parentDeficit; // Energy proportional to over-roll

					// Store the amount of energy we are pulling so parents know how much to subtract
					nextState.a = parentDeficit;
				}
			}
			// 3. Evaluate Competition for Populated Cells
			else if (C.r != 0.0 && activeNeighbors > 0 && dominantID != C.r) {
				avgProb /= float(activeNeighbors);

				// If a neighboring ID has strictly more energy, it attempts to overgrow
				float combat = hash(vec3(vec2(pos), u_time));
				if ((maxEnergy * combat) >= ((1.0 - combat) * C.g)) {
					 nextState.r = dominantID;
					 float energyDiff = maxEnergy - C.g;
					 // The dominant ID wins, but loses energy equal to the cell it consumed
					 nextState.g = energyDiff + 0.80 * C.g;
					 nextState.a = energyDiff + 0.6 * C.g;
					//  nextState.a = nextState.g * 0.5;
				}
				else {
					// nextState.g = 0.9 * C.g;
				}
			}
			new_C = nextState;

		} else {
			// --- Pass 2: Drain Logic & Clear Delta ---
			vec4 nextState = C;
			if (C.r != 0.0 && C.a == 0.0) {
				float energy_subtracted = 0.0;

				for (int i = 0; i < offsets.length(); ++i) {
					ivec2 neighbor_pos = pos + offsets[i];
					vec4 neighbor = read_state_pixel(neighbor_pos);
					if (neighbor.r == C.r && neighbor.a > 0.0) {
						// This neighbor is a newly grown cell sharing our ID.
						// Count how many potential parents this neighbor child has.
						int child_parents = 0;
						for (int j = 0; j < offsets.length(); ++j) {
							vec4 parent_neighbor = read_state_pixel(neighbor_pos + offsets[j]);
							// A parent is a cell that already has the ID and isn't newly grown (delta is 0)
							if (parent_neighbor.r == C.r && parent_neighbor.a == 0.0) {
								child_parents++;
							}
						}
						if (child_parents == 0) child_parents = 1;
						energy_subtracted += neighbor.a / float(child_parents);
					}
				}
				// Proportional subtraction
				nextState.g = max(C.g - energy_subtracted, 0.0);

				float energySum = nextState.g;
				float neighbors = 1.0;
				for (int i = 0; i < offsets.length(); ++i) {
					ivec2 neighbor_pos = pos + offsets[i];
					vec4 neighbor = read_state_pixel(neighbor_pos);
					if (neighbor.r == C.r && neighbor.a > 0.0) {
						neighbors += 1.0;
						energySum += max(0.0, (1/pow(length(offsets[i]), 3) * neighbor.g) - 1.0);
					}
				}

				nextState.g = (energySum / neighbors) + u_competition*C.b * hash(vec3(vec2(pos), u_time));
				nextState.g *= 1.0 - u_competition/neighbors;

			}
			// Clear Delta
			nextState.a = 0.0;
			new_C = nextState;
		}

	} else {
		// --- MODES 0, 1, 2: Continuous-State CA ---
		// Calculate local average in the neighborhood of radius u_radius
		vec4 sum = vec4(0.0);
		float total_weight = 0.0;
		int r = clamp(u_radius, 1, 5); // Safety clamp to avoid massive nested loops

		for (int dy = -r; dy <= r; ++dy) {
			for (int dx = -r; dx <= r; ++dx) {
				sum += read_state_pixel(pos + ivec2(dx, dy));
				total_weight += 1.0;
			}
		}
		vec4 avg = sum / total_weight;

		if (u_mode == 0) {
			// --- MODE 0: Continuous Competitive Growth ---
			float total_C = C.r + C.g + C.b + C.a;
			float total_avg = avg.r + avg.g + avg.b + avg.a;

			// Logistic growth limited by total concentration space
			vec4 growth_term = u_growth * avg * (1.0 - clamp(total_C, 0.0, 1.0));

			// Competitive inhibition: species suppress other species based on neighbor presence
			vec4 competition_term = u_competition * C * (total_avg - avg);

			// Diffusion: smoothing out species values
			vec4 diffusion_term = u_diffusion * (avg - C);

			vec4 net_change = (growth_term - competition_term + diffusion_term) * u_dt;
			new_C = C + net_change;

		} else if (u_mode == 1) {
			// --- MODE 1: Continuous Cyclic Dominance (RPS-style) ---
			// Species cycle: Red (r) -> Green (g) -> Blue (b) -> Alpha (a) -> Red (r)
			vec4 growth_term = vec4(0.0);
			growth_term.r = u_growth * C.r * avg.g;
			growth_term.g = u_growth * C.g * avg.b;
			growth_term.b = u_growth * C.b * avg.a;
			growth_term.a = u_growth * C.a * avg.r;

			vec4 loss_term = vec4(0.0);
			loss_term.r = u_competition * C.r * avg.a;
			loss_term.g = u_competition * C.g * avg.r;
			loss_term.b = u_competition * C.b * avg.g;
			loss_term.a = u_competition * C.a * avg.b;

			vec4 diffusion_term = u_diffusion * (avg - C);

			vec4 net_change = (growth_term - loss_term + diffusion_term) * u_dt;
			new_C = C + net_change;

		} else if (u_mode == 2) {
			// --- MODE 2: Soft Voting / Threshold Growth ---
			// If neighbor species is above threshold (u_competition), it tries to conquer/grow
			vec4 voting_growth = vec4(0.0);
			for (int i = 0; i < 4; ++i) {
				if (avg[i] > u_competition) {
					voting_growth[i] = u_growth * (avg[i] - u_competition);
				}
			}
			vec4 net_change = (voting_growth + u_diffusion * (avg - C)) * u_dt;
			new_C = C + net_change;
		}

		// --- Stochastic Fuzziness ---
		if (u_fuzziness > 0.0) {
			vec4 noise_val = vec4(
				rand(vec2(pos) + vec2(u_time * 1.00)),
				rand(vec2(pos) + vec2(u_time * 1.11 + 13.0)),
				rand(vec2(pos) + vec2(u_time * 1.22 + 27.0)),
				rand(vec2(pos) + vec2(u_time * 1.33 + 41.0))
			);
			new_C += (noise_val - 0.5) * u_fuzziness * u_dt;
		}

		// --- Sharpness / Reinforcing distinct cell boundaries ---
		if (u_sharpness > 0.0) {
			float max_val = max(max(new_C.r, new_C.g), max(new_C.b, new_C.a));
			if (max_val > 0.01) {
				vec4 sharp_boost = pow(new_C / max_val, vec4(1.0 + u_sharpness * u_dt));
				new_C = sharp_boost * max_val;
			}
		}

		// Safety clamping
		new_C = clamp(new_C, 0.0, 1.0);
	}

	imageStore(u_write_state, pos, new_C);

	// --- Resolve to a high-contrast fully opaque display color ---
	vec3 display_color = vec3(0.05, 0.05, 0.08); // Solid slate background

	vec3 color_a = vec3(1.0, 0.1, 0.1);   // Vivid Red
	vec3 color_b = vec3(0.1, 0.9, 0.1);   // Vivid Green
	vec3 color_c = vec3(0.1, 0.4, 1.0);   // Electric Blue
	vec3 color_d = vec3(1.0, 0.9, 0.1);   // Gold/Yellow

	if (u_mode == 3) {
		if (new_C.r > 0.0) {
			vec3 active_color = vec3(0.0);
			if (new_C.r < 1.5) active_color = color_a;
			else if (new_C.r < 2.5) active_color = color_b;
			else if (new_C.r < 3.5) active_color = color_c;
			else active_color = color_d;

			// Map intensity from cell energy (g)
			float intensity = clamp(new_C.g, 0.1, 1.0);
			// display_color = mix(display_color, active_color, intensity);
			display_color = random3(new_C.r);
		}
	} else {
		float total_conc = new_C.r + new_C.g + new_C.b + new_C.a;
		if (total_conc > 0.001) {
			vec3 active_color = (new_C.r * color_a + new_C.g * color_b + new_C.b * color_c + new_C.a * color_d) / total_conc;
			float blend_factor = clamp(total_conc, 0.0, 1.0);
			display_color = mix(display_color, active_color, blend_factor);
		}
	}

	imageStore(u_display_state, pos, vec4(display_color, 1.0));
}
