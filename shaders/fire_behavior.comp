#version 460 core

#define COMPUTE_SHADER
#include "frustum.glsl"
#include "lighting.glsl"
#include "particle_behavior.glsl"
#include "particle_helpers.glsl"
#include "particle_lifecycle.glsl"
#include "particle_types.glsl"
#include "helpers/noise.glsl"

uniform float u_delta_time;
uniform float u_time;
uniform float u_ambient_density;
uniform int   u_num_emitters;
uniform int   u_num_chunks;
uniform uint  u_grid_size;
uniform float u_cell_size;
uniform bool  u_particle_lights_enabled;

#ifndef TERRAIN_BIOME_MAP_DEFINED
#define TERRAIN_BIOME_MAP_DEFINED
uniform sampler2DArray u_biomeMap;
#endif

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

void main() {
	uint live_idx = gl_GlobalInvocationID.x;

	// Use the preserved particle count for the early-exit check
	if (live_idx >= behavior_command.count) {
		return;
	}

	uint     gid = live_indices[live_idx];
	Particle p = particles[gid];

	// --- 4. Update Logic (Only for Alive Particles) ---
	updateBehavior(
		p,
		u_delta_time,
		u_time,
		viewPos,
		viewDir,
		u_cell_size,
		u_grid_size,
		u_curlTexture,
		u_num_chunks,
		u_heightmapArray
	);

	if (u_particle_lights_enabled && p.pos.w > 0.0) {
		if (p.style == STYLE_FIRE || p.style == STYLE_FIREFLIES) {
			bool should_create = false;
			float intensity = 0.0;
			if (p.style == STYLE_FIRE) {
				if ((gid % 8) == 0) {
					should_create = true;
					intensity = p.color.a * 3.0;
				}
			} else if (p.style == STYLE_FIREFLIES) {
				if ((gid % 4) == 0) {
					should_create = true;
					intensity = p.color.a * 0.5;
				}
			}

			if (should_create && intensity > 0.01) {
				uint light_idx = atomicAdd(count, 1);
				if (light_idx < 1024) {
					lights[light_idx].position = p.pos.xyz;
					lights[light_idx].intensity = intensity;
					lights[light_idx].color = p.color.rgb;
					lights[light_idx].type = 0; // POINT_LIGHT
					lights[light_idx].direction = vec3(0.0, -1.0, 0.0);
					lights[light_idx].inner_cutoff = 0.0;
					lights[light_idx].outer_cutoff = 0.0;
					lights[light_idx].flags = 0;
					lights[light_idx]._pad0 = 0.0;
					lights[light_idx]._pad1 = 0.0;
				} else {
					atomicAdd(count, 0xFFFFFFFFU);
				}
			}
		}
	}

	particles[gid] = p;

	// --- 5. Visibility and Compaction ---
	handleVisibility(p, gid);
}
