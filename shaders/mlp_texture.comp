#version 430 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "helpers/mlp.glsl"

layout(rgba32f, binding = 0) uniform writeonly image2D u_output_texture;

uniform float u_time;
uniform int u_mode; // 0 = Flat Color, 1 = SDF Visualization
uniform float u_scale; // UV scaling factor

void main() {
	ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
	ivec2 size = imageSize(u_output_texture);
	if (pos.x >= size.x || pos.y >= size.y) return;

	// Normalize coordinates to [-u_scale, u_scale]
	vec2 uv = (vec2(pos) / vec2(size) - 0.5) * 2.0 * u_scale;

	float state[MLP_MAX_NEURONS];
	for (int i = 0; i < MLP_MAX_NEURONS; ++i) {
		state[i] = 0.0;
	}

	state[0] = uv.x;
	state[1] = uv.y;
	state[2] = u_time * 0.1; // Slow down time slightly for smooth advection

	float output_val[MLP_MAX_NEURONS];
	for (int i = 0; i < MLP_MAX_NEURONS; ++i) {
		output_val[i] = 0.0;
	}

	evaluate_mlp(state, output_val);

	vec4 final_color = vec4(0.0, 0.0, 0.0, 1.0);

	if (u_mode == 0) {
		// Mode 0: Flat Color
		// Map outputs to [0, 1] for visual safety
		final_color.r = output_val[0];
		final_color.g = output_val[1];
		final_color.b = output_val[2];
		final_color.a = 1.0;
		// If activations are tanh, map from [-1, 1] to [0, 1]
		if (u_mlp_metadata.layers[u_mlp_metadata.num_layers - 1].activation == 4) {
			final_color.rgb = final_color.rgb * 0.5 + 0.5;
		}
	} else {
		// Mode 1: Signed Distance Field (SDF)
		// Assume output_val[0] is the distance d
		float d = output_val[0];

		// Beautiful SDF coloring: Red/orange for negative, Cyan/blue for positive
		vec3 col = (d < 0.0) ? vec3(0.9, 0.4, 0.1) : vec3(0.1, 0.5, 0.8);

		// Add light/dark banding contours to visualize the field lines
		col *= 1.0 - exp(-6.0 * abs(d)); // darken near boundary
		col *= 0.8 + 0.2 * cos(120.0 * d); // concentric ripples

		// Clean white zero-isocontour edge line
		col = mix(col, vec3(1.0), 1.0 - smoothstep(0.0, 0.02, abs(d)));

		final_color = vec4(col, 1.0);
	}

	imageStore(u_output_texture, pos, final_color);
}
