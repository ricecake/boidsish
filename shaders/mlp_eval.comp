#version 430 core

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#include "helpers/mlp.glsl"

layout(rgba32f, binding = 0) uniform writeonly image2D u_eval_texture_2d;
layout(rgba32f, binding = 1) uniform writeonly image3D u_eval_texture_3d;

uniform float u_time;
uniform int u_dimension;    // 2 = 2D, 3 = 3D
uniform int u_num_inputs;   // 2, 3, or 4
uniform int u_num_outputs;  // 1, 2, 3, or 4
uniform float u_scale;      // UV scale factor for coordinate mapping

void main() {
	ivec3 pos = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 size;
	if (u_dimension == 2) {
		size = ivec3(imageSize(u_eval_texture_2d), 1);
		if (pos.x >= size.x || pos.y >= size.y || pos.z >= 1) return;
	} else {
		size = imageSize(u_eval_texture_3d);
		if (pos.x >= size.x || pos.y >= size.y || pos.z >= size.z) return;
	}

	// Calculate normalized coordinates
	vec3 uvw = vec3(pos) / vec3(size - 1);
	vec2 uv = (uvw.xy - 0.5) * 2.0 * u_scale; // map to [-u_scale, u_scale]

	float mlp_inputs[MLP_MAX_NEURONS];
	for (int i = 0; i < MLP_MAX_NEURONS; ++i) {
		mlp_inputs[i] = 0.0;
	}

	if (u_num_inputs >= 2) {
		mlp_inputs[0] = uv.x;
		mlp_inputs[1] = uv.y;
	}
	if (u_num_inputs == 3) {
		if (u_dimension == 3) {
			mlp_inputs[2] = (uvw.z - 0.5) * 2.0 * u_scale; // 3D Spatial
		} else {
			mlp_inputs[2] = u_time * 0.1; // 2D + Time
		}
	} else if (u_num_inputs == 4) {
		mlp_inputs[2] = (uvw.z - 0.5) * 2.0 * u_scale;
		mlp_inputs[3] = u_time * 0.1; // 3D + Time
	}

	float mlp_outputs[MLP_MAX_NEURONS];
	for (int i = 0; i < MLP_MAX_NEURONS; ++i) {
		mlp_outputs[i] = 0.0;
	}

	evaluate_mlp(mlp_inputs, mlp_outputs);

	vec4 color = vec4(0.0, 0.0, 0.0, 1.0);
	for (int i = 0; i < u_num_outputs; ++i) {
		color[i] = mlp_outputs[i];
	}

	// Ensure safe color bounds (some activations like sine/identity can exceed 0-1)
	if (u_mlp_metadata.layers[u_mlp_metadata.num_layers - 1].activation == 4) { // Tanh mapping [-1, 1] to [0, 1]
		color.rgb = color.rgb * 0.5 + 0.5;
	}

	if (u_dimension == 2) {
		imageStore(u_eval_texture_2d, pos.xy, color);
	} else {
		imageStore(u_eval_texture_3d, pos, color);
	}
}
