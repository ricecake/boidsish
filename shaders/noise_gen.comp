#version 460 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(rgba32f, binding = 0) uniform image3D noiseTexture;
layout(rgba32f, binding = 1) uniform image3D curlTexture;
layout(rgba32f, binding = 2) uniform image3D extraNoiseTexture;

#include "helpers/fast_noise.glsl"

// Period for tiling noise
const float NOISE_PERIOD = 8.0;

void main() {
	ivec3 texelCoord = ivec3(gl_GlobalInvocationID.xyz);
	ivec3 size = imageSize(noiseTexture);

	if (any(greaterThanEqual(texelCoord, size))) {
		return;
	}

	vec3 p = vec3(texelCoord) / vec3(size);

	// Scale for interesting frequencies, ensure it matches NOISE_PERIOD for perfect tiling
	vec3 p_scaled = p * NOISE_PERIOD;

	float n_simplex = simplex3d_tiling(p_scaled, NOISE_PERIOD) * 0.5 + 0.5;
	vec2  worley_data = worley3d_tiling(p_scaled, NOISE_PERIOD);
	float n_worley = 1.0 - worley_data.x;
	float n_fbm = fbm3d_tiling(p_scaled, NOISE_PERIOD) * 0.5 + 0.5;

	// Warped FBM
	vec3 warp = vec3(
		fbm3d_tiling(p_scaled + vec3(0.0, 0.0, 0.0), NOISE_PERIOD),
		fbm3d_tiling(p_scaled + vec3(1.2, 3.4, 5.6), NOISE_PERIOD),
		fbm3d_tiling(p_scaled + vec3(5.6, 1.2, 3.4), NOISE_PERIOD)
	);
	float n_warped = fbm3d_tiling(p_scaled + warp * 2.0, NOISE_PERIOD) * 0.5 + 0.5;

	imageStore(noiseTexture, texelCoord, vec4(n_simplex, n_worley, n_fbm, n_warped));

	// Generate Curl Noise
	vec3  curl = computeCurl(p_scaled, NOISE_PERIOD);
	float fbmCurl = length(computeFbmCurl(p_scaled, 3, NOISE_PERIOD));

	// Store Curl RGB and a variant (FBM curl magnitude) in Alpha
	imageStore(curlTexture, texelCoord, vec4(curl, fbmCurl));

	// Extra Noises
	float n_ridge = ridge3d_tiling(p_scaled, NOISE_PERIOD);
	float n_gradient = gradient3d_tiling(p_scaled, NOISE_PERIOD);

	vec2  worley_coords = worley3d_tiling(p_scaled, NOISE_PERIOD);

	imageStore(extraNoiseTexture, texelCoord, vec4(n_ridge, n_gradient, worley_coords));
}
