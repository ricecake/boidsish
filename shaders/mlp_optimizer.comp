#version 430 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#define MLP_MAX_LAYERS 16

struct LayerInfo {
	int input_size;
	int output_size;
	int weight_offset;
	int bias_offset;
	int activation; // 0 = Identity, 1 = ReLU, 2 = LeakyReLU, 3 = Sigmoid, 4 = Tanh, 5 = Sine
};

struct MLPMetadata {
	int num_layers;
	int max_layer_size;
	LayerInfo layers[MLP_MAX_LAYERS];
};

layout(std430, binding = 57) buffer MLPParamsSSBO {
	MLPMetadata u_mlp_metadata;
	float u_mlp_params[];
};

layout(std430, binding = 59) coherent buffer MLPGradsSSBO {
	uint u_mlp_grads[]; // Stored as raw float bits
};

uniform float u_learning_rate;
uniform float u_batch_size; // division factor (total samples)

void main() {
	uint idx = gl_GlobalInvocationID.x;

	// Determine the total number of params
	int num_layers = u_mlp_metadata.num_layers;
	if (num_layers <= 0) return;

	// Total parameter count is the end of the last layer's bias array
	int total_params = u_mlp_metadata.layers[num_layers - 1].bias_offset + u_mlp_metadata.layers[num_layers - 1].output_size;

	if (idx >= uint(total_params)) return;

	// Get and convert accumulated gradient
	float raw_grad = uintBitsToFloat(u_mlp_grads[idx]);
	float grad = raw_grad / u_batch_size;

	// Gradient clipping to prevent exploding/imploding gradients
	grad = clamp(grad, -5.0, 5.0);

	// Apply gradient descent step
	u_mlp_params[idx] -= u_learning_rate * grad;

	// Reset/Clear gradient for the next batch/epoch
	u_mlp_grads[idx] = floatBitsToUint(0.0);
}
