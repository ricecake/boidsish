#version 430 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

#include "helpers/mlp.glsl"

struct Particle {
	vec4 position; // xyz = position, w = active (1.0 = active, 0.0 = inactive)
	vec4 velocity; // xyz = velocity, w = lifetime (normalized 0.0 to 1.0)
	vec4 color;
};

layout(std430, binding = 58) buffer ParticleBuffer {
	Particle u_particles[];
};

uniform float u_dt;
uniform float u_time;
uniform int u_max_particles;
uniform float u_speed_scale;
uniform float u_influence; // How much the MLP guides velocity (0.0 to 1.0)

// Pseudo-random generator
float rand(float seed) {
	return fract(sin(seed * 12.9898) * 43758.5453);
}

vec3 random_sphere_point(float seed) {
	float u = rand(seed);
	float v = rand(seed + 1.23);
	float theta = u * 2.0 * 3.14159265;
	float phi = acos(2.0 * v - 1.0);
	return vec3(
		sin(phi) * cos(theta),
		sin(phi) * sin(theta),
		cos(phi)
	);
}

void main() {
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= u_max_particles) return;

	Particle p = u_particles[idx];

	// Respawn logic if inactive or lifetime ended
	if (p.position.w <= 0.0 || p.velocity.w <= 0.0) {
		float seed = float(idx) + u_time;
		// Spawn in a central ball
		p.position.xyz = random_sphere_point(seed) * 5.0;
		p.position.w = 1.0; // active

		// Random initial velocity
		p.velocity.xyz = random_sphere_point(seed + 2.34) * 2.0;
		p.velocity.w = 0.5 + 0.5 * rand(seed + 5.67); // starting lifetime (e.g., up to 100%)

		// Beautiful color gradient based on index/seed
		p.color = vec4(
			0.5 + 0.5 * sin(float(idx) * 0.01),
			0.5 + 0.5 * sin(float(idx) * 0.01 + 2.09),
			0.5 + 0.5 * sin(float(idx) * 0.01 + 4.18),
			1.0
		);

		u_particles[idx] = p;
		return;
	}

	// Active particle update: query neural vector field!
	float state[MLP_MAX_NEURONS];
	for (int i = 0; i < MLP_MAX_NEURONS; ++i) {
		state[i] = 0.0;
	}

	// Feed 3D position to MLP
	state[0] = p.position.x * 0.1;
	state[1] = p.position.y * 0.1;
	state[2] = p.position.z * 0.1;

	float mlp_out[MLP_MAX_NEURONS];
	for (int i = 0; i < MLP_MAX_NEURONS; ++i) {
		mlp_out[i] = 0.0;
	}

	evaluate_mlp(state, mlp_out);

	// Map MLP output to 3D guiding force/velocity
	vec3 guiding_vel = vec3(mlp_out[0], mlp_out[1], mlp_out[2]) * u_speed_scale;

	// Blend current velocity with MLP guiding velocity
	p.velocity.xyz = mix(p.velocity.xyz, guiding_vel, u_influence);

	// Integrate position
	p.position.xyz += p.velocity.xyz * u_dt;

	// Decrease lifetime
	p.velocity.w -= u_dt * 0.1; // decay lifetime over ~10 seconds

	u_particles[idx] = p;
}
