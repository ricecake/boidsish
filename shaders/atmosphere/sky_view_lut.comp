#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba32f, binding = 0) uniform image2D outSkyView;

// u_transmittanceLUT is declared in common.glsl
uniform sampler2D u_multiScatteringLUT;

uniform vec3 u_sunDir;
uniform vec3 u_sunRadiance;
uniform vec3 u_moonDir;
uniform vec3 u_moonRadiance;
uniform vec3 u_cameraPos;

uniform float u_multiScatScale;
uniform float u_time;
uniform float u_worldScale;
uniform float u_cloudShadowIntensity;

uniform float u_colorVarianceScale;
uniform float u_colorVarianceStrength;

#define ATMOSPHERE_PRECOMPUTE
#include "../helpers/fast_noise.glsl"
#include "common.glsl"
#include "../helpers/lighting.glsl"
#include "../helpers/astral.glsl"

vec3 getTransmittance(float r, float mu) {
	vec2 uv = transmittanceToUV(r, mu);
	return texture(u_transmittanceLUT, uv).rgb;
}

vec3 getMultiScattering(float r, float mu_s) {
	vec2 uv = vec2(mu_s * 0.5 + 0.5, (r - kEarthRadius) / kAtmosphereHeight);
	return texture(u_multiScatteringLUT, uv).rgb;
}

void main() {
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	vec2  size = vec2(imageSize(outSkyView));
	if (any(greaterThanEqual(texel, ivec2(size))))
		return;

	vec2 uv = (vec2(texel) + 0.5) / size;

	// Mapping from UV to direction
	float azimuth = uv.x * 2.0 * PI;
	float adjV = (uv.y < 0.5) ? (1.0 - 2.0 * uv.y) : (2.0 * uv.y - 1.0);
	adjV = adjV * adjV;
	float elevation = (uv.y < 0.5) ? (-adjV * PI * 0.5) : (adjV * PI * 0.5);

	vec3 rd = vec3(cos(elevation) * sin(azimuth), sin(elevation), -cos(elevation) * cos(azimuth));

	float camAltKM = u_cameraPos.y / 1000.0;
	float r = kEarthRadius + camAltKM;
	vec3  ro = vec3(0, r, 0);

	float t0, t1;
	if (!intersectSphere(ro, rd, kTopRadius, t0, t1)) {
		imageStore(outSkyView, texel, vec4(0.0));
		return;
	}

	float t_max = t1;
	float p0, p1;
	bool  intersectsPlanet = intersectSphere(ro, rd, kEarthRadius, p0, p1);
	if (intersectsPlanet && p0 > 0.0)
		t_max = p0;

	const int kSteps = 32;
	vec3      L = vec3(0.0);
	vec3      T = vec3(1.0);
	float     dt = t_max / float(kSteps);

	for (int i = 0; i < kSteps; ++i) {
		float    t = (float(i) + 0.5) * dt;
		vec3     p = ro + rd * t;
		float    h = length(p) - kEarthRadius;
		Sampling s = getAtmosphereProperties(h);

		// Apply gentle color variance to scattering patterns
		if (u_colorVarianceStrength > 0.0) {
			vec3  noisePos = p * u_colorVarianceScale * 0.01 + vec3(0, u_time * 0.05, 0);
			float variance = fastSimplex3d(noisePos);
			float variance2 = fastSimplex3d(noisePos * 2.13 + vec3(1.5));

			// Shift Rayleigh and Mie slightly
			s.rayleigh *= (1.0 + variance * u_colorVarianceStrength);
			s.mie *= (1.0 + variance2 * u_colorVarianceStrength);
		}

		float cosSun = dot(normalize(p), u_sunDir);
		vec3  Ts = getTransmittance(length(p), cosSun);

		float cosThetaSun = dot(rd, u_sunDir);
		vec3  phaseSun = s.rayleigh * rayleighPhase(cosThetaSun) + s.mie * miePhase(cosThetaSun);
		vec3  multiScatSun = getMultiScattering(length(p), cosSun) * u_multiScatScale;

		vec3 worldPos = u_cameraPos + (p - ro) * 1000.0;
		float cloudShadowSun = calculateCloudShadowFactor(worldPos, u_sunDir, u_cloudShadowIntensity);

		vec3 inScattered = (phaseSun * u_sunRadiance * Ts * cloudShadowSun + multiScatSun * u_sunRadiance * (s.rayleigh + s.mie)) * dt;

		// Moon directional scattering contribution
		if (length(u_moonRadiance) > 0.00001) {
			float cosMoon = dot(normalize(p), u_moonDir);
			vec3  Tm = getTransmittance(length(p), cosMoon);
			float cosThetaMoon = dot(rd, u_moonDir);
			vec3  phaseMoon = s.rayleigh * rayleighPhase(cosThetaMoon) + s.mie * miePhase(cosThetaMoon);
			vec3  multiScatMoon = getMultiScattering(length(p), cosMoon) * u_multiScatScale;
			float cloudShadowMoon = calculateCloudShadowFactor(worldPos, u_moonDir, u_cloudShadowIntensity);

			inScattered += (phaseMoon * u_moonRadiance * Tm * cloudShadowMoon + multiScatMoon * u_moonRadiance * (s.rayleigh + s.mie)) * dt;
		}

		// Atmospheric airglow emission layer (~90km mesosphere green oxygen emission ~557.7nm)
		// Physically grounded radiance ~3e-4 W/m^2/sr
		if (h >= 80.0 && h <= 100.0) {
			float airglowDensity = exp(-pow((h - 90.0) / 5.0, 2.0));
			vec3 airglowColor = vec3(0.0001, 0.0003, 0.00015);
			inScattered += airglowColor * airglowDensity/t_max * dt;
		}

		L += T * inScattered;
		T *= exp(-s.extinction * dt);
	}

	// // Add nebula effect to the sky radiance
	// // It is attenuated by the final transmittance from the atmosphere traversal
	// float skyBrightness = max(max(L.r, L.g), L.b);
	// float starVisibility = smoothstep(0.5, 0.05, skyBrightness);
	// if (starVisibility > 0.0) {
	// 	vec3 nebula = computeNebula(rd, u_time);
	// 	L += nebula * T * starVisibility;
	// }

	imageStore(outSkyView, texel, vec4(L, 1.0));
}
